#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

# RATEGURU_COMMON_FILE is only honored alongside RATEGURU_ALLOW_TEST_OVERRIDES
# =true — see the identical comment in infrastructure/scripts/backup.
# Production never sets either variable, so this resolves to the exact same
# installed path as before.
COMMON_FILE=/home/www/rateguru/bin/common

if [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]] \
    && [[ -n "${RATEGURU_COMMON_FILE:-}" ]]
then
    COMMON_FILE="${RATEGURU_COMMON_FILE}"
fi

# shellcheck disable=SC1090
source "${COMMON_FILE}"

# Gated test overrides, following the exact
# FOO_BIN_DEFAULT/FOO_BIN + rateguru_test_overrides_allowed shape backup/
# restore-test already establish. Production values are unchanged — rclone
# was previously invoked as a bare `rclone` (PATH-resolved); it now defaults
# to the same absolute path convention every other gated binary uses.
RCLONE_CONFIG_DEFAULT="/root/.config/rclone/rclone.conf"
RCLONE_REMOTE_DEFAULT="rateguru-b2"
BUCKET_DEFAULT="rateguru-database-backups"
BACKUP_BASE_DEFAULT="/home/www/rateguru/backups"
RUN_ROOT_DEFAULT="/home/www/rateguru/run"
RCLONE_BIN_DEFAULT="/usr/bin/rclone"

RCLONE_CONFIG="${RCLONE_CONFIG_DEFAULT}"
RCLONE_REMOTE="${RCLONE_REMOTE_DEFAULT}"
BUCKET="${BUCKET_DEFAULT}"
BACKUP_BASE="${BACKUP_BASE_DEFAULT}"
RUN_ROOT="${RUN_ROOT_DEFAULT}"
RCLONE_BIN="${RCLONE_BIN_DEFAULT}"

if rateguru_test_overrides_allowed; then
    if [[ -n "${RATEGURU_RCLONE_CONFIG:-}" ]]; then
        RCLONE_CONFIG="${RATEGURU_RCLONE_CONFIG}"
    fi

    if [[ -n "${RATEGURU_RCLONE_REMOTE:-}" ]]; then
        RCLONE_REMOTE="${RATEGURU_RCLONE_REMOTE}"
    fi

    if [[ -n "${RATEGURU_RCLONE_BUCKET:-}" ]]; then
        BUCKET="${RATEGURU_RCLONE_BUCKET}"
    fi

    if [[ -n "${RATEGURU_BACKUP_BASE:-}" ]]; then
        BACKUP_BASE="${RATEGURU_BACKUP_BASE}"
    fi

    if [[ -n "${RATEGURU_RUN_ROOT:-}" ]]; then
        RUN_ROOT="${RATEGURU_RUN_ROOT}"
    fi

    if [[ -n "${RATEGURU_RCLONE_BIN:-}" ]]; then
        RCLONE_BIN="${RATEGURU_RCLONE_BIN}"
    fi
fi

usage() {
    cat <<'USAGE'
Usage:
  offsite-backup --target TARGET_ID
USAGE
}

# Everything below, down to (not including) the source guard at the bottom of
# this file, is constants and function definitions only — nothing runs until
# main is called, mirroring backup/restore-test's own structure exactly.

# --- target parsing (mirrors backup/restore-test) ----------------------------
#
# require_flag_value is defined in common (shared with offsite-retention and
# offsite-restore-test — see the comment there).

parse_offsite_backup_args() {
    TARGET_ID=""
    TARGET_SEEN=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ "${TARGET_SEEN}" != true ]] || fail "--target given more than once"
                require_flag_value "--target" "$#" "${2-}"
                TARGET_ID="$2"
                TARGET_SEEN=true
                shift 2
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                fail "unknown argument: $1"
                ;;
        esac
    done

    [[ "${TARGET_SEEN}" == true ]] || fail "--target is required"
}

# --- target resolution (mirrors backup/restore-test) -------------------------
#
# require_active_target runs first thing — before the rclone config check,
# remote listing, local backup root, lock, or any filesystem/database work is
# ever computed or touched.
resolve_offsite_backup_subject() {
    require_active_target "${TARGET_ID}"

    ENVIRONMENT_CLASS="$(target_environment_class "${TARGET_ID}")"
    BACKUP_NAMESPACE="$(target_backup_namespace "${TARGET_ID}")"
    LABEL="${TARGET_ID}"
}

# --- manifest validation ------------------------------------------------
#
# validate_backup_manifest is defined in common (shared with
# offsite-restore-test — see the comment there). It runs before any rclone
# command — checksum validation only proves the local backup's own files are
# internally consistent; this proves the backup being uploaded actually
# belongs to the resolved selector before it is ever sent to Backblaze B2.
# offsite-backup has no independently resolved database name to compare
# against (unlike restore-test, which does) — `database` is only required to
# be present and non-empty.

# --- offsite backup pipeline -----------------------------------------------

perform_offsite_backup() {
    # Keyed on BACKUP_NAMESPACE, never on LABEL — two targets sharing a
    # backup namespace must resolve to the identical local root, remote root
    # and lock file, exactly like backup/restore-test.
    LOCAL_ROOT="${BACKUP_BASE}/${BACKUP_NAMESPACE}"
    REMOTE_ROOT="${RCLONE_REMOTE}:${BUCKET}/rateguru/${BACKUP_NAMESPACE}"
    LOCK_FILE="${RUN_ROOT}/offsite-backup-${BACKUP_NAMESPACE}.lock"
    HISTORY_FILE="${BACKUP_BASE}/offsite-history.jsonl"

    [[ -f "${RCLONE_CONFIG}" ]] || fail "rclone configuration not found: ${RCLONE_CONFIG}"

    install -d \
        -o root \
        -g root \
        -m 0700 \
        "${RUN_ROOT}" \
        "${BACKUP_BASE}"

    exec 9>"${LOCK_FILE}"

    if ! flock -n 9; then
        fail "${BACKUP_NAMESPACE} offsite backup is already running"
    fi

    # Guarded on -d first so a missing/invalid LOCAL_ROOT (e.g. offsite-backup
    # run before any local backup for this namespace ever existed) cannot make
    # `find` itself fail and abort the pipeline under pipefail — the
    # "no timestamped local backup found" fail call below stays the single
    # place that reports this condition, for a missing directory exactly like
    # an empty one.
    LATEST_BACKUP=""

    if [[ -d "${LOCAL_ROOT}" ]]; then
        LATEST_BACKUP="$(
            find "${LOCAL_ROOT}" \
                -regextype posix-extended \
                -mindepth 1 \
                -maxdepth 1 \
                -type d \
                -regex '.*/[0-9]{8}-[0-9]{6}' \
                -printf '%f\n' \
            | sort \
            | tail -1
        )"
    fi

    [[ -n "${LATEST_BACKUP}" ]] || fail "no timestamped local backup found in ${LOCAL_ROOT}"

    LOCAL_DIRECTORY="${LOCAL_ROOT}/${LATEST_BACKUP}"
    REMOTE_DIRECTORY="${REMOTE_ROOT}/${LATEST_BACKUP}"

    REQUIRED_FILES=(
        database.dump
        storage-app.tar.gz
        environment.env
        release.json
        server-configuration.tar.gz
        manifest.json
        SHA256SUMS
    )

    local required_file
    for required_file in "${REQUIRED_FILES[@]}"; do
        [[ -f "${LOCAL_DIRECTORY}/${required_file}" ]] \
            || fail "missing required backup file: ${required_file}"
    done

    log "${LABEL} offsite backup"
    log "Local backup:  ${LOCAL_DIRECTORY}"
    log "Remote backup: ${REMOTE_DIRECTORY}"

    log "Checking local SHA-256 checksums"

    (
        cd "${LOCAL_DIRECTORY}"
        sha256sum --check SHA256SUMS
    )

    validate_backup_manifest "${LOCAL_DIRECTORY}/manifest.json"

    log "Checking Backblaze B2 access"

    "${RCLONE_BIN}" \
        --config "${RCLONE_CONFIG}" \
        lsf \
        "${RCLONE_REMOTE}:${BUCKET}" \
        >/dev/null

    log "Uploading immutable backup"

    "${RCLONE_BIN}" \
        --config "${RCLONE_CONFIG}" \
        copy \
        "${LOCAL_DIRECTORY}" \
        "${REMOTE_DIRECTORY}" \
        --immutable \
        --check-first \
        --checksum \
        --stats-one-line \
        --stats 10s

    log "Comparing local and remote backup"

    "${RCLONE_BIN}" \
        --config "${RCLONE_CONFIG}" \
        check \
        "${LOCAL_DIRECTORY}" \
        "${REMOTE_DIRECTORY}" \
        --checkers 4

    REMOTE_SIZE_JSON="$(
        "${RCLONE_BIN}" \
            --config "${RCLONE_CONFIG}" \
            size \
            "${REMOTE_DIRECTORY}" \
            --json
    )"

    REMOTE_FILES="$(
        jq -r '.count' <<<"${REMOTE_SIZE_JSON}"
    )"

    REMOTE_BYTES="$(
        jq -r '.bytes' <<<"${REMOTE_SIZE_JSON}"
    )"

    jq \
        --null-input \
        --compact-output \
        --arg status "ok" \
        --arg uploaded_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg selector "target" \
        --arg target "${TARGET_ID}" \
        --arg environment "${ENVIRONMENT_CLASS}" \
        --arg backup_namespace "${BACKUP_NAMESPACE}" \
        --arg backup "${LATEST_BACKUP}" \
        --arg remote "${REMOTE_DIRECTORY}" \
        --argjson files "${REMOTE_FILES}" \
        --argjson bytes "${REMOTE_BYTES}" \
        '{
            status: $status,
            uploaded_at: $uploaded_at,
            selector: $selector,
            target: $target,
            environment: $environment,
            backup_namespace: $backup_namespace,
            backup: $backup,
            remote: $remote,
            files: $files,
            bytes: $bytes
        }' \
        | tee -a "${HISTORY_FILE}"

    chmod 0600 "${HISTORY_FILE}"

    log ""
    log "${LABEL} offsite backup completed successfully."
}

# --- dispatch -----------------------------------------------------------
#
# require_root stays the first substantive action of a real invocation,
# matching backup/restore-test's contract exactly.
main() {
    require_root
    parse_offsite_backup_args "$@"
    resolve_offsite_backup_subject
    perform_offsite_backup
}

# A real invocation always has BASH_SOURCE[0] == $0, so main runs immediately
# here. Tests source this file instead — BASH_SOURCE[0] != $0 in that case, so
# main never auto-runs — then call
# parse_offsite_backup_args/resolve_offsite_backup_subject/perform_offsite_backup
# directly (bypassing require_root) or invoke the script as a genuine
# subprocess (which does run main(), requiring root first, exactly as
# production).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
