#!/usr/bin/env bash
#
# restore-target — restore ONE live target's DATA from ONE exact backup.
#
#   restore-target --apply   --target T --source local|offsite --backup YYYYMMDD-HHMMSS
#   restore-target --inspect --target T --operation OPERATION_ID
#   restore-target --resume  --target T --operation OPERATION_ID
#
# Scenario: the server is alive, the infrastructure is intact, the target
# exists and is active — only its data is wrong. This is NOT Recover Host
# (a replacement VPS), and it is NOT the read-only restore-test (which
# restores into a throwaway scratch database and always did).
#
# The shape of this operation is "do every fallible thing that CAN be done
# while the target is still serving traffic, before taking it down". What is
# outside the downtime window: the download, the full backup verification, the
# pg_restore into a temporary database, and the storage extraction — the four
# things that scale with data size and are most likely to fail.
#
# What is INSIDE it: a full emergency backup of the current state and its
# restore test. Those also scale with data size, so the downtime is minutes,
# not seconds, on a target of any real size. That is the deliberate price of
# an emergency backup that is consistent with the data being replaced — it has
# to be taken after the writers stop, or it captures a moving target.
#
#   validate target
#     -> stage the EXACT named backup (local disk or B2)
#     -> verify it completely (checksums, manifest, archive safety, identity)
#     -> restore it into a NEW temporary database and verify that
#     -> extract it into a NEW sibling storage tree and verify that
#     -- nothing live has been touched up to this point --
#     -> take the deployment lock
#     -> quiesce ONLY this target (maintenance, its queue program, its cron)
#     -> take a full emergency backup of the CURRENT state and verify it
#     -> swap the database in (two catalog renames)
#     -> swap the storage tree in (two directory renames)
#     -> verify the result
#     -> commit, or compensate the whole thing back
#     -> resume the target if its code matches the backup, otherwise hold it
#
# What it restores: database.dump and storage-app.tar.gz. Nothing else. A live
# restore never rewrites shared/.env, rclone.conf, TLS material,
# authorized_keys, Nginx, PHP-FPM, Supervisor, the installed infrastructure,
# or the current/previous release links — environment.env and
# server-configuration.tar.gz are verified as part of backup completeness and
# then deliberately never applied.
#
# It NEVER runs a migration. Backup data must meet the code it was taken
# under, identified by release.json.source_sha; making data meet different
# code is a deliberate future deployment, never a side effect of a restore.
#
# Cross-project safety: only this target's own resources are touched. No
# global nginx, PostgreSQL, Redis, Supervisor or cron service is ever stopped,
# no unrelated database, role, Supervisor group, cron file, vhost or /home/www
# tree is ever read or written.

set -Eeuo pipefail
umask 077

# RATEGURU_COMMON_FILE is only honored alongside RATEGURU_ALLOW_TEST_OVERRIDES
# =true — see the identical comment in infrastructure/scripts/backup.
COMMON_FILE=/home/www/rateguru/bin/common
RESTORE_COMMON_FILE=/home/www/rateguru/bin/restore-common

if [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]]; then
    if [[ -n "${RATEGURU_COMMON_FILE:-}" ]]; then
        COMMON_FILE="${RATEGURU_COMMON_FILE}"
    fi

    if [[ -n "${RATEGURU_RESTORE_COMMON_FILE:-}" ]]; then
        RESTORE_COMMON_FILE="${RATEGURU_RESTORE_COMMON_FILE}"
    fi
fi

# shellcheck disable=SC1090
source "${COMMON_FILE}"
# shellcheck disable=SC1090
source "${RESTORE_COMMON_FILE}"

usage() {
    cat <<'USAGE'
Usage:
  restore-target --apply --target TARGET_ID --source local|offsite \
                 --backup YYYYMMDD-HHMMSS

  restore-target --inspect --target TARGET_ID --operation OPERATION_ID

  restore-target --resume --target TARGET_ID --operation OPERATION_ID

  --apply      Restore this target's database and storage from the named
               backup. The backup timestamp is mandatory: there is no
               "latest" and no implicit selection.
  --source     local   the target's own local backup namespace
               offsite the fixed B2 remote/bucket for that namespace
  --inspect    Read-only. Report a held operation's identity, the commit it
               requires and the commit the target currently serves, without
               changing a single thing. This is how a controlled code
               alignment that was interrupted — a failed historical build, a
               lost workflow run, an operator coming back the next day — is
               picked up again.
  --resume     Resume a target that completed its data restore but was held
               because its code did not match the backup. Only valid once the
               target's current release carries the backup's own source_sha.

Every terminal outcome also prints exactly one machine-readable line:

  RATEGURU_RESTORE_RESULT={"status":"...","operation_id":"...", ...}
USAGE
}

# Everything below, down to (not including) the source guard at the bottom of
# this file, is constants and function definitions only — nothing runs until
# main is called, mirroring deploy/rollback/backup's structure exactly.

# --- argument parsing -------------------------------------------------------------

parse_restore_target_args() {
    MODE=""
    MODE_SEEN=false
    TARGET_ID=""
    TARGET_SEEN=false
    SOURCE_KIND=""
    SOURCE_SEEN=false
    BACKUP_ID=""
    BACKUP_SEEN=false
    OPERATION_ID=""
    OPERATION_SEEN=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --apply|--inspect|--resume)
                [[ "${MODE_SEEN}" != true ]] || fail "only one of --apply, --inspect or --resume may be given"
                MODE="${1#--}"
                MODE_SEEN=true
                shift
                ;;
            --target)
                [[ "${TARGET_SEEN}" != true ]] || fail "--target given more than once"
                require_flag_value "--target" "$#" "${2-}"
                TARGET_ID="$2"
                TARGET_SEEN=true
                shift 2
                ;;
            --source)
                [[ "${SOURCE_SEEN}" != true ]] || fail "--source given more than once"
                require_flag_value "--source" "$#" "${2-}"
                SOURCE_KIND="$2"
                SOURCE_SEEN=true
                shift 2
                ;;
            --backup)
                [[ "${BACKUP_SEEN}" != true ]] || fail "--backup given more than once"
                require_flag_value "--backup" "$#" "${2-}"
                BACKUP_ID="$2"
                BACKUP_SEEN=true
                shift 2
                ;;
            --operation)
                [[ "${OPERATION_SEEN}" != true ]] || fail "--operation given more than once"
                require_flag_value "--operation" "$#" "${2-}"
                OPERATION_ID="$2"
                OPERATION_SEEN=true
                shift 2
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                fail "unknown argument: $1"
                ;;
        esac
    done

    [[ "${MODE_SEEN}" == true ]] || fail "exactly one of --apply, --inspect or --resume is required"
    [[ "${TARGET_SEEN}" == true ]] || fail "--target is required"

    if [[ "${MODE}" == "apply" ]]; then
        [[ "${OPERATION_SEEN}" != true ]] \
            || fail "--operation is only valid with --inspect or --resume; --apply generates its own operation ID"
        [[ "${SOURCE_SEEN}" == true ]] || fail "--source is required (local or offsite)"
        [[ "${BACKUP_SEEN}" == true ]] \
            || fail "--backup is required — a destructive restore never selects a backup implicitly, and there is no 'latest'"

        case "${SOURCE_KIND}" in
            local|offsite) ;;
            *) fail "--source must be local or offsite, got: ${SOURCE_KIND}" ;;
        esac
    else
        # --inspect and --resume both address an operation that already
        # exists. Its backup and its source are recorded in that operation's
        # own state; accepting them again would let a caller describe an
        # operation as something other than what it is.
        [[ "${SOURCE_SEEN}" != true ]] || fail "--source is only valid with --apply"
        [[ "${BACKUP_SEEN}" != true ]] || fail "--backup is only valid with --apply"
        [[ "${OPERATION_SEEN}" == true ]] || fail "--${MODE} requires --operation"
    fi
}

# --- target resolution -------------------------------------------------------------
#
# require_active_target runs first thing — before the workspace, the backup
# root, the remote path, the lock files, the .env, PostgreSQL, Supervisor or
# cron are ever computed or touched. main() already called require_root, so
# the full ordering is: root authorization -> lifecycle=planned rejection ->
# (only if active) any work at all. A planned target (tits-guru today) never
# reaches a single one of those.
resolve_restore_target_subject() {
    require_active_target "${TARGET_ID}"

    TARGET_ROOT="$(target_root "${TARGET_ID}")"
    RUNTIME_USER="$(target_runtime_user "${TARGET_ID}")"
    DATABASE_NAME="$(target_database_name "${TARGET_ID}")"
    DATABASE_ROLE="$(target_database_role "${TARGET_ID}")"
    BACKUP_NAMESPACE="$(target_backup_namespace "${TARGET_ID}")"
    ENVIRONMENT_CLASS="$(target_environment_class "${TARGET_ID}")"
    SUPERVISOR_PROGRAM="$(target_supervisor_program "${TARGET_ID}")"
    SCHEDULER_NAME="$(target_scheduler_name "${TARGET_ID}")"
    LABEL="${TARGET_ID}"

    # Defence in depth. The registry is root-owned and already validated, but
    # these four values end up inside SQL text, a Supervisor argument and an
    # /etc/cron.d path, and the registry validator only requires them to be
    # non-empty strings. A closed class here means a malformed registry can
    # never become a path escape or an injected identifier.
    restore_validate_identifier "${DATABASE_NAME}" "registry database name for ${TARGET_ID}"
    restore_validate_identifier "${DATABASE_ROLE}" "registry application role for ${TARGET_ID}"

    [[ "${SUPERVISOR_PROGRAM}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] \
        || fail "registry Supervisor program for ${TARGET_ID} is not a plain program name: ${SUPERVISOR_PROGRAM}"
    [[ "${SCHEDULER_NAME}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] \
        || fail "registry scheduler name for ${TARGET_ID} is not a plain cron.d entry name: ${SCHEDULER_NAME}"

    CURRENT_LINK="${TARGET_ROOT}/current"
    PREVIOUS_LINK="${TARGET_ROOT}/previous"
    RELEASES_ROOT="${TARGET_ROOT}/releases"
    SHARED_ENV="${TARGET_ROOT}/shared/.env"
    MAINTENANCE_FLAG="${TARGET_ROOT}/shared/storage/framework/down"
    SCHEDULER_FILE="${RESTORE_CRON_D_ROOT}/${SCHEDULER_NAME}"
}

# --- operation-wide state ------------------------------------------------------------

MAIN_BASHPID=""
RESTORE_TERMINAL=false
CURRENT_STEP="start"
MUTATION_STAGE=none          # none | quiesced | activating | activated | committed

# Set by hold_runtime whenever a writer could not be PROVEN stopped. "Held"
# claims nothing writes to the target; when that claim cannot be observed the
# operator has to be told, rather than reading a clean-looking held status.
HOLD_UNCONFIRMED=false
COMPENSATION_STATUS="not-required"
OPERATION_STARTED_AT=""
WORKSPACE=""
STATE_FILE=""
EMERGENCY_BACKUP=""
BACKUP_RELEASE=""
BACKUP_SOURCE_SHA=""
CURRENT_RELEASE_BEFORE=""
CURRENT_SOURCE_SHA_BEFORE=""
CODE_ALIGNMENT="unknown"
RUNTIME_RESUMED="no"
MAINTENANCE_BEFORE="unknown"
QUEUE_RUNNING_BEFORE="unknown"
QUEUE_FULLY_STOPPED_BEFORE="unknown"
SCHEDULER_PRESENT_BEFORE="unknown"
MAINTENANCE_ENTERED_BY_RESTORE=false
QUEUE_STOPPED_BY_RESTORE=false
SCHEDULER_HELD_BY_RESTORE=false
ENV_FINGERPRINT_BEFORE=""
CURRENT_TARGET_BEFORE=""
PREVIOUS_TARGET_BEFORE=""

step() {
    CURRENT_STEP="$1"
    log "step: $1"
}

# --- locks -------------------------------------------------------------------------
#
# Three locks, all keyed the way the existing operational scripts already key
# theirs, and none of them host-global:
#
#   restore-target-<namespace>  this operation, so two restores against the
#                               same backup namespace serialize even when they
#                               name two different targets
#   <target>/locks/deployment   the EXISTING per-target deployment lock, so a
#                               restore can never race deploy, rollback or
#                               cleanup. Not a new, incompatible lock.
#   backup-<namespace>          the EXISTING backup lock, taken only AFTER the
#                               emergency backup has released it, and held
#                               across activation so no new local backup can
#                               capture a half-restored mixture.
#
# The ordering is what avoids a deadlock: restore-target must let `backup`
# acquire and release the backup lock before taking it itself.

acquire_restore_operation_lock() {
    install -d -o root -g root -m 0700 "${RUN_ROOT}"

    exec 201>"${RUN_ROOT}/restore-target-${BACKUP_NAMESPACE}.lock"

    flock -n 201 \
        || fail "another restore operation is already running for backup namespace ${BACKUP_NAMESPACE}"
}

acquire_backup_namespace_lock() {
    exec 202>"${RUN_ROOT}/backup-${BACKUP_NAMESPACE}.lock"

    flock -n 202 \
        || fail "a backup is running for namespace ${BACKUP_NAMESPACE} — refusing to mutate live data while it could capture a half-restored state"
}

# --- runtime observation -------------------------------------------------------------

maintenance_active() {
    [[ -f "${MAINTENANCE_FLAG}" ]]
}

# --- Supervisor status observation ------------------------------------------------
#
# `supervisorctl status <group>:*` reports a NON-RUNNING group through its EXIT
# CODE as well as its output, and conflating that with a failed observation is
# what broke the first real staging restore: the queue was stopped exactly as
# asked, supervisorctl printed it as STOPPED, and the confirmation loop threw
# the answer away because the command exited 3.
#
# The contract below is taken from the pinned supervisor 4.2.1 the host runs
# (supervisor/supervisorctl.py, DefaultControllerPlugin.do_status):
#
#   0  every matched process is in a running-ish state
#   3  LSBStatusExitStatuses.NOT_RUNNING — at least one matched process is in
#      states.STOPPED_STATES (STOPPED, EXITED, FATAL, UNKNOWN)
#   4  LSBStatusExitStatuses.UNKNOWN — do_status sets this both when upcheck()
#      cannot reach supervisord and when a name matched nothing, printing
#      "<group>: ERROR (no such group)"
#
# So 0 and 3 are the only codes that mean "supervisord answered, about the group
# we asked for". Every other code is an observation failure and fails closed —
# including 4, which is exactly the "cannot see it" case that must never be read
# as "it is not running".
#
# The exit code alone is not enough, though, so the output is parsed too: every
# non-empty line must name a process inside THIS group and carry one of
# supervisor's own process states. That is what rejects "ERROR (no such group)",
# a truncated response, or a line about somebody else's program even when the
# exit code looks acceptable.
RESTORE_SUPERVISOR_RC_RUNNING=0
RESTORE_SUPERVISOR_RC_NOT_RUNNING=3

# supervisor/states.py ProcessStates, in full — the only tokens a status line
# may carry.
RESTORE_SUPERVISOR_STATE_PATTERN='^(STOPPED|STARTING|RUNNING|BACKOFF|STOPPING|EXITED|FATAL|UNKNOWN)$'

# Set by observe_queue_program: one state token per process in the group.
QUEUE_PROCESS_STATES=()
QUEUE_OBSERVATION_ERROR=""

# observe_queue_program — fills QUEUE_PROCESS_STATES from a VALID observation,
# or returns non-zero with the reason in QUEUE_OBSERVATION_ERROR.
#
# Runs in the caller's own shell, never a command substitution: a subshell would
# discard the array it exists to populate.
observe_queue_program() {
    local stdout stderr status=0 stderr_file

    QUEUE_PROCESS_STATES=()
    QUEUE_OBSERVATION_ERROR=""

    # stderr is captured rather than discarded so a genuine Supervisor failure
    # can be reported as itself instead of as an anonymous "cannot observe".
    stderr_file="$(mktemp)" || {
        QUEUE_OBSERVATION_ERROR="could not create a temporary file to capture supervisorctl stderr"

        return 1
    }

    stdout="$("${RESTORE_SUPERVISORCTL_BIN}" status "${SUPERVISOR_PROGRAM}:*" 2>"${stderr_file}")" || status=$?
    stderr="$(<"${stderr_file}")"
    rm -f "${stderr_file}"

    if (( status != RESTORE_SUPERVISOR_RC_RUNNING )) \
        && (( status != RESTORE_SUPERVISOR_RC_NOT_RUNNING ))
    then
        QUEUE_OBSERVATION_ERROR="supervisorctl status exited ${status}$(supervisor_diagnostic "${stdout}" "${stderr}")"

        return 1
    fi

    if [[ -z "${stdout//[[:space:]]/}" ]]; then
        QUEUE_OBSERVATION_ERROR="supervisorctl status printed nothing for ${SUPERVISOR_PROGRAM}:*$(supervisor_diagnostic "${stdout}" "${stderr}")"

        return 1
    fi

    local line namespec state
    while IFS= read -r line; do
        [[ -n "${line//[[:space:]]/}" ]] || continue

        read -r namespec state _ <<<"${line}"

        # make_namespec prints "group:process", or the bare name when the two
        # are equal (a single-process program declared without numprocs).
        if [[ "${namespec}" != "${SUPERVISOR_PROGRAM}" ]] \
            && [[ "${namespec}" != "${SUPERVISOR_PROGRAM}:"* ]]
        then
            QUEUE_OBSERVATION_ERROR="supervisorctl status reported '${namespec}', which is not part of ${SUPERVISOR_PROGRAM}$(supervisor_diagnostic "${stdout}" "${stderr}")"

            return 1
        fi

        if [[ ! "${state}" =~ ${RESTORE_SUPERVISOR_STATE_PATTERN} ]]; then
            QUEUE_OBSERVATION_ERROR="supervisorctl status reported '${state:-<none>}' for ${namespec}, which is not a Supervisor process state$(supervisor_diagnostic "${stdout}" "${stderr}")"

            return 1
        fi

        QUEUE_PROCESS_STATES+=("${state}")
    done <<<"${stdout}"

    (( ${#QUEUE_PROCESS_STATES[@]} > 0 )) || {
        QUEUE_OBSERVATION_ERROR="supervisorctl status described no process in ${SUPERVISOR_PROGRAM}"

        return 1
    }
}

# supervisor_diagnostic — a short, single-line excerpt of what supervisorctl
# actually said, for the operator. Truncated and flattened rather than dumped:
# this reaches logs, and an unbounded paste of someone else's output is not a
# diagnostic.
supervisor_diagnostic() {
    local combined
    combined="$(printf '%s %s' "${1-}" "${2-}" | tr '\n' ' ' | tr -s '[:space:]' ' ')"
    combined="${combined# }"
    combined="${combined% }"

    [[ -n "${combined}" ]] || return 0

    printf ' (supervisorctl said: %.200s)' "${combined}"
}

# every_queue_process_is — the shared classifier. The rule is unchanged from
# deploy's own: a group counts as being in a state only when EVERY process in it
# reports that state, so a mixed group is never mistaken for a settled one.
every_queue_process_is() {
    local wanted="$1" state

    observe_queue_program || return 1

    for state in "${QUEUE_PROCESS_STATES[@]}"; do
        [[ "${state}" == "${wanted}" ]] || return 1
    done
}

# Identical classification to deploy's own queue_program_running: only a
# program group whose every process reports RUNNING counts as running.
# STARTING, BACKOFF, FATAL, EXITED and STOPPED are all "not running".
queue_program_running() {
    every_queue_process_is RUNNING
}

# The mirror image, and the one the quiesce decision is actually made on:
# every process must report STOPPED. A group where some processes are STOPPED
# and others are RUNNING, STARTING or BACKOFF is NOT stopped — one live worker
# is one live database writer, and "not fully running" must never be mistaken
# for "safe to swap data underneath".
queue_program_fully_stopped() {
    every_queue_process_is STOPPED
}

wait_for_queue_state() {
    local predicate="$1" attempt

    for ((attempt = 1; attempt <= RESTORE_QUEUE_WAIT_ATTEMPTS; attempt++)); do
        if "${predicate}"; then
            return 0
        fi

        sleep "${RESTORE_QUEUE_RETRY_DELAY}"
    done

    "${predicate}"
}

scheduler_file_present() {
    [[ -f "${SCHEDULER_FILE}" ]] && [[ ! -L "${SCHEDULER_FILE}" ]]
}

artisan_as_runtime_user() {
    local release_dir="${CURRENT_LINK}"

    (
        cd "${release_dir}"

        "${RUNUSER_BIN}" -u "${RUNTIME_USER}" -- "${PHP_BIN}" artisan "$@"
    )
}

# --- preconditions --------------------------------------------------------------------
#
# Restore Target Data restores DATA on a live, deployed target. A target with no
# canonical current release cannot be put into maintenance, cannot be health
# checked, and — decisively — offers no release.json to compare the backup's
# source_sha against, so the code-alignment decision this whole operation ends
# in would be undecidable. Reconstructing a target that has no release at all
# is Recover Host (7.6), not this. Fails closed, before anything is created.
assert_deployed_target() {
    [[ -L "${CURRENT_LINK}" ]] \
        || fail "${TARGET_ID} has no current release symlink — a live data restore requires a deployed target (rebuilding one is Recover Host, not restore-target)"

    # The same containment line deploy, rollback and cleanup hold: this
    # target's releases root is a real directory it owns. A symlinked
    # releases root plus a current pointing inside it resolves to a
    # self-consistent pair, so the identity check alone would accept a
    # release tree belonging to something else — and the whole code-alignment
    # decision is made against that identity.
    # restore_read_current_identity refuses it too; this is here so the
    # operator gets the actual diagnosis rather than "carries no usable
    # release/source_sha".
    [[ ! -L "${RELEASES_ROOT}" ]] \
        || fail "${TARGET_ID}'s releases root must be a real directory, not a symlink: ${RELEASES_ROOT}"
    [[ -d "${RELEASES_ROOT}" ]] \
        || fail "${TARGET_ID} has no releases directory: ${RELEASES_ROOT}"

    restore_read_current_identity "${TARGET_ROOT}"

    [[ -n "${RESTORE_CURRENT_RELEASE}" ]] && [[ -n "${RESTORE_CURRENT_SOURCE_SHA}" ]] \
        || fail "${TARGET_ID}'s current release carries no usable release/source_sha in release.json — code alignment could not be decided after the restore"

    [[ -f "${CURRENT_LINK}/artisan" ]] \
        || fail "${TARGET_ID}'s current release contains no artisan — maintenance mode and the scheduler barrier are not available"

    [[ -f "${SHARED_ENV}" ]] && [[ ! -L "${SHARED_ENV}" ]] \
        || fail "${TARGET_ID} has no shared/.env regular file — restore never creates one"

    CURRENT_RELEASE_BEFORE="${RESTORE_CURRENT_RELEASE}"
    CURRENT_SOURCE_SHA_BEFORE="${RESTORE_CURRENT_SOURCE_SHA}"
}

# A cheap, non-secret proof that shared/.env was neither replaced nor
# rewritten: device, inode, size, mtime, owner, group and mode. Deliberately
# NOT a content hash — a hash of secret material is a fingerprint of that
# material, and nothing about .env content belongs anywhere near this
# operation's state or journal.
env_fingerprint() {
    stat -c '%d:%i:%s:%Y:%u:%g:%a' "${SHARED_ENV}"
}

record_immutable_baseline() {
    ENV_FINGERPRINT_BEFORE="$(env_fingerprint)"
    CURRENT_TARGET_BEFORE="$(readlink "${CURRENT_LINK}")"
    PREVIOUS_TARGET_BEFORE="$(readlink "${PREVIOUS_LINK}" 2>/dev/null || printf '')"
}

assert_immutables_unchanged() {
    [[ "$(env_fingerprint)" == "${ENV_FINGERPRINT_BEFORE}" ]] \
        || fail "shared/.env changed during the restore — a live restore must never rewrite the target environment"

    [[ "$(readlink "${CURRENT_LINK}")" == "${CURRENT_TARGET_BEFORE}" ]] \
        || fail "the current release symlink changed during the restore — a restore never switches releases"

    local previous_now
    previous_now="$(readlink "${PREVIOUS_LINK}" 2>/dev/null || printf '')"

    [[ "${previous_now}" == "${PREVIOUS_TARGET_BEFORE}" ]] \
        || fail "the previous release symlink changed during the restore — a restore never switches releases"
}

# --- quiesce ----------------------------------------------------------------------------

capture_runtime_state() {
    if maintenance_active; then
        MAINTENANCE_BEFORE=true
    else
        MAINTENANCE_BEFORE=false
    fi

    # Fail closed on an unobservable program group. Recording it as "not
    # running" would make the quiesce below skip the stop and swap live data
    # underneath workers this restore simply could not see. A group that is
    # merely STOPPED is observable and not this case — see
    # observe_queue_program for the exit codes that distinguish them.
    observe_queue_program \
        || fail "cannot observe the target queue program ${SUPERVISOR_PROGRAM}: ${QUEUE_OBSERVATION_ERROR} — refusing to restore without knowing whether a worker is running"

    QUEUE_RUNNING_BEFORE=false
    queue_program_running && QUEUE_RUNNING_BEFORE=true

    QUEUE_FULLY_STOPPED_BEFORE=false
    queue_program_fully_stopped && QUEUE_FULLY_STOPPED_BEFORE=true

    SCHEDULER_PRESENT_BEFORE=false
    scheduler_file_present && SCHEDULER_PRESENT_BEFORE=true

    restore_state_set "${STATE_FILE}" \
        maintenance_before "${MAINTENANCE_BEFORE}" \
        queue_running_before "${QUEUE_RUNNING_BEFORE}" \
        queue_fully_stopped_before "${QUEUE_FULLY_STOPPED_BEFORE}" \
        scheduler_present_before "${SCHEDULER_PRESENT_BEFORE}"

    log "runtime before restore: maintenance=${MAINTENANCE_BEFORE} queue_running=${QUEUE_RUNNING_BEFORE} queue_fully_stopped=${QUEUE_FULLY_STOPPED_BEFORE} scheduler_present=${SCHEDULER_PRESENT_BEFORE}"
}

quiesce_http() {
    if [[ "${MAINTENANCE_BEFORE}" == true ]]; then
        log "target was already in maintenance before this restore — leaving it exactly as it was"

        return 0
    fi

    artisan_as_runtime_user down \
        || fail "could not put ${TARGET_ID} into maintenance mode"

    MAINTENANCE_ENTERED_BY_RESTORE=true
    restore_state_set "${STATE_FILE}" maintenance_entered_by_restore true

    log "maintenance mode enabled by this restore"
}

# The decision is made on "provably fully stopped", never on "fully running".
# A group in any mixed or failed state — one process RUNNING and another
# FATAL, or a worker in BACKOFF about to be respawned — still contains a live
# database writer, and is stopped here like any other.
quiesce_queue() {
    if [[ "${QUEUE_FULLY_STOPPED_BEFORE}" == true ]]; then
        log "queue program ${SUPERVISOR_PROGRAM} was already fully stopped before this restore — leaving it stopped"

        return 0
    fi

    if [[ "${QUEUE_RUNNING_BEFORE}" != true ]]; then
        log "queue program ${SUPERVISOR_PROGRAM} was neither fully RUNNING nor fully STOPPED before this restore — stopping it for the swap, and leaving it stopped afterwards; start it by hand once the underlying problem is resolved"
    fi

    # Only this target's own program group. Never `supervisorctl stop all`,
    # never a Supervisor daemon restart, never another project's group.
    "${RESTORE_SUPERVISORCTL_BIN}" stop "${SUPERVISOR_PROGRAM}:*" >/dev/null \
        || fail "could not stop the target queue program ${SUPERVISOR_PROGRAM}"

    wait_for_queue_state queue_program_fully_stopped \
        || fail "queue program ${SUPERVISOR_PROGRAM} did not reach STOPPED within the wait budget"

    QUEUE_STOPPED_BY_RESTORE=true
    restore_state_set "${STATE_FILE}" queue_stopped_by_restore true

    log "queue program ${SUPERVISOR_PROGRAM} STOPPED"
}

# hold_scheduler_entry — move THIS target's cron entry out of /etc/cron.d into
# the root-only operation workspace, recording its exact ownership and mode so
# resume can put it back byte-for-byte. Moved, not copied-and-deleted: the
# entry leaves /etc/cron.d in one operation, only this target's own file is
# ever touched, and the global cron daemon is never stopped — every other
# project on this host keeps running.
#
# Shared by the quiesce below and by hold_runtime, which has to re-hold it
# when a resume failed partway.
hold_scheduler_entry() {
    local hold_dir
    hold_dir="$(restore_scheduler_hold_dir "${WORKSPACE}")"
    install -d -o root -g root -m 0700 "${hold_dir}"

    local owner mode
    owner="$(stat -c '%u:%g' "${SCHEDULER_FILE}")"
    mode="$(stat -c '%a' "${SCHEDULER_FILE}")"

    mv "${SCHEDULER_FILE}" "${hold_dir}/${SCHEDULER_NAME}" \
        || fail "could not hold the target scheduler cron entry"

    SCHEDULER_HELD_BY_RESTORE=true
    restore_state_set "${STATE_FILE}" \
        scheduler_held_by_restore true \
        scheduler_hold_path "${hold_dir}/${SCHEDULER_NAME}" \
        scheduler_owner "${owner}" \
        scheduler_mode "${mode}"

    log "scheduler cron entry held outside /etc/cron.d"
}

quiesce_scheduler() {
    if [[ "${SCHEDULER_PRESENT_BEFORE}" != true ]]; then
        log "no ${SCHEDULER_FILE} to hold — leaving the scheduler exactly as it was"

        return 0
    fi

    hold_scheduler_entry

    interrupt_running_schedule
}

# A schedule:run that started in the minute before the cron entry was removed
# is still executing, and it is a database writer. Laravel's own
# schedule:interrupt asks it to stop at the end of its current task; the
# bounded wait below then observes that no scheduler process for THIS target's
# runtime user remains. Fail-open on the interrupt itself (an older release
# without the command must not abort a restore) — the hard write barrier is
# the database connection barrier at activation, not this.
#
# observe_schedule_run_absence RETURNS rather than fails, and that is what lets
# one observation serve both callers. The quiesce below turns a non-zero into a
# fatal refusal to swap data underneath a writer; hold_runtime turns it into a
# loud ERROR, because it runs when something has already gone wrong and its own
# failure must never replace the original diagnosis. The reason is left in
# SCHEDULE_ABSENCE_REASON so both render the same sentence.
SCHEDULE_ABSENCE_REASON=""

observe_schedule_run_absence() {
    SCHEDULE_ABSENCE_REASON=""

    # The connection barrier at activation is NOT a substitute for this. It
    # stops the scheduler writing to PostgreSQL; it does nothing about
    # storage/app, which the storage swap is about to replace underneath any
    # process still writing there. So this must PROVE the scheduler stopped,
    # and every outcome that is not proof is a failure.
    if ! command -v "${RESTORE_PGREP_BIN}" >/dev/null 2>&1; then
        SCHEDULE_ABSENCE_REASON="${RESTORE_PGREP_BIN} is unavailable — cannot prove ${TARGET_ID}'s scheduler has stopped, and the connection barrier only covers PostgreSQL, not storage"

        return 1
    fi

    if artisan_as_runtime_user schedule:interrupt >/dev/null 2>&1; then
        log "schedule:interrupt issued to the running scheduler"
    else
        log "schedule:interrupt is unavailable in the current release — waiting for the running schedule:run to finish on its own"
    fi

    local attempt status
    for ((attempt = 1; attempt <= RESTORE_SCHEDULER_WAIT_ATTEMPTS; attempt++)); do
        status=0
        "${RESTORE_PGREP_BIN}" -u "${RUNTIME_USER}" -f 'artisan schedule:run' >/dev/null 2>&1 || status=$?

        case "${status}" in
            0)
                # At least one scheduler process is still running.
                ;;
            1)
                # pgrep's "no process matched" — the only proof of absence.
                log "no scheduler process remains for ${RUNTIME_USER}"

                return 0
                ;;
            *)
                # 2 is a usage/syntax error, 3 a fatal one. Either way the
                # observation itself is broken, and an unobservable writer is
                # never treated as an absent one.
                SCHEDULE_ABSENCE_REASON="${RESTORE_PGREP_BIN} failed with exit ${status} — cannot observe ${TARGET_ID}'s scheduler processes, so a running writer cannot be ruled out"

                return 1
                ;;
        esac

        sleep "${RESTORE_SCHEDULER_RETRY_DELAY}"
    done

    SCHEDULE_ABSENCE_REASON="a scheduler process for ${RUNTIME_USER} is still running after the interrupt budget"

    return 1
}

interrupt_running_schedule() {
    observe_schedule_run_absence \
        || fail "${SCHEDULE_ABSENCE_REASON} — refusing to swap data underneath a writer"
}

# --- resume / hold ------------------------------------------------------------------------
#
# The exact inverse of the quiesce above, and ONLY that: whatever was not
# changed by this restore is not changed back. A queue that was stopped before
# stays stopped, a target already in maintenance stays down, and a scheduler
# entry that did not exist is never invented.

# Returns non-zero instead of calling fail: this runs both on the success
# path (where the caller turns a failure into a fatal one) and from the
# failure handler (where the caller must be able to hold the target instead).
# `fail` is an `exit`, which would terminate the whole script even from inside
# an `if`, leaving nobody to decide between "recovered" and "held".
resume_runtime() {
    restore_scheduler_entry || return 1
    resume_queue_program || return 1
    leave_maintenance || return 1

    RUNTIME_RESUMED="yes"
}

# restore_scheduler_entry — put back exactly the cron entry this restore moved
# aside, and nothing else.
#
# Driven by what is on disk, not by how far a previous attempt got: the move
# and the ownership/mode restoration are separate operations, so a retry (or a
# resume that failed between them) must be able to finish the half that is
# missing rather than insist on redoing the half that already happened.
restore_scheduler_entry() {
    [[ "${SCHEDULER_HELD_BY_RESTORE}" == true ]] || return 0

    local hold_path owner mode
    hold_path="$(restore_state_get "${STATE_FILE}" scheduler_hold_path)"
    owner="$(restore_state_get "${STATE_FILE}" scheduler_owner)"
    mode="$(restore_state_get "${STATE_FILE}" scheduler_mode)"

    if [[ -f "${hold_path}" ]]; then
        mv "${hold_path}" "${SCHEDULER_FILE}" || {
            log "ERROR: could not restore the target scheduler cron entry"

            return 1
        }
    elif ! scheduler_file_present; then
        log "ERROR: neither the held scheduler cron entry (${hold_path}) nor ${SCHEDULER_FILE} exists"

        return 1
    fi

    chown "${owner}" "${SCHEDULER_FILE}" || {
        log "ERROR: could not restore the scheduler cron entry ownership"

        return 1
    }

    chmod "${mode}" "${SCHEDULER_FILE}" || {
        log "ERROR: could not restore the scheduler cron entry mode"

        return 1
    }

    SCHEDULER_HELD_BY_RESTORE=false
    ( restore_state_set "${STATE_FILE}" scheduler_held_by_restore false ) || true

    log "scheduler cron entry restored"
}

# resume_queue_program — start the group only if it was FULLY RUNNING before,
# and only if it is not already running.
#
# The condition is the OBSERVED state, not QUEUE_STOPPED_BY_RESTORE: a quiesce
# whose `supervisorctl stop` succeeded but whose STOPPED confirmation timed
# out never set that flag, and a queue that was running before this restore
# must still come back afterwards.
resume_queue_program() {
    if [[ "${QUEUE_RUNNING_BEFORE}" != true ]]; then
        # Never fully RUNNING before, so never started here: starting it would
        # invent a runtime state the target never had and hide the failure
        # that produced the one it did.
        if [[ "${QUEUE_STOPPED_BY_RESTORE}" == true ]]; then
            log "queue program ${SUPERVISOR_PROGRAM} was not fully RUNNING before this restore — leaving it stopped; start it by hand once the underlying problem is resolved"
        fi

        return 0
    fi

    if queue_program_running; then
        return 0
    fi

    "${RESTORE_SUPERVISORCTL_BIN}" start "${SUPERVISOR_PROGRAM}:*" >/dev/null || {
        log "ERROR: could not start the target queue program ${SUPERVISOR_PROGRAM}"

        return 1
    }

    wait_for_queue_state queue_program_running || {
        log "ERROR: queue program ${SUPERVISOR_PROGRAM} did not reach RUNNING within the wait budget"

        return 1
    }

    QUEUE_STOPPED_BY_RESTORE=false
    ( restore_state_set "${STATE_FILE}" queue_stopped_by_restore false ) || true

    log "queue program ${SUPERVISOR_PROGRAM} RUNNING"
}

# leave_maintenance — bring the target back up only if THIS restore put it
# down, and confirm it actually came up. `artisan up` reporting success is not
# the same as the target serving again.
leave_maintenance() {
    [[ "${MAINTENANCE_ENTERED_BY_RESTORE}" == true ]] || return 0

    if maintenance_active; then
        artisan_as_runtime_user up || {
            log "ERROR: could not bring ${TARGET_ID} out of maintenance mode"

            return 1
        }
    fi

    if maintenance_active; then
        log "ERROR: ${TARGET_ID} is still in maintenance after artisan up"

        return 1
    fi

    MAINTENANCE_ENTERED_BY_RESTORE=false
    ( restore_state_set "${STATE_FILE}" maintenance_entered_by_restore false ) || true

    log "maintenance mode disabled"
}

# hold_runtime — put the target into a state where nothing writes to it, from
# whatever state it is ACTUALLY in.
#
# This is the same principle the database and storage compensation already
# follow, and it is why none of the three steps below looks at
# QUEUE_STOPPED_BY_RESTORE, SCHEDULER_HELD_BY_RESTORE or
# MAINTENANCE_ENTERED_BY_RESTORE to decide. Those flags only flip once a whole
# step completed, so every partial transition — a `supervisorctl start` that
# took effect before its RUNNING confirmation timed out, a cron entry moved
# back before its chown failed — leaves a flag claiming a writer is stopped
# while the writer is running. `held` would then be a lie, which is exactly
# the guarantee Restore Target Data cannot afford to break.
#
# Every action is guarded and non-fatal: this runs when something has already
# gone wrong, and its own failure must never replace the original diagnosis.
# What it cannot achieve, it says out loud.
hold_runtime() {
    # 1. Any cron entry present for this target is a scheduled writer,
    #    whatever any flag says. Moved aside, never deleted, so a later resume
    #    puts back exactly what was taken.
    if scheduler_file_present; then
        if ( hold_scheduler_entry ) >/dev/null 2>&1; then
            SCHEDULER_HELD_BY_RESTORE=true
            log "scheduler cron entry held out of ${RESTORE_CRON_D_ROOT}"
        else
            HOLD_UNCONFIRMED=true
            log "ERROR: could not hold ${SCHEDULER_FILE} — a scheduled writer may still be running against this target"
        fi
    fi

    # 1b. Removing the cron entry only stops the NEXT schedule:run. One cron
    #     already started is still executing, and it writes to both PostgreSQL
    #     and storage — so the same proof the quiesce demands is demanded here.
    #
    #     This matters most on the resume path, which is the one place a
    #     scheduler can start DURING the operation: --resume puts the cron
    #     entry back and leaves maintenance, cron fires, and only then does the
    #     health check fail and bring us here. Holding the entry again would
    #     stop the next run while the running one carried on writing, and
    #     "held" would be a lie about exactly the writer this operation exists
    #     to keep away from the data.
    if observe_schedule_run_absence; then
        log "no scheduler process is running against this target"
    else
        HOLD_UNCONFIRMED=true
        log "ERROR: ${SCHEDULE_ABSENCE_REASON} — a scheduled writer may still be running against this target"
    fi

    # 2. Anything not PROVABLY fully stopped is a queue writer — including a
    #    group whose state cannot be observed at all.
    if ! queue_program_fully_stopped; then
        if "${RESTORE_SUPERVISORCTL_BIN}" stop "${SUPERVISOR_PROGRAM}:*" >/dev/null 2>&1 \
            && wait_for_queue_state queue_program_fully_stopped
        then
            QUEUE_STOPPED_BY_RESTORE=true
            log "queue program ${SUPERVISOR_PROGRAM} STOPPED"
        else
            HOLD_UNCONFIRMED=true
            log "ERROR: could not confirm ${SUPERVISOR_PROGRAM} is STOPPED — a queue worker may still be running against this target"
        fi
    fi

    # 3. A held target must not be serving, whether or not this restore is the
    #    thing that took it down.
    if ! maintenance_active; then
        if artisan_as_runtime_user down >/dev/null 2>&1 && maintenance_active; then
            MAINTENANCE_ENTERED_BY_RESTORE=true
            log "maintenance mode enabled for the held target"
        else
            HOLD_UNCONFIRMED=true
            log "ERROR: could not put ${TARGET_ID} into maintenance mode — it may still be serving traffic"
        fi
    fi

    RUNTIME_RESUMED="no"
}

# --- restore guard -----------------------------------------------------------------------
#
# The interlock that makes a held target refuse an ordinary backup. It is a
# root-only marker file, and the single most important thing about it is WHEN it
# is written: before the first live mutation, never after.
#
# The hazard it covers is not a Bash failure — the terminal handler already
# covers those. It is termination the handler cannot see. Between the database
# activation and the end of this script the process can be SIGKILLed or
# OOM-killed: no EXIT/ERR trap runs, flock is released by the kernel, and the
# host's own backup cron is then free to run. That cron is not the Laravel
# scheduler and this operation does not hold it:
#
#   30 2 * * * root /home/www/rateguru/bin/backup-cycle --target staging-main
#
# It would snapshot restored (or half-restored) data while current/release.json
# still names the old commit, producing exactly the mislabelled backup this
# whole mechanism exists to prevent. A marker written only on a successful
# completion, or only by the failure handler, is absent in precisely that case.
#
# So the guard goes in first and is removed only by a proven-good outcome:
#
#   in-progress   written before the first activation; the data may be the
#                 backup's, and nothing may snapshot it
#   held          the data restore completed, the code does not match yet
#   failed-held   a failure left data that may have been replaced
#   (removed)     the data provably matches the code again — an aligned
#                 restore that passed its health check, a successful --resume,
#                 or a compensation that put the live data back
#
# Because it is written before anything is touched, its failure is a clean
# refusal rather than a half-restore: see the call site in perform_restore.

RESTORE_GUARD_WRITTEN=false

write_restore_guard() {
    local hold_status="$1" marker marker_dir

    marker="$(restore_guard_file "${TARGET_ID}" "${RUN_ROOT}")"
    marker_dir="$(dirname "${marker}")"

    # Returns rather than fails, so each caller can decide. The pre-mutation
    # call site turns a non-zero into a refusal; the terminal handler turns it
    # into a loud ERROR, because its own failure must never replace the
    # diagnosis it is already reporting.
    if ! install -d -o root -g root -m 0700 "${marker_dir}" 2>/dev/null; then
        log "ERROR: could not create ${marker_dir} — the restore guard is NOT in place, and an ordinary backup would record the wrong source_sha for this data"

        return 1
    fi

    # Content is identity only: which operation, which target, which commit the
    # data is waiting for. No secret, and nothing an operator has to interpret.
    if ! jq -n \
        --arg operation "${OPERATION_ID}" \
        --arg target "${TARGET_ID}" \
        --arg required_source_sha "${BACKUP_SOURCE_SHA}" \
        --arg status "${hold_status}" \
        --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{
            operation: $operation,
            target: $target,
            required_source_sha: $required_source_sha,
            status: $status,
            created_at: $created_at
        }' > "${marker}.tmp" 2>/dev/null
    then
        rm -f "${marker}.tmp" 2>/dev/null || true
        log "ERROR: could not write the restore guard ${marker} — an ordinary backup would record the wrong source_sha for this data"

        return 1
    fi

    chmod 0600 "${marker}.tmp" 2>/dev/null || true

    if ! mv -f "${marker}.tmp" "${marker}" 2>/dev/null; then
        rm -f "${marker}.tmp" 2>/dev/null || true
        log "ERROR: could not install the restore guard ${marker} — an ordinary backup would record the wrong source_sha for this data"

        return 1
    fi

    RESTORE_GUARD_WRITTEN=true

    log "restore guard written: ${marker} (status=${hold_status}; ordinary backups of ${TARGET_ID} refuse while it exists)"
}

# clear_restore_guard — only ever called once the live data provably
# matches the code serving it again. Returns rather than fails, for the same
# reason the writer does.
clear_restore_guard() {
    local marker
    marker="$(restore_guard_file "${TARGET_ID}" "${RUN_ROOT}")"

    [[ -e "${marker}" ]] || return 0

    if ! rm -f "${marker}" 2>/dev/null; then
        log "ERROR: could not remove the restore guard ${marker} — ordinary backups of ${TARGET_ID} will keep refusing until it is gone"

        return 1
    fi

    RESTORE_GUARD_WRITTEN=false

    log "restore guard cleared: ${marker}"
}

# --- emergency pre-restore backup ------------------------------------------------------------

list_backup_ids() {
    local root="${BACKUP_BASE}/${BACKUP_NAMESPACE}"

    [[ -d "${root}" ]] || return 0

    find "${root}" \
        -regextype posix-extended \
        -mindepth 1 \
        -maxdepth 1 \
        -type d \
        -regex '.*/[0-9]{8}-[0-9]{6}' \
        -printf '%f\n' \
        | sort
}

# create_emergency_backup — a full, ordinary RateGuru backup of the CURRENT
# state, taken after the target is quiesced and before the first live
# mutation. Deliberately the existing `backup` implementation, not a second
# backup format: it produces the same dump, the same storage archive, the same
# .env and server-configuration snapshots, the same manifest and the same
# SHA256SUMS an operator already knows how to restore from.
#
# Local only, on purpose: an emergency data restore must stay possible during
# a B2 outage, so offsite availability is never a hard prerequisite for
# repairing a live target. The emergency backup is still a complete,
# checksum-verified backup and is uploaded by the next ordinary backup cycle.
create_emergency_backup() {
    local before_list="${WORKSPACE}/backups-before.txt"
    local after_list="${WORKSPACE}/backups-after.txt"

    list_backup_ids > "${before_list}"

    "${RESTORE_BACKUP_BIN}" --target "${TARGET_ID}" \
        || fail "the emergency pre-restore backup failed — no live data was mutated"

    list_backup_ids > "${after_list}"

    # Exactly one new timestamped directory must have appeared. `backup` also
    # applies local retention in the same run, so entries may legitimately
    # DISAPPEAR — only additions are considered. Zero or more than one
    # addition means the emergency backup cannot be named with certainty, and
    # a restore that cannot name its own safety net does not proceed.
    local -a added=()
    mapfile -t added < <(comm -13 "${before_list}" "${after_list}")

    (( ${#added[@]} == 1 )) \
        || fail "could not unambiguously identify the emergency backup (${#added[@]} new backups appeared) — no live data was mutated"

    EMERGENCY_BACKUP="${added[0]}"
    validate_backup_id "${EMERGENCY_BACKUP}"

    restore_state_set "${STATE_FILE}" emergency_backup "${EMERGENCY_BACKUP}"

    log "emergency pre-restore backup created: ${EMERGENCY_BACKUP}"

    # Taken only now: `backup` above needed the backup-namespace lock itself,
    # so holding it earlier would have deadlocked. From here it stays held
    # through activation, which is what stops a concurrent local backup from
    # capturing a half-restored mixture of old and new data.
    acquire_backup_namespace_lock

    # restore-test verifies the NEWEST local backup. Proving the emergency
    # backup is that newest backup — while holding the lock that stops another
    # one appearing — is what makes reusing the existing, accepted restore-test
    # correct here instead of writing a second verifier.
    local newest
    newest="$(list_backup_ids | tail -1)"

    [[ "${newest}" == "${EMERGENCY_BACKUP}" ]] \
        || fail "the emergency backup ${EMERGENCY_BACKUP} is not the newest local backup (${newest}) — refusing to verify the wrong backup"

    "${RESTORE_RESTORE_TEST_BIN}" --target "${TARGET_ID}" \
        || fail "the emergency pre-restore backup failed its restore test — no live data was mutated"

    log "emergency pre-restore backup verified by restore-test"
}

# --- final data verification -------------------------------------------------------------------

verify_restored_database() {
    restore_resolve_credentials "${TARGET_ROOT}" "${DATABASE_NAME}" "${DATABASE_ROLE}"

    restore_database_exists "${DATABASE_NAME}" \
        || fail "the canonical database is missing after activation: ${DATABASE_NAME}"

    restore_superuser_query "SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname = '${DATABASE_NAME}';"

    [[ "${RESTORE_SQL_RESULT}" == "${DATABASE_ROLE}" ]] \
        || fail "restored database ${DATABASE_NAME} is owned by '${RESTORE_SQL_RESULT}', expected ${DATABASE_ROLE}"

    restore_superuser_query "SELECT datallowconn FROM pg_database WHERE datname = '${DATABASE_NAME}';"

    [[ "${RESTORE_SQL_RESULT}" == "t" ]] \
        || fail "restored database ${DATABASE_NAME} does not allow connections"

    local tables migrations

    tables="$(
        PGPASSWORD="${ENV_DB_PASSWORD}" "${PSQL_BIN}" \
            --no-psqlrc --no-align --tuples-only --set=ON_ERROR_STOP=1 \
            --host="${ENV_DB_HOST}" --port="${ENV_DB_PORT}" \
            --username="${DATABASE_ROLE}" --dbname="${DATABASE_NAME}" \
            --command="SELECT count(*) FROM information_schema.tables WHERE table_schema = 'public';"
    )" || fail "the application role cannot read the restored database"

    tables="${tables//[[:space:]]/}"

    [[ "${tables}" =~ ^[0-9]+$ ]] && (( tables > 0 )) \
        || fail "the restored database contains no public tables"

    migrations="$(
        PGPASSWORD="${ENV_DB_PASSWORD}" "${PSQL_BIN}" \
            --no-psqlrc --no-align --tuples-only --set=ON_ERROR_STOP=1 \
            --host="${ENV_DB_HOST}" --port="${ENV_DB_PORT}" \
            --username="${DATABASE_ROLE}" --dbname="${DATABASE_NAME}" \
            --command="SELECT CASE WHEN to_regclass('public.migrations') IS NULL THEN 0 ELSE (SELECT count(*) FROM migrations) END;"
    )" || fail "could not read the restored migrations table"

    migrations="${migrations//[[:space:]]/}"

    [[ "${migrations}" =~ ^[0-9]+$ ]] \
        || fail "unable to determine the restored migrations table row count"

    log "restored database verified: ${tables} public tables, ${migrations} migration rows, owner ${DATABASE_ROLE}"
}

verify_restored_storage() {
    local storage_root app_root
    storage_root="$(restore_storage_root "${TARGET_ROOT}")"
    app_root="${storage_root}/app"

    [[ -e "${app_root}" ]] || fail "restored storage tree is missing: ${app_root}"
    [[ ! -L "${app_root}" ]] \
        || fail "restored storage tree must be a real directory, not a symlink: ${app_root}"
    [[ -d "${app_root}" ]] || fail "restored storage path is not a directory: ${app_root}"

    local owner mode
    owner="$(stat -c '%U:%G' "${app_root}")"
    mode="$(stat -c '%a' "${app_root}")"

    [[ "${owner}" == "${RUNTIME_USER}:${RESTORE_WEB_GROUP}" ]] \
        || fail "restored storage tree is owned by ${owner}, expected ${RUNTIME_USER}:${RESTORE_WEB_GROUP}"

    (( 8#${mode} == 8#2710 )) \
        || fail "restored storage tree has mode ${mode}, expected 2710 (Nginx traverses, never lists)"

    if [[ -d "${app_root}/public" ]]; then
        local public_mode public_owner
        public_mode="$(stat -c '%a' "${app_root}/public")"
        public_owner="$(stat -c '%U:%G' "${app_root}/public")"

        (( 8#${public_mode} == 8#2750 )) \
            || fail "restored public storage has mode ${public_mode}, expected 2750"
        [[ "${public_owner}" == "${RUNTIME_USER}:${RESTORE_WEB_GROUP}" ]] \
            || fail "restored public storage is owned by ${public_owner}, expected ${RUNTIME_USER}:${RESTORE_WEB_GROUP}"
    fi

    log "restored storage verified: ${app_root} (${owner}, mode ${mode})"
}

verify_restored_data() {
    verify_restored_database
    verify_restored_storage
    assert_immutables_unchanged
}

# --- compensation -----------------------------------------------------------------------------
#
# Called only from the failure path, and only once activation could have
# changed live state. Both halves are attempted regardless of the other's
# outcome — a storage compensation failure must not leave the database swapped
# — and the combined result decides whether the target may be brought back up
# at all.
compensate_activation() {
    local storage_ok=true database_ok=true

    log "compensating: restoring the pre-restore storage tree and database"

    "${RESTORE_STORAGE_BIN}" --target "${TARGET_ID}" --operation "${OPERATION_ID}" --compensate \
        || storage_ok=false

    "${RESTORE_DATABASE_BIN}" --target "${TARGET_ID}" --operation "${OPERATION_ID}" --compensate \
        || database_ok=false

    if [[ "${storage_ok}" == true ]] && [[ "${database_ok}" == true ]]; then
        COMPENSATION_STATUS="complete"

        # The target is back to exactly its pre-restore state, so the staged
        # copies have no further use: dropping them here is what keeps a
        # failed-and-recovered restore from leaving a full temporary database
        # and a full extracted storage tree behind on the host. The backup
        # itself is untouched and the emergency backup still exists, so
        # nothing that could be needed again is discarded.
        discard_staged_artifacts

        return 0
    fi

    COMPENSATION_STATUS="incomplete"

    return 1
}

# --- history and summary -------------------------------------------------------------------------

append_restore_history() {
    local status="$1"
    local failed_step_json="null"

    if [[ "${status}" != completed ]] && [[ "${status}" != held ]] && [[ "${status}" != resumed ]]; then
        failed_step_json="$(jq -cn --arg v "${CURRENT_STEP}" '$v')"
    fi

    local record
    record="$(
        jq -cn \
            --arg status "${status}" \
            --arg operation_id "${OPERATION_ID}" \
            --arg started_at "${OPERATION_STARTED_AT}" \
            --arg completed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --arg target "${TARGET_ID}" \
            --arg environment "${ENVIRONMENT_CLASS}" \
            --arg backup_namespace "${BACKUP_NAMESPACE}" \
            --arg source "${SOURCE_KIND}" \
            --arg backup "${BACKUP_ID}" \
            --arg backup_release "${BACKUP_RELEASE}" \
            --arg backup_source_sha "${BACKUP_SOURCE_SHA}" \
            --arg current_release_before "${CURRENT_RELEASE_BEFORE}" \
            --arg current_source_sha_before "${CURRENT_SOURCE_SHA_BEFORE}" \
            --arg emergency_backup "${EMERGENCY_BACKUP}" \
            --arg code_alignment "${CODE_ALIGNMENT}" \
            --arg runtime_resumed "${RUNTIME_RESUMED}" \
            --arg compensation_status "${COMPENSATION_STATUS}" \
            --argjson failed_step "${failed_step_json}" \
            '{
                status: $status,
                operation_id: $operation_id,
                started_at: $started_at,
                completed_at: $completed_at,
                target: $target,
                environment: $environment,
                backup_namespace: $backup_namespace,
                source: $source,
                backup: $backup,
                backup_release: $backup_release,
                backup_source_sha: $backup_source_sha,
                current_release_before: $current_release_before,
                current_source_sha_before: $current_source_sha_before,
                emergency_backup: $emergency_backup,
                code_alignment: $code_alignment,
                runtime_resumed: $runtime_resumed,
                failed_step: $failed_step,
                compensation_status: $compensation_status
            }'
    )" || return 1

    restore_history_append "${record}"
}

# --- machine-readable result ------------------------------------------------------------------------
#
# Exactly one line, on exactly one terminal SUCCESS, in a fixed shape:
#
#   RATEGURU_RESTORE_RESULT={"status":"held", ...}
#
# The human summary above stays exactly as it is — an operator reading a
# terminal is the primary audience and always will be. This exists because the
# GitHub restore workflow is not an operator: it has to branch on whether the
# target came back or is waiting for its code, and grepping prose for that
# answer would make every future wording change a silent behaviour change.
#
# Rules the consumer relies on, and that the emitter therefore enforces:
#
#   * one object per invocation, never zero and never two — the flag below is
#     what makes a second call a loud internal error rather than an ambiguity
#     the reader has to resolve;
#   * emitted only on a terminal SUCCESS. A failure exits non-zero, which is
#     already unambiguous, and a result line on a failed run would invite a
#     consumer to read state out of a run that did not finish;
#   * identity only. Release IDs, commits, backup IDs and an operation ID are
#     public build/operation identity; no .env value, credential, path inside
#     a private tree or host detail is ever a field here.
RESTORE_RESULT_EMITTED=false

emit_restore_result() {
    local status="$1"

    [[ "${RESTORE_RESULT_EMITTED}" == false ]] \
        || fail "internal error: the machine-readable restore result was already emitted"

    RESTORE_RESULT_EMITTED=true

    local result
    result="$(
        jq -cn \
            --arg status "${status}" \
            --arg operation_id "${OPERATION_ID}" \
            --arg target "${TARGET_ID}" \
            --arg backup "${BACKUP_ID}" \
            --arg backup_release "${BACKUP_RELEASE}" \
            --arg backup_source_sha "${BACKUP_SOURCE_SHA}" \
            --arg required_source_sha "${BACKUP_SOURCE_SHA}" \
            --arg current_source_sha "${RESTORE_CURRENT_SOURCE_SHA:-}" \
            --arg code_alignment "${CODE_ALIGNMENT}" \
            --arg runtime_resumed "${RUNTIME_RESUMED}" \
            '{
                status: $status,
                operation_id: $operation_id,
                target: $target,
                backup: $backup,
                backup_release: $backup_release,
                backup_source_sha: $backup_source_sha,
                required_source_sha: $required_source_sha,
                current_source_sha: $current_source_sha,
                code_alignment: $code_alignment,
                runtime_resumed: $runtime_resumed
            }'
    )" || fail "could not render the machine-readable restore result"

    printf 'RATEGURU_RESTORE_RESULT=%s\n' "${result}"
}

print_summary() {
    local data_complete="$1"

    printf '\n'
    printf '========================================================\n'
    printf 'RESTORE DATA COMPLETE: %s\n' "${data_complete}"
    printf 'CODE ALIGNMENT: %s\n' "${CODE_ALIGNMENT}"
    printf 'BACKUP RELEASE: %s\n' "${BACKUP_RELEASE:-unknown}"
    printf 'BACKUP SOURCE SHA: %s\n' "${BACKUP_SOURCE_SHA:-unknown}"
    printf 'CURRENT RELEASE: %s\n' "${RESTORE_CURRENT_RELEASE:-unknown}"
    printf 'CURRENT SOURCE SHA: %s\n' "${RESTORE_CURRENT_SOURCE_SHA:-unknown}"
    printf 'TARGET RESUMED: %s\n' "$(printf '%s' "${RUNTIME_RESUMED}" | tr '[:lower:]' '[:upper:]')"
    printf 'OPERATION: %s\n' "${OPERATION_ID}"
    printf 'EMERGENCY BACKUP: %s\n' "${EMERGENCY_BACKUP:-none}"
    printf '========================================================\n'
}

# --- failure handling ---------------------------------------------------------------------------
#
# set -E means this trap is inherited by every $(...) subshell, including ones
# whose command can legitimately fail. Recording the main process's BASHPID
# before arming the trap, and comparing against it here, makes every
# invocation from outside the main process a silent, side-effect-free exit —
# the same generic guard install-target-operations already uses.
handle_restore_exit() {
    local code=$?
    trap - ERR EXIT

    if [[ "${BASHPID}" != "${MAIN_BASHPID}" ]]; then
        exit "${code}"
    fi

    if [[ "${RESTORE_TERMINAL}" == true ]]; then
        exit "${code}"
    fi

    log "restore failed (exit ${code}) during step: ${CURRENT_STEP}"

    local status="failed"

    case "${MUTATION_STAGE}" in
        none)
            # Nothing live was ever touched. Remove the staged artifacts so a
            # failed attempt leaves no temporary database or half-extracted
            # tree behind, then report.
            discard_staged_artifacts
            status="failed"
            ;;
        quiesced)
            # Quiesced, but no live data was mutated: put the runtime back
            # exactly as it was.
            discard_staged_artifacts

            if resume_runtime_quietly; then
                status="failed"
            else
                status="failed-held"
            fi
            ;;
        activating|activated)
            if compensate_activation; then
                if resume_runtime_quietly; then
                    status="failed-recovered"
                else
                    status="failed-held"
                fi
            else
                status="failed-held"
            fi
            ;;
        committed)
            # The data restore itself completed and committed; the failure is
            # in resuming the runtime. There is nothing to compensate, and the
            # target must stay held rather than be brought up unproven.
            hold_runtime
            status="failed-held"
            ;;
    esac

    # The guard is already on disk by the time any of the above can fail, so
    # the only question here is whether this outcome earned its removal.
    #
    # It did exactly when the live data provably matches the code again: the
    # activation never began, or compensation put the data back. Anything else
    # — a compensation that could not be confirmed, a committed restore whose
    # runtime would not come up — keeps it, re-labelled with the outcome.
    if [[ "${RESTORE_GUARD_WRITTEN}" == true ]]; then
        case "${MUTATION_STAGE}" in
            none|quiesced)
                # The guard is written last before the first activation, so
                # reaching here means the failure was the guard's own step or
                # the one after it: nothing live was touched.
                clear_restore_guard || true
                ;;
            activating|activated)
                if [[ "${COMPENSATION_STATUS}" == "complete" ]]; then
                    clear_restore_guard || true
                else
                    write_restore_guard "${status}" || true
                fi
                ;;
            *)
                write_restore_guard "${status}" || true
                ;;
        esac
    fi

    # Every recovery action below is wrapped in a subshell: `fail` is an
    # `exit`, and an exit from inside this handler would abandon the rest of
    # the reporting — the original failure must always reach the operator.
    if [[ -n "${STATE_FILE}" ]] && [[ -f "${STATE_FILE}" ]]; then
        (
            restore_state_set "${STATE_FILE}" \
                status "${status}" \
                failed_step "${CURRENT_STEP}" \
                compensation_status "${COMPENSATION_STATUS}" \
                completed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        ) || log "WARNING: could not record the terminal restore state"
    fi

    append_restore_history "${status}" || log "WARNING: could not append the restore history record"

    if [[ "${status}" == "failed-held" ]]; then
        printf '\n'
        printf '########################################################\n'
        printf '# MANUAL RECOVERY REQUIRED\n'
        printf '# target: %s\n' "${TARGET_ID}"
        printf '# operation: %s\n' "${OPERATION_ID}"
        printf '# failed step: %s\n' "${CURRENT_STEP}"
        printf '# compensation: %s\n' "${COMPENSATION_STATUS}"
        printf '# emergency backup: %s\n' "${EMERGENCY_BACKUP:-none}"
        printf '# The target is intentionally NOT serving traffic.\n'
        printf '# ordinary backups of this target refuse while the hold marker exists:\n'
        printf '#   %s\n' "$(restore_guard_file "${TARGET_ID}" "${RUN_ROOT}")"


        if [[ "${HOLD_UNCONFIRMED}" == true ]]; then
            printf '# WARNING: one or more writers could NOT be proven stopped.\n'
            printf '#          See the ERROR lines above before touching this data.\n'
        fi

        printf '# state: %s\n' "${STATE_FILE}"
        printf '########################################################\n'
    fi

    exit "${code}"
}

# discard_staged_artifacts — best-effort removal of everything a failed
# pre-activation attempt created OUTSIDE the workspace. Never fatal: it runs
# on a path that is already reporting a different failure.
discard_staged_artifacts() {
    local staged_database storage_root stage_parent

    [[ -n "${STATE_FILE}" ]] && [[ -f "${STATE_FILE}" ]] || return 0

    staged_database="$(restore_state_get "${STATE_FILE}" staged_database 2>/dev/null || printf '')"

    if [[ -n "${staged_database}" ]]; then
        "${RUNUSER_BIN}" -u "${POSTGRES_SUPERUSER}" -- \
            "${DROPDB_BIN}" --if-exists "${staged_database}" >/dev/null 2>&1 || true
    fi

    # Derived, never read from state: an extraction that failed halfway never
    # got to record storage_stage_path, and that is exactly when a root-owned
    # half-extracted tree would otherwise be left behind. The path is a pure
    # function of the target and the operation ID, so it is always knowable.
    storage_root="$(restore_storage_root "${TARGET_ROOT}")"
    stage_parent="$(restore_storage_stage_parent "${TARGET_ROOT}" "${OPERATION_ID}")"

    if [[ -e "${stage_parent}" ]] || [[ -L "${stage_parent}" ]]; then
        # Subshell: the guarded remover calls `fail` on anything it refuses,
        # and an exit from here would abandon the failure report.
        ( restore_remove_storage_sibling "${storage_root}" "${stage_parent}" ) >/dev/null 2>&1 || true
    fi
}

# resume_runtime_quietly — resume_runtime without letting its own failure
# replace the original diagnosis. Returns non-zero when the runtime could not
# be fully restored, so the caller can hold the target instead.
resume_runtime_quietly() {
    if resume_runtime; then
        return 0
    fi

    hold_runtime

    return 1
}

# --- apply --------------------------------------------------------------------------------------

perform_restore() {
    validate_backup_id "${BACKUP_ID}"

    OPERATION_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    step "acquire restore operation lock"
    acquire_restore_operation_lock

    step "validate deployed target"
    assert_deployed_target

    # A target already held from an earlier restore has data that does not match
    # its code. Checked before an operation ID or a workspace exists, so a
    # mistaken re-run leaves no new state behind at all — and long before the
    # emergency "pre-restore" backup would have snapshotted that mismatch.
    step "check restore hold"
    assert_no_restore_hold "${TARGET_ID}" "${RUN_ROOT}" "a new restore"

    step "create operation workspace"
    OPERATION_ID="$(generate_operation_id)"
    WORKSPACE="$(restore_create_operation_workspace "${TARGET_ID}" "${OPERATION_ID}")"
    STATE_FILE="$(restore_state_file "${WORKSPACE}")"
    restore_state_init "${STATE_FILE}"

    MAIN_BASHPID="${BASHPID}"
    trap handle_restore_exit ERR EXIT

    restore_state_set "${STATE_FILE}" \
        operation_id "${OPERATION_ID}" \
        target "${TARGET_ID}" \
        environment "${ENVIRONMENT_CLASS}" \
        backup_namespace "${BACKUP_NAMESPACE}" \
        source "${SOURCE_KIND}" \
        backup "${BACKUP_ID}" \
        started_at "${OPERATION_STARTED_AT}" \
        current_release_before "${CURRENT_RELEASE_BEFORE}" \
        current_source_sha_before "${CURRENT_SOURCE_SHA_BEFORE}" \
        status running \
        phase initialized

    log "${LABEL} restore operation ${OPERATION_ID} (source=${SOURCE_KIND} backup=${BACKUP_ID})"

    step "stage backup"
    "${RESTORE_FETCH_BACKUP_BIN}" \
        --target "${TARGET_ID}" \
        --source "${SOURCE_KIND}" \
        --backup "${BACKUP_ID}" \
        --operation "${OPERATION_ID}"
    restore_state_set "${STATE_FILE}" phase backup-staged

    step "verify backup"
    "${RESTORE_VERIFY_BACKUP_BIN}" \
        --target "${TARGET_ID}" \
        --operation "${OPERATION_ID}" \
        --for-restore

    local identity_file
    identity_file="$(restore_identity_file "${WORKSPACE}")"
    BACKUP_RELEASE="$(jq -r '.release // empty' "${identity_file}")"
    BACKUP_SOURCE_SHA="$(jq -r '.source_sha // empty' "${identity_file}")"

    [[ -n "${BACKUP_RELEASE}" ]] && [[ -n "${BACKUP_SOURCE_SHA}" ]] \
        || fail "the verified backup identity carries no release/source_sha"

    restore_state_set "${STATE_FILE}" \
        backup_release "${BACKUP_RELEASE}" \
        backup_source_sha "${BACKUP_SOURCE_SHA}" \
        phase backup-verified

    step "stage database"
    "${RESTORE_DATABASE_BIN}" --target "${TARGET_ID}" --operation "${OPERATION_ID}" --stage

    step "stage storage"
    "${RESTORE_STORAGE_BIN}" --target "${TARGET_ID}" --operation "${OPERATION_ID}" --stage

    step "acquire deployment lock"
    acquire_deployment_lock "${TARGET_ROOT}"

    # Re-read after taking the lock: everything above ran while deploy,
    # rollback and cleanup could still have been running, so the release the
    # alignment decision is made against must be the one that is current NOW.
    assert_deployed_target
    record_immutable_baseline
    restore_state_set "${STATE_FILE}" \
        current_release_before "${CURRENT_RELEASE_BEFORE}" \
        current_source_sha_before "${CURRENT_SOURCE_SHA_BEFORE}"

    step "capture runtime state"
    capture_runtime_state

    step "quiesce target"
    MUTATION_STAGE=quiesced
    quiesce_http
    quiesce_queue
    quiesce_scheduler
    restore_state_set "${STATE_FILE}" phase quiesced

    step "emergency pre-restore backup"
    create_emergency_backup
    restore_state_set "${STATE_FILE}" phase emergency-backup-verified

    # The last thing before anything live is touched, and a hard prerequisite
    # of touching it. From here on the data may be the backup's while
    # current/release.json still names the old commit, and the host's own
    # backup cron — not the Laravel scheduler, and not held by this operation —
    # is free to run the moment this process stops holding its locks. It stops
    # holding them the instant it is SIGKILLed, with no trap and no handler.
    #
    # Failing here is cheap: no live data has been touched, and the runtime
    # goes back exactly as it was. Failing to write it and continuing would
    # not be.
    step "write restore guard"
    write_restore_guard in-progress \
        || fail "could not write the restore guard — refusing to mutate live data that nothing would then stop an ordinary backup from mislabelling"

    step "activate database"
    MUTATION_STAGE=activating
    "${RESTORE_DATABASE_BIN}" --target "${TARGET_ID}" --operation "${OPERATION_ID}" --activate
    MUTATION_STAGE=activated

    step "activate storage"
    "${RESTORE_STORAGE_BIN}" --target "${TARGET_ID}" --operation "${OPERATION_ID}" --activate

    step "verify restored data"
    verify_restored_data
    restore_state_set "${STATE_FILE}" phase verified

    # MUTATION_STAGE moves to `committed` BEFORE the commit calls, not after.
    # Commit only discards the retained pre-restore copies, and the restore is
    # already verified at this point — so a failure here must never be
    # answered by compensating a verified restore. Doing that would undo the
    # half whose old copy still exists and leave the other half restored: a
    # mixed database/storage state, brought back up as if it were fine.
    # Instead the target is held, loudly, with both halves consistent.
    step "commit"
    MUTATION_STAGE=committed
    "${RESTORE_STORAGE_BIN}" --target "${TARGET_ID}" --operation "${OPERATION_ID}" --commit
    "${RESTORE_DATABASE_BIN}" --target "${TARGET_ID}" --operation "${OPERATION_ID}" --commit
    restore_state_set "${STATE_FILE}" phase committed

    step "decide code alignment"
    decide_code_alignment
}

# --- code alignment ---------------------------------------------------------------------------------
#
# The restore never switches releases, never builds anything and never runs a
# migration. It only answers one question: does the code this target is
# serving RIGHT NOW correspond to the commit the restored data was taken
# under?
#
#   aligned   -> the target goes back to exactly the runtime state it had
#   required  -> the DATA restore is complete and successful, but the target
#                stays in maintenance with its queue and scheduler held until
#                the matching code is deployed and `--resume` is run
decide_code_alignment() {
    restore_read_current_identity "${TARGET_ROOT}"

    if [[ "${RESTORE_CURRENT_SOURCE_SHA}" == "${BACKUP_SOURCE_SHA}" ]]; then
        CODE_ALIGNMENT="ALIGNED"
        restore_state_set "${STATE_FILE}" code_alignment aligned

        step "resume runtime"
        resume_runtime || fail "could not resume the target runtime after an aligned restore"

        step "health check"
        "${RESTORE_HEALTH_CHECK_BIN}" --target "${TARGET_ID}" \
            || fail "health check failed after the restore"

        # Data verified before the commit, code proven to match, runtime up and
        # healthy: the guard has nothing left to protect.
        step "clear restore guard"
        clear_restore_guard \
            || fail "the restore succeeded but its guard could not be removed — ordinary backups of ${TARGET_ID} will keep refusing until it is gone"

        restore_state_set "${STATE_FILE}" \
            status completed \
            runtime_resumed yes \
            completed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

        RESTORE_TERMINAL=true
        trap - ERR EXIT

        append_restore_history completed \
            || fail "could not append the restore history record"

        print_summary YES
        emit_restore_result completed

        log "${LABEL} restore completed and the target is serving again"
        cleanup_completed_operation

        return 0
    fi

    CODE_ALIGNMENT="REQUIRED"
    RUNTIME_RESUMED="no"

    restore_state_set "${STATE_FILE}" \
        status held \
        code_alignment required \
        runtime_resumed no \
        completed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    # The guard has been in place since before the first activation; this only
    # re-labels it with the outcome. Non-fatal precisely because it is already
    # doing its job: a failed re-label leaves it at `in-progress`, which blocks
    # an ordinary backup just as firmly.
    write_restore_guard held \
        || log "WARNING: the restore guard could not be re-labelled; it remains in place and ordinary backups still refuse"

    RESTORE_TERMINAL=true
    trap - ERR EXIT

    append_restore_history held \
        || fail "could not append the restore history record"

    print_summary YES
    emit_restore_result held

    printf '\n'
    printf 'The DATA restore succeeded. The target is intentionally HELD:\n'
    printf '  maintenance: ON\n'
    printf '  queue:       HELD\n'
    printf '  scheduler:   HELD\n'
    printf '\n'
    printf 'Do NOT use the normal deployment path to resume this operation.\n'
    printf 'A normal deploy is not restore-aware: it health-checks the target and\n'
    printf 'transitions the queue, both of which fight the hold this operation is\n'
    printf 'deliberately keeping. What finishes this is a CONTROLLED code alignment:\n'
    printf 'the same deploy, run with --restore-operation, which installs the exact\n'
    printf 'required commit while PRESERVING the hold, followed by --resume.\n'
    printf '\n'
    printf 'REQUIRED SOURCE SHA: %s\n' "${BACKUP_SOURCE_SHA}"
    printf 'FROM GITHUB: run the Restore workflow for this target with\n'
    printf '  mode=continue-held  operation=%s\n' "${OPERATION_ID}"
    printf 'BY HAND, once an artifact built from that exact commit is on this host:\n'
    printf '  deploy --target %s --release <release-id> --artifact <path> \\\n' "${TARGET_ID}"
    printf '         --restore-operation %s\n' "${OPERATION_ID}"
    printf '  restore-target --resume --target %s --operation %s\n' "${TARGET_ID}" "${OPERATION_ID}"
    printf '\n'
}

# cleanup_completed_operation — the workspace of a fully completed, resumed
# operation carries nothing anyone needs any more: the staged backup is a
# duplicate of a backup that still exists, and the outcome is in the history
# journal. Removed through the guarded helper, never a raw rm -rf.
cleanup_completed_operation() {
    if ( restore_remove_operation_path "${WORKSPACE}" ); then
        log "operation workspace removed: ${WORKSPACE}"
    else
        log "WARNING: could not remove the operation workspace: ${WORKSPACE}"
    fi
}

# --- inspect ------------------------------------------------------------------------------------------
#
# Strictly read-only. It changes no database, no storage tree, no queue, no
# scheduler entry, no maintenance flag, no `current` link and no guard — it
# takes the operation lock (so it cannot read state a running restore is
# halfway through writing) and reads.
#
# It exists because a controlled code alignment is a chain across two systems,
# and the GitHub half of it can fail on its own: a historical commit that no
# longer builds, a cancelled workflow run, a runner that died, or an operator
# who simply comes back the next day. The target is still held — correctly,
# and indefinitely — and the question that has to be answerable at any later
# point is "what exactly is this target waiting for?".
#
# The answer is never taken from the caller: the operation ID is all that is
# supplied, and the commit, the backup and the hold status all come out of the
# server's own persisted restore documents.
#
# What it deliberately does NOT do is decide anything about an operation that
# is not a plain code-alignment hold. `in-progress` and `failed-held` mean a
# restore is still running or failed with live data that may have been
# replaced: neither is finished by deploying a commit, and saying so is more
# useful than a generic refusal.

# A diagnosis, not an authorization: assert_restore_alignment_operation below
# is what actually decides. This only exists so the two statuses an operator
# will really hit get told what to do next.
inspect_diagnose_unalignable_hold() {
    local marker guard_status guard_operation

    marker="$(restore_guard_file "${TARGET_ID}" "${RUN_ROOT}")"

    [[ -f "${marker}" ]] || return 0

    guard_status="$(jq -r '.status // empty' "${marker}" 2>/dev/null || printf '')"
    guard_operation="$(jq -r '.operation // empty' "${marker}" 2>/dev/null || printf '')"

    case "${guard_status}" in
        in-progress)
            fail "${TARGET_ID} is held by restore operation ${guard_operation:-<unknown>} with status 'in-progress': a restore either is still running or was killed between activating the data and finishing. It is NOT a code-alignment hold, and continuing the alignment flow against it is unsafe — no build, no deployment and no --resume. Read ${marker} and the operation's own state, and recover it by hand. Repair Target is not a way out either: it refuses a target under any restore guard, precisely because this state is a data decision and not an infrastructure one"
            ;;
        failed-held)
            fail "${TARGET_ID} is held by restore operation ${guard_operation:-<unknown>} with status 'failed-held': a restore failed leaving live data that may already have been replaced. It is NOT a code-alignment hold, and continuing the alignment flow against it is unsafe — no build, no deployment and no --resume. The operation's own MANUAL RECOVERY REQUIRED report names the failed step, the compensation status and the emergency backup; recover it by hand. Repair Target is not a way out either: it refuses a target under any restore guard, precisely because this state is a data decision and not an infrastructure one"
            ;;
    esac
}

# assert_runtime_still_held — the outside view of a hold: nothing may be
# serving, nothing may be consuming the queue, and no cron entry may fire a
# scheduler against this target.
#
# This is the one implementation of that proof. The controlled alignment deploy
# does not re-derive it — it runs this, through --inspect — because reading
# Supervisor correctly is subtle enough that a second copy would eventually
# disagree with this one, and the disagreement would be discovered by a queue
# worker writing to a database it should not have been able to reach.
assert_runtime_still_held() {
    maintenance_active \
        || fail "${TARGET_ID} is NOT in maintenance mode — the hold this operation depends on is gone, and it is not safe to continue the alignment flow"

    # One observation, classified here rather than through
    # queue_program_fully_stopped, which would observe a second time: two reads
    # can legitimately disagree, and the states named in the refusal below must
    # be the ones the decision was actually made on.
    observe_queue_program \
        || fail "cannot observe the target queue program ${SUPERVISOR_PROGRAM}: ${QUEUE_OBSERVATION_ERROR} — refusing to report a target as held without knowing whether a worker is running"

    local state
    for state in "${QUEUE_PROCESS_STATES[@]}"; do
        [[ "${state}" == "STOPPED" ]] \
            || fail "the target queue program ${SUPERVISOR_PROGRAM} is not fully STOPPED (${QUEUE_PROCESS_STATES[*]}) — the hold this operation depends on is gone, and it is not safe to continue the alignment flow"
    done

    if scheduler_file_present; then
        fail "${SCHEDULER_FILE} is present — a scheduled writer can fire against this target, so the hold this operation depends on is gone and it is not safe to continue the alignment flow"
    fi
}

perform_inspect() {
    validate_operation_id "${OPERATION_ID}"

    step "acquire restore operation lock"
    acquire_restore_operation_lock

    step "diagnose hold status"
    inspect_diagnose_unalignable_hold

    # Guard and state, both read, both required to agree — the identical
    # authorization the controlled alignment deploy performs, which is exactly
    # the point: an operation --inspect reports as continuable is one the
    # deploy will accept, and one it refuses is refused here first.
    step "authorize code alignment"
    assert_restore_alignment_operation "${TARGET_ID}" "${RUN_ROOT}" "${OPERATION_ID}"

    step "load operation state"
    WORKSPACE="$(restore_require_operation_workspace "${TARGET_ID}" "${OPERATION_ID}")"
    STATE_FILE="$(restore_state_file "${WORKSPACE}")"

    OPERATION_STARTED_AT="$(restore_state_get "${STATE_FILE}" started_at)"
    SOURCE_KIND="$(restore_state_get "${STATE_FILE}" source)"
    BACKUP_ID="$(restore_state_get "${STATE_FILE}" backup)"
    BACKUP_RELEASE="$(restore_state_get "${STATE_FILE}" backup_release)"
    BACKUP_SOURCE_SHA="$(restore_state_get "${STATE_FILE}" backup_source_sha)"
    EMERGENCY_BACKUP="$(restore_state_get "${STATE_FILE}" emergency_backup)"

    # Already proven identical to the guard's required commit by the
    # authorization above; re-checked here because everything reported below
    # is derived from it.
    [[ "${BACKUP_SOURCE_SHA}" == "${RESTORE_ALIGNMENT_REQUIRED_SHA}" ]] \
        || fail "restore operation ${OPERATION_ID} state and guard disagree about the required commit"

    validate_backup_id "${BACKUP_ID}"

    step "validate deployed target"
    assert_deployed_target

    step "verify the target is still held"
    assert_runtime_still_held

    step "read current release identity"
    restore_read_current_identity "${TARGET_ROOT}"

    CODE_ALIGNMENT="REQUIRED"
    RUNTIME_RESUMED="no"

    printf '\n'
    printf '========================================================\n'
    printf 'RESTORE OPERATION: %s\n' "${OPERATION_ID}"
    printf 'TARGET: %s\n' "${TARGET_ID}"
    printf 'STATUS: HELD (data restored, awaiting code alignment)\n'
    printf 'BACKUP: %s\n' "${BACKUP_ID}"
    printf 'BACKUP RELEASE: %s\n' "${BACKUP_RELEASE}"
    printf 'REQUIRED SOURCE SHA: %s\n' "${BACKUP_SOURCE_SHA}"
    printf 'CURRENT RELEASE: %s\n' "${RESTORE_CURRENT_RELEASE:-unknown}"
    printf 'CURRENT SOURCE SHA: %s\n' "${RESTORE_CURRENT_SOURCE_SHA:-unknown}"
    printf 'EMERGENCY BACKUP: %s\n' "${EMERGENCY_BACKUP:-none}"
    printf 'RUNTIME: maintenance ON, queue STOPPED, scheduler HELD\n'
    printf '========================================================\n'

    emit_restore_result held

    log "${LABEL} restore operation ${OPERATION_ID} inspected; nothing was changed"
}

# --- resume ------------------------------------------------------------------------------------------

perform_resume() {
    validate_operation_id "${OPERATION_ID}"

    step "acquire restore operation lock"
    acquire_restore_operation_lock

    step "load operation state"
    WORKSPACE="$(restore_require_operation_workspace "${TARGET_ID}" "${OPERATION_ID}")"
    STATE_FILE="$(restore_state_file "${WORKSPACE}")"

    [[ -f "${STATE_FILE}" ]] || fail "restore operation has no state file: ${STATE_FILE}"

    local state_target state_status state_phase
    state_target="$(restore_state_get "${STATE_FILE}" target)"
    state_status="$(restore_state_get "${STATE_FILE}" status)"
    state_phase="$(restore_state_get "${STATE_FILE}" phase)"

    [[ "${state_target}" == "${TARGET_ID}" ]] \
        || fail "restore operation ${OPERATION_ID} belongs to target ${state_target:-<unset>}, not ${TARGET_ID}"

    [[ "${state_status}" == "held" ]] \
        || fail "restore operation ${OPERATION_ID} has status '${state_status:-<unset>}' — --resume only applies to an operation whose data restore completed and whose runtime is held for code alignment"

    [[ "${state_phase}" == "committed" ]] \
        || fail "restore operation ${OPERATION_ID} is in phase '${state_phase:-<unset>}', expected committed"

    OPERATION_STARTED_AT="$(restore_state_get "${STATE_FILE}" started_at)"
    SOURCE_KIND="$(restore_state_get "${STATE_FILE}" source)"
    BACKUP_ID="$(restore_state_get "${STATE_FILE}" backup)"
    BACKUP_RELEASE="$(restore_state_get "${STATE_FILE}" backup_release)"
    BACKUP_SOURCE_SHA="$(restore_state_get "${STATE_FILE}" backup_source_sha)"
    EMERGENCY_BACKUP="$(restore_state_get "${STATE_FILE}" emergency_backup)"
    CURRENT_RELEASE_BEFORE="$(restore_state_get "${STATE_FILE}" current_release_before)"
    CURRENT_SOURCE_SHA_BEFORE="$(restore_state_get "${STATE_FILE}" current_source_sha_before)"
    MAINTENANCE_BEFORE="$(restore_state_get "${STATE_FILE}" maintenance_before)"
    QUEUE_RUNNING_BEFORE="$(restore_state_get "${STATE_FILE}" queue_running_before)"
    SCHEDULER_PRESENT_BEFORE="$(restore_state_get "${STATE_FILE}" scheduler_present_before)"
    MAINTENANCE_ENTERED_BY_RESTORE="$(restore_state_get "${STATE_FILE}" maintenance_entered_by_restore)"
    QUEUE_STOPPED_BY_RESTORE="$(restore_state_get "${STATE_FILE}" queue_stopped_by_restore)"
    SCHEDULER_HELD_BY_RESTORE="$(restore_state_get "${STATE_FILE}" scheduler_held_by_restore)"

    [[ "${BACKUP_SOURCE_SHA}" =~ ${RESTORE_SOURCE_SHA_REGEX} ]] \
        || fail "restore operation ${OPERATION_ID} carries no usable backup source_sha"

    step "acquire deployment lock"
    acquire_deployment_lock "${TARGET_ROOT}"

    step "validate deployed target"
    assert_deployed_target

    step "check code alignment"
    restore_read_current_identity "${TARGET_ROOT}"

    if [[ "${RESTORE_CURRENT_SOURCE_SHA}" != "${BACKUP_SOURCE_SHA}" ]]; then
        CODE_ALIGNMENT="REQUIRED"
        print_summary YES

        fail "the current release still does not carry the backup's source_sha (${BACKUP_SOURCE_SHA}) — the target stays held"
    fi

    CODE_ALIGNMENT="ALIGNED"

    MAIN_BASHPID="${BASHPID}"
    MUTATION_STAGE=committed
    # A held operation always has one on disk; saying so lets the terminal
    # handler re-label it rather than believing there is nothing to re-label.
    RESTORE_GUARD_WRITTEN=true
    trap handle_restore_exit ERR EXIT

    step "resume runtime"
    resume_runtime || fail "could not resume the target runtime"

    step "health check"
    "${RESTORE_HEALTH_CHECK_BIN}" --target "${TARGET_ID}" \
        || fail "health check failed after resume"

    step "verify restored data"
    verify_restored_database
    verify_restored_storage

    # Code alignment checked, runtime resumed, health check passed and the
    # restored data verified — only now does this target's data provably match
    # the code serving it, and only now may an ordinary backup label it.
    step "clear restore guard"
    clear_restore_guard \
        || fail "the resume succeeded but its guard could not be removed — ordinary backups of ${TARGET_ID} will keep refusing until it is gone"

    restore_state_set "${STATE_FILE}" \
        status resumed \
        code_alignment aligned \
        runtime_resumed yes \
        resumed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    RESTORE_TERMINAL=true
    trap - ERR EXIT

    append_restore_history resumed \
        || fail "could not append the restore history record"

    print_summary YES
    emit_restore_result resumed

    log "${LABEL} restore operation ${OPERATION_ID} resumed; the target is serving again"
    cleanup_completed_operation
}

# --- dispatch --------------------------------------------------------------------------------------------
#
# require_root stays the first substantive action of a real invocation,
# matching deploy/rollback/backup's contract exactly.
main() {
    require_root
    parse_restore_target_args "$@"
    resolve_restore_target_subject

    case "${MODE}" in
        apply)   perform_restore ;;
        inspect) perform_inspect ;;
        resume)  perform_resume ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
