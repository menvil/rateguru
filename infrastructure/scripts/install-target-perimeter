#!/usr/bin/env bash
#
# install-target-perimeter — install/verify the target-only operational
# perimeter: the four generic sudo wrappers, the sudoers rule granting the
# staging deploy user access to them, the backup cron entry, and the
# transactional removal of the six legacy per-environment sudo wrappers.
#
# Modes:
#   --check   Validate the committed source files, host tooling, AND that
#             the real installed seventeen-file target operations bundle
#             (install-target-operations' own responsibility, a prerequisite
#             this installer depends on but does not own) is present,
#             correctly owned/moded, and byte-identical to this repository's
#             committed sources. Reports which of the six legacy wrappers
#             are currently present and would be removed by --apply.
#             Read-only: makes NO changes to the system.
#   --apply   Everything --check does, as its own preflight, then installs
#             the four wrappers, the sudoers rule and the backup cron
#             entry, and removes the six legacy wrappers: verifies a staged
#             copy before touching anything, installs transactionally, then
#             verifies the installed result against the real host before
#             committing. On any failure, restores the generic perimeter
#             files, sudoers, cron, and every legacy wrapper that existed
#             before this run, each with its original owner/group/mode/
#             content — a legacy wrapper that was already absent stays
#             absent.
#   --verify  Re-run the installed-file and runtime-parity checks against
#             whatever is currently installed, including the operations
#             bundle check above and confirming all six legacy wrapper paths
#             are absent. Makes NO changes, creates NO backup.
#
# What this installs — and does not:
#   * Six files: the four generic wrappers (rateguru-deploy,
#     rateguru-rollback, rateguru-cleanup, rateguru-restore), the sudoers rule
#     that grants the staging deploy user access to them, and the
#     backup-cycle/restore-test/offsite-restore-test cron entries. deploy, rollback, cleanup,
#     backup-cycle, restore-test, offsite-restore-test, and the other files
#     in the operations bundle are untouched by this installer — they
#     already support --target (installed by install-target-operations, a
#     prerequisite this installer depends on but does not own). This
#     installer only ever *verifies* that bundle is current — see "Installed
#     operations bundle staleness guard" below — never installs, modifies,
#     or takes ownership of any of it.
#   * Six required-absent files: the legacy per-environment wrappers
#     (rateguru-staging-deploy/rollback/cleanup,
#     rateguru-production-deploy/rollback/cleanup). --apply removes any of
#     these still present on the host. --check never fails merely because
#     one is present — it only reports the removal plan, read-only. --verify
#     is different: it fails closed if any of the six is still present,
#     since it is meant to run only after a successful --apply has already
#     removed them — do not run --verify to "check" presence the way --check
#     does.
#   * Never touches deployment.conf or the target registry.
#   * Never adds a sudoers rule for tits-guru's deploy user: tits-guru stays
#     lifecycle=planned, and this installer does not provision it.
#
# Destinations are fixed, hardcoded constants — see "Locations" below — save
# for two deliberate test seams, both gated behind
# RATEGURU_ALLOW_TEST_OVERRIDES=true: RATEGURU_PERIMETER_ROOT prefixes every
# destination path this installer actually owns (including the six legacy
# wrapper paths), plus the backup root; RATEGURU_INSTALLED_OPERATIONS_ROOT
# separately prefixes the read-only operations bundle this installer only
# ever verifies. Either lets the relevant logic be exercised end to end
# against a private scratch tree. Production never sets any of these, so
# both resolve to the exact real absolute destinations below.

set -Eeuo pipefail
umask 022

# --- Locations (fixed; PERIMETER_ROOT is the one deliberate test seam) -----

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd -P)"

SRC_SELF="${SCRIPT_DIR}/install-target-perimeter"
SRC_WRAPPER_DEPLOY="${REPO_ROOT}/infrastructure/config/wrappers/rateguru-deploy"
SRC_WRAPPER_ROLLBACK="${REPO_ROOT}/infrastructure/config/wrappers/rateguru-rollback"
SRC_WRAPPER_CLEANUP="${REPO_ROOT}/infrastructure/config/wrappers/rateguru-cleanup"
# The restore perimeter. The restricted deploy credential gains one
# more thing it may ask for by name — a restore of the target it is registered
# for — and nothing else. Everything destructive about a restore stays in
# /home/www/rateguru/bin/restore-target, which this wrapper is the only remote
# route to.
SRC_WRAPPER_RESTORE="${REPO_ROOT}/infrastructure/config/wrappers/rateguru-restore"
SRC_SUDOERS="${REPO_ROOT}/infrastructure/config/sudoers/rateguru-deploy"
SRC_CRON="${REPO_ROOT}/infrastructure/config/cron/rateguru-backups"

# Referenced, unchanged operational tooling. Read-only: install-target-perimeter
# never installs, modifies, or takes ownership of any of these — that is
# install-target-operations' job, a prerequisite this installer depends on.
# Used only to prove the committed sources still declare --target support and
# to give the staged/installed wrappers a self-contained common/registry to
# resolve against during this installer's own safe probes (see
# wrapper_probe_env below).
SRC_COMMON="${REPO_ROOT}/infrastructure/scripts/common"
SRC_TARGETS="${REPO_ROOT}/infrastructure/scripts/targets"
SRC_REGISTRY="${REPO_ROOT}/infrastructure/config/deployment-targets.json"
# common unconditionally sources deployment.conf at its own top, before any
# function is even defined — every wrapper probe below needs a valid one
# regardless of target mode. The committed example template is exactly what
# every other Architecture test already points RATEGURU_DEPLOYMENT_CONF_FILE
# at (see e.g. BackupCycleTest.php's backupCycleDeploymentConfPath()).
SRC_DEPLOYMENT_CONF="${REPO_ROOT}/infrastructure/templates/deployment.conf.example"
SRC_HEALTH_CHECK="${REPO_ROOT}/infrastructure/scripts/health-check"
SRC_STATUS="${REPO_ROOT}/infrastructure/scripts/status"
SRC_DEPLOY="${REPO_ROOT}/infrastructure/scripts/deploy"
SRC_RESTORE_TARGET="${REPO_ROOT}/infrastructure/scripts/restore-target"
SRC_ROLLBACK="${REPO_ROOT}/infrastructure/scripts/rollback"
SRC_CLEANUP="${REPO_ROOT}/infrastructure/scripts/cleanup"
SRC_BACKUP="${REPO_ROOT}/infrastructure/scripts/backup"
SRC_RESTORE_TEST="${REPO_ROOT}/infrastructure/scripts/restore-test"
SRC_OFFSITE_BACKUP="${REPO_ROOT}/infrastructure/scripts/offsite-backup"
SRC_OFFSITE_RETENTION="${REPO_ROOT}/infrastructure/scripts/offsite-retention"
SRC_OFFSITE_RESTORE_TEST="${REPO_ROOT}/infrastructure/scripts/offsite-restore-test"
SRC_BACKUP_CYCLE="${REPO_ROOT}/infrastructure/scripts/backup-cycle"
SRC_VERIFY_REQUIRED_CLIS="${REPO_ROOT}/infrastructure/scripts/verify-required-clis"

# Gates RATEGURU_PERIMETER_ROOT and RATEGURU_VISUDO_BIN below — the identical
# plain condition every operational script's own top-of-file COMMON_FILE
# override uses. A stray environment variable surviving in a real root shell
# can never silently redirect this installer's destinations or its visudo
# binary without the explicit opt-in flag.
overrides_allowed() {
    [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]]
}

PERIMETER_ROOT=""
if overrides_allowed && [[ -n "${RATEGURU_PERIMETER_ROOT:-}" ]]; then
    PERIMETER_ROOT="${RATEGURU_PERIMETER_ROOT}"
fi

DST_WRAPPER_DEPLOY="${PERIMETER_ROOT}/usr/local/sbin/rateguru-deploy"
DST_WRAPPER_ROLLBACK="${PERIMETER_ROOT}/usr/local/sbin/rateguru-rollback"
DST_WRAPPER_CLEANUP="${PERIMETER_ROOT}/usr/local/sbin/rateguru-cleanup"
DST_WRAPPER_RESTORE="${PERIMETER_ROOT}/usr/local/sbin/rateguru-restore"
DST_SUDOERS="${PERIMETER_ROOT}/etc/sudoers.d/rateguru-deploy"
DST_CRON="${PERIMETER_ROOT}/etc/cron.d/rateguru-backups"

DST_SBIN_DIR="${PERIMETER_ROOT}/usr/local/sbin"
DST_SUDOERS_DIR="${PERIMETER_ROOT}/etc/sudoers.d"
DST_CRON_DIR="${PERIMETER_ROOT}/etc/cron.d"

# The six legacy, per-environment sudo wrappers this installer requires
# absent on the host — see the file header. Named here, once, so every
# check/apply/verify code path below iterates the identical list rather than
# re-enumerating it.
LEGACY_WRAPPER_NAMES=(
    rateguru-staging-deploy
    rateguru-staging-rollback
    rateguru-staging-cleanup
    rateguru-production-deploy
    rateguru-production-rollback
    rateguru-production-cleanup
)

legacy_wrapper_path() {
    printf '%s/%s\n' "${DST_SBIN_DIR}" "$1"
}

BACKUP_ROOT="${PERIMETER_ROOT}/var/backups/rateguru-target-perimeter"

# A second, independently gated test seam — never conflated with
# PERIMETER_ROOT above, which prefixes destinations this installer actually
# owns and installs. INSTALLED_OPERATIONS_ROOT instead prefixes the
# seventeen-file operations bundle install-target-operations owns: a
# read-only dependency this installer only ever verifies, never installs or
# modifies. Empty by default, so production resolves to the exact real
# absolute /home/www/rateguru paths below.
INSTALLED_OPERATIONS_ROOT=""
if overrides_allowed && [[ -n "${RATEGURU_INSTALLED_OPERATIONS_ROOT:-}" ]]; then
    INSTALLED_OPERATIONS_ROOT="${RATEGURU_INSTALLED_OPERATIONS_ROOT}"
fi

DST_OPS_REGISTRY="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/config/deployment-targets.json"
DST_OPS_TARGETS="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/targets"
DST_OPS_COMMON="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/common"
DST_OPS_HEALTH_CHECK="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/health-check"
DST_OPS_STATUS="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/status"
DST_OPS_CLEANUP="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/cleanup"
DST_OPS_DEPLOY="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/deploy"
DST_OPS_ROLLBACK="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/rollback"
DST_OPS_BACKUP="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/backup"
DST_OPS_RESTORE_TEST="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/restore-test"
DST_OPS_OFFSITE_BACKUP="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/offsite-backup"
DST_OPS_OFFSITE_RETENTION="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/offsite-retention"
DST_OPS_OFFSITE_RESTORE_TEST="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/offsite-restore-test"
DST_OPS_BACKUP_CYCLE="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/backup-cycle"
DST_OPS_VERIFY_REQUIRED_CLIS="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/verify-required-clis"
# The one restore primitive this perimeter now depends on: rateguru-restore is
# useless without it, so a host where the operations bundle predates it must
# not be told its restore perimeter is installed and working.
DST_OPS_RESTORE_TARGET="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/bin/restore-target"
DST_OPS_DEPLOYMENT_CONF="${INSTALLED_OPERATIONS_ROOT}/home/www/rateguru/config/deployment.conf"

VISUDO_BIN_DEFAULT="$(command -v visudo || true)"
VISUDO_BIN="${VISUDO_BIN_DEFAULT}"
if overrides_allowed && [[ -n "${RATEGURU_VISUDO_BIN:-}" ]]; then
    VISUDO_BIN="${RATEGURU_VISUDO_BIN}"
fi

# A syntactically valid, deliberately fictional restore operation ID for the
# read-only rateguru-restore probe below. It is never looked up: the probe
# targets tits-guru, which is rejected as lifecycle=planned before the wrapper
# execs anything.
WRAPPER_PROBE_OPERATION_ID="19700101-000000-000000"

WRAPPER_MODE="0755"
SUDOERS_MODE="0440"
CRON_MODE="0644"

# The exact modes install-target-operations itself enforces for the same
# seventeen files (see its own REGISTRY_MODE/COMMON_MODE/CLI_MODE/
# DEPLOYMENT_CONF_MODE) — kept as separate OPS_-prefixed constants here,
# never reused from WRAPPER_MODE/etc above, since these describe a
# dependency this installer only reads, not one it owns.
OPS_REGISTRY_MODE="0640"
OPS_COMMON_MODE="0644"
OPS_CLI_MODE="0755"
OPS_DEPLOYMENT_CONF_MODE="0640"

# The ownership this installer enforces on every file and directory it cares
# about. Plain, freely reassignable constants (not gated env overrides) — the
# same technique infrastructure/scripts/install-target-operations already
# established for its own INSTALL_OWNER/INSTALL_OWNER_ID/INSTALL_GROUP/
# INSTALL_GROUP_ID: tests source this file, reassign these to the test
# process's own uid/gid alongside PERIMETER_ROOT, and exercise the full
# transactional apply/rollback core without needing real root.
INSTALL_OWNER="root"
INSTALL_GROUP="root"
INSTALL_OWNER_ID=0
INSTALL_GROUP_ID=0

REQUIRED_TOOLS=(bash jq install stat cmp diff mv cp mktemp readlink grep)

# --- Logging --------------------------------------------------------------

log() {
    printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"
}

fail() {
    printf '[%s] ERROR: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >&2
    exit 1
}

# --- Argument parsing -------------------------------------------------------

MODE=""
MODE_SEEN=false

usage() {
    cat <<'USAGE'
Usage:
  install-target-perimeter --check
  install-target-perimeter --apply
  install-target-perimeter --verify
  install-target-perimeter --help

  --check   Validate committed source files, host tooling, and that the
            installed seventeen-file target operations bundle is current.
            Read-only; makes no changes.
  --apply   Install the four wrappers, the sudoers rule and the cron
            entry (requires root). Transactional: verifies a staged copy
            first, then the installed result, before committing.
  --verify  Verify the currently installed files and runtime behaviour
            (requires root). Makes no changes.
USAGE
}

parse_mode_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check|--apply|--verify)
                if [[ "${MODE_SEEN}" == true ]]; then
                    usage >&2
                    fail "only one mode may be given (already have --${MODE})"
                fi
                MODE="${1#--}"
                MODE_SEEN=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                usage >&2
                fail "unknown argument: $1"
                ;;
        esac
    done

    [[ "${MODE_SEEN}" == true ]] || { usage >&2; fail "exactly one of --check, --apply or --verify is required"; }
}

# --- Shared helpers ---------------------------------------------------------

require_root() {
    [[ "${EUID}" -eq 0 ]] || fail "this command must be executed as root"
}

check_required_tools() {
    local tool
    for tool in "${REQUIRED_TOOLS[@]}"; do
        command -v "${tool}" >/dev/null 2>&1 || fail "required tool not found: ${tool}"
    done

    [[ -n "${VISUDO_BIN}" ]] || fail "visudo is not available on PATH"
    [[ -x "${VISUDO_BIN}" ]] || fail "visudo is not executable: ${VISUDO_BIN}"

    log "required host tools present: ${REQUIRED_TOOLS[*]} visudo(${VISUDO_BIN})"
}

# --- Source validation (side-effect free; used by --check and apply preflight)

validate_source_files() {
    local path
    for path in "${SRC_WRAPPER_DEPLOY}" "${SRC_WRAPPER_ROLLBACK}" "${SRC_WRAPPER_CLEANUP}" "${SRC_WRAPPER_RESTORE}" "${SRC_SUDOERS}" "${SRC_CRON}"; do
        [[ -e "${path}" ]] || fail "missing required source file: ${path}"
        [[ ! -L "${path}" ]] || fail "source file must not be a symlink: ${path}"
        [[ -f "${path}" ]] || fail "source file must be a regular file: ${path}"
        [[ -r "${path}" ]] || fail "source file is not readable: ${path}"
    done
    log "all six source files are present regular files"
}

validate_source_executable_modes() {
    local path
    for path in "${SRC_SELF}" "${SRC_WRAPPER_DEPLOY}" "${SRC_WRAPPER_ROLLBACK}" "${SRC_WRAPPER_CLEANUP}" "${SRC_WRAPPER_RESTORE}"; do
        [[ -x "${path}" ]] || fail "required source CLI is not executable: ${path}"
    done
    log "install-target-perimeter, rateguru-deploy, rateguru-rollback, rateguru-cleanup and rateguru-restore are all executable"
}

validate_source_syntax() {
    local path
    for path in "${SRC_WRAPPER_DEPLOY}" "${SRC_WRAPPER_ROLLBACK}" "${SRC_WRAPPER_CLEANUP}" "${SRC_WRAPPER_RESTORE}"; do
        bash -n "${path}" || fail "bash -n failed for source file: ${path}"
    done
    log "bash -n passed for all four wrapper scripts"
}

# Best-effort: only runs when shellcheck happens to be on this host's PATH.
# Never required — a host without it must not be blocked from checking or
# installing the perimeter.
validate_source_shellcheck() {
    if ! command -v shellcheck >/dev/null 2>&1; then
        log "shellcheck not available on PATH; skipping"
        return 0
    fi

    local path
    for path in "${SRC_WRAPPER_DEPLOY}" "${SRC_WRAPPER_ROLLBACK}" "${SRC_WRAPPER_CLEANUP}" "${SRC_WRAPPER_RESTORE}"; do
        shellcheck "${path}" || fail "shellcheck failed for source file: ${path}"
    done
    log "shellcheck passed for all four wrapper scripts"
}

# Confirms the six operational scripts this perimeter ultimately drives still
# declare --target support in their own committed source — a static,
# read-only proof that requires no execution and no root, safe for --check.
validate_target_support() {
    local entry path label
    for entry in \
        "${SRC_DEPLOY}:deploy" \
        "${SRC_ROLLBACK}:rollback" \
        "${SRC_CLEANUP}:cleanup" \
        "${SRC_BACKUP_CYCLE}:backup-cycle" \
        "${SRC_RESTORE_TEST}:restore-test" \
        "${SRC_OFFSITE_RESTORE_TEST}:offsite-restore-test" \
        "${SRC_RESTORE_TARGET}:restore-target"
    do
        path="${entry%%:*}"
        label="${entry#*:}"
        [[ -f "${path}" ]] || fail "referenced operational script is missing: ${path}"
        grep -q -- '--target' "${path}" \
            || fail "${label} does not appear to declare --target support: ${path}"
    done
    log "deploy, rollback, cleanup, backup-cycle, restore-test, offsite-restore-test and restore-target all declare --target support"
}

# --- Wrapper static contract (shared by source, staged, and installed) ------
#
# One shared check, used identically for source files (--check), staged
# candidates (--apply's own preflight, before a backup directory or any
# destination file is ever touched), and installed files (--apply's
# post-install verification and --verify) — so a defect in this check itself
# is caught at the earliest possible point, never only after destination
# files have already changed.
verify_wrapper_static_contract() {
    local wrapper_path="$1" underlying_path="$2" label="$3"

    grep -Fq "${underlying_path}" "${wrapper_path}" \
        || fail "${label} does not reference the generic installed operation path ${underlying_path}: ${wrapper_path}"

    # The legacy selector no longer exists for this wrapper at all — not even
    # as a rejection branch. An unrecognized --environment now falls through
    # to the wrapper's own generic unknown-argument path.
    if grep -Fq -- '--environment' "${wrapper_path}"; then
        fail "${label} still mentions --environment: ${wrapper_path}"
    fi

    # Comment-only lines (and blank lines) are excluded before scanning for
    # eval/bash -c: a documentation comment that merely *mentions* either —
    # e.g. "no eval, no bash -c, no string-built command" — must never be
    # mistaken for the real thing (the real bug this function fixes: that
    # exact phrase, in a comment, previously tripped the naive whole-file
    # grep below). Only a line containing actual, executable shell code is
    # ever flagged; a line is comment-only when, after leading whitespace,
    # it starts with "#".
    local executable_lines
    executable_lines="$(grep -Ev '^[[:space:]]*(#|$)' "${wrapper_path}")"

    if grep -Eq '(^|[^a-zA-Z_])eval[[:space:]]' <<<"${executable_lines}"; then
        fail "${label} contains an executable eval: ${wrapper_path}"
    fi

    if grep -Fq -- 'bash -c' <<<"${executable_lines}"; then
        fail "${label} contains an executable bash -c: ${wrapper_path}"
    fi
}

validate_source_registry() {
    jq empty "${SRC_REGISTRY}" 2>/dev/null || fail "source registry is not valid JSON: ${SRC_REGISTRY}"

    "${SRC_TARGETS}" validate --file "${SRC_REGISTRY}" >/dev/null \
        || fail "source targets CLI could not validate the committed registry"

    local listing
    listing="$("${SRC_TARGETS}" list --file "${SRC_REGISTRY}")" \
        || fail "source targets CLI could not list the committed registry"

    grep -Fxq "$(printf 'staging-main\tactive\tstaging')" <<<"${listing}" \
        || fail "source registry does not list staging-main as active/staging"
    grep -Fxq "$(printf 'tits-guru\tplanned\tproduction')" <<<"${listing}" \
        || fail "source registry does not list tits-guru as planned/production"

    log "source registry is valid JSON, passes its own validator, and lists the expected targets"
}

# --- Installed operations bundle staleness guard ----------------------------
#
# install-target-perimeter depends on install-target-operations having
# already installed a fully current seventeen-file bundle at
# /home/www/rateguru — this installer never installs, modifies, or takes
# ownership of any of those seventeen files itself (see the file header).
# Before this installer ever creates a staging directory, a backup
# directory, or touches a single destination file, it confirms that bundle
# is not missing, incomplete, drifted, or otherwise stale relative to this
# repository's own committed sources: installing the perimeter (wrappers
# that exec into these binaries) on top of a stale bundle — e.g. an
# installed backup-cycle that predates --target support and would answer
# "Unknown argument: --target" — would silently wire the new perimeter to
# broken operational scripts. Every failure here uses the identical, clearly
# actionable message so an operator knows exactly what to run first.

check_installed_operation_file() {
    local dst="$1" src="$2" mode="$3" label="$4"
    local guidance="installed target operations are stale or incomplete; run install-target-operations --apply first"

    if [[ ! -e "${dst}" ]]; then
        fail "${guidance} (${label} is missing: ${dst})"
    fi

    if [[ -L "${dst}" ]]; then
        fail "${guidance} (${label} must not be a symlink: ${dst})"
    fi

    if [[ ! -f "${dst}" ]]; then
        fail "${guidance} (${label} must be a regular file: ${dst})"
    fi

    local actual_owner
    actual_owner="$(stat -c '%u:%g' "${dst}" 2>/dev/null)" \
        || fail "${guidance} (could not stat ${label}: ${dst})"
    [[ "${actual_owner}" == "${INSTALL_OWNER_ID}:${INSTALL_GROUP_ID}" ]] \
        || fail "${guidance} (${label} has wrong ownership: ${dst} is ${actual_owner}, expected ${INSTALL_OWNER_ID}:${INSTALL_GROUP_ID})"

    local actual_mode
    actual_mode="$(stat -c '%a' "${dst}" 2>/dev/null)" \
        || fail "${guidance} (could not stat mode of ${label}: ${dst})"
    (( 8#${actual_mode} == 8#${mode} )) \
        || fail "${guidance} (${label} has wrong mode: ${dst} is ${actual_mode}, expected ${mode})"

    cmp -s "${src}" "${dst}" \
        || fail "${guidance} (${label} content differs from its committed source: ${dst})"
}

validate_installed_operations_bundle() {
    check_installed_operation_file "${DST_OPS_REGISTRY}" "${SRC_REGISTRY}" "${OPS_REGISTRY_MODE}" "registry"
    check_installed_operation_file "${DST_OPS_TARGETS}" "${SRC_TARGETS}" "${OPS_CLI_MODE}" "targets"
    check_installed_operation_file "${DST_OPS_COMMON}" "${SRC_COMMON}" "${OPS_COMMON_MODE}" "common"
    check_installed_operation_file "${DST_OPS_HEALTH_CHECK}" "${SRC_HEALTH_CHECK}" "${OPS_CLI_MODE}" "health-check"
    check_installed_operation_file "${DST_OPS_STATUS}" "${SRC_STATUS}" "${OPS_CLI_MODE}" "status"
    check_installed_operation_file "${DST_OPS_CLEANUP}" "${SRC_CLEANUP}" "${OPS_CLI_MODE}" "cleanup"
    check_installed_operation_file "${DST_OPS_DEPLOY}" "${SRC_DEPLOY}" "${OPS_CLI_MODE}" "deploy"
    check_installed_operation_file "${DST_OPS_ROLLBACK}" "${SRC_ROLLBACK}" "${OPS_CLI_MODE}" "rollback"
    check_installed_operation_file "${DST_OPS_BACKUP}" "${SRC_BACKUP}" "${OPS_CLI_MODE}" "backup"
    check_installed_operation_file "${DST_OPS_RESTORE_TEST}" "${SRC_RESTORE_TEST}" "${OPS_CLI_MODE}" "restore-test"
    check_installed_operation_file "${DST_OPS_OFFSITE_BACKUP}" "${SRC_OFFSITE_BACKUP}" "${OPS_CLI_MODE}" "offsite-backup"
    check_installed_operation_file "${DST_OPS_OFFSITE_RETENTION}" "${SRC_OFFSITE_RETENTION}" "${OPS_CLI_MODE}" "offsite-retention"
    check_installed_operation_file "${DST_OPS_OFFSITE_RESTORE_TEST}" "${SRC_OFFSITE_RESTORE_TEST}" "${OPS_CLI_MODE}" "offsite-restore-test"
    check_installed_operation_file "${DST_OPS_BACKUP_CYCLE}" "${SRC_BACKUP_CYCLE}" "${OPS_CLI_MODE}" "backup-cycle"
    check_installed_operation_file "${DST_OPS_VERIFY_REQUIRED_CLIS}" "${SRC_VERIFY_REQUIRED_CLIS}" "${OPS_CLI_MODE}" "verify-required-clis"
    check_installed_operation_file "${DST_OPS_DEPLOYMENT_CONF}" "${SRC_DEPLOYMENT_CONF}" "${OPS_DEPLOYMENT_CONF_MODE}" "deployment.conf"
    check_installed_operation_file "${DST_OPS_RESTORE_TARGET}" "${SRC_RESTORE_TARGET}" "${OPS_CLI_MODE}" "restore-target"

    log "installed target operations bundle (seventeen files) matches this repository's committed sources"
}

validate_sudoers_syntax() {
    local path="$1"
    "${VISUDO_BIN}" -cf "${path}" >/dev/null \
        || fail "sudoers file failed visudo -cf: ${path}"
}

# Confirms the sudoers content grants the staging deploy user access to the
# four generic wrappers only — the one thing this installer must never do
# is grant tits-guru's own (unprovisioned) deploy user any access at all,
# since tits-guru stays lifecycle=planned, or mention any of the six legacy
# per-environment wrapper names it is responsible for removing.
validate_sudoers_content() {
    local path="$1"

    grep -Fq '/usr/local/sbin/rateguru-deploy' "${path}" \
        || fail "sudoers file does not grant access to rateguru-deploy: ${path}"
    grep -Fq '/usr/local/sbin/rateguru-rollback' "${path}" \
        || fail "sudoers file does not grant access to rateguru-rollback: ${path}"
    grep -Fq '/usr/local/sbin/rateguru-cleanup' "${path}" \
        || fail "sudoers file does not grant access to rateguru-cleanup: ${path}"
    grep -Fq '/usr/local/sbin/rateguru-restore' "${path}" \
        || fail "sudoers file does not grant access to rateguru-restore: ${path}"

    # The restricted credential gets the restore WRAPPER and never the binary
    # behind it: a grant naming restore-target directly (or any /home/www path)
    # would let the deploy account call it with arbitrary arguments, bypassing
    # every closed-class check the wrapper exists to apply.
    if grep -Fq '/home/www/rateguru/bin/' "${path}"; then
        fail "sudoers file grants a path under /home/www/rateguru/bin directly — operational binaries are reachable only through /usr/local/sbin wrappers: ${path}"
    fi

    grep -Fq 'deploy-rateguru-staging' "${path}" \
        || fail "sudoers file does not grant the staging deploy user access: ${path}"

    if grep -Fq 'deploy-rateguru-tits-guru' "${path}"; then
        fail "sudoers file must not grant tits-guru's deploy user any access — tits-guru remains lifecycle=planned: ${path}"
    fi

    # No production deploy user of any kind (planned tits-guru above, or any
    # other production-class identity) may appear — the sudoers rule grants
    # only the staging deploy user access to the four generic wrappers.
    if grep -Fq 'deploy-rateguru-production' "${path}"; then
        fail "sudoers file must not grant a production deploy user any access: ${path}"
    fi

    local legacy_name
    for legacy_name in "${LEGACY_WRAPPER_NAMES[@]}"; do
        if grep -Fq "${legacy_name}" "${path}"; then
            fail "sudoers file still mentions the legacy wrapper ${legacy_name}: ${path}"
        fi
    done
}

# Shared by --check (against the committed source) and --verify (against the
# installed file): exactly three operational lines, all target-aware, none
# legacy, with the nightly cycle's schedule and every log path unchanged from
# before this slice.
validate_cron_format() {
    local path="$1"

    # Exclusion-based, not inclusion-based: rather than enumerating every
    # valid cron schedule syntax (digits, "*", lists like "0,30", step values
    # like "*/15", and "@"-shortcuts like "@daily") in a character class that
    # would always be one syntax form behind, an operational line is simply
    # any non-blank line that is neither a comment (starts with "#") nor an
    # environment-variable assignment (SHELL=..., PATH=..., MAILTO=...).
    # This must never silently undercount a schedule using any syntax this
    # installer's own author didn't anticipate.
    local operational_lines
    operational_lines="$(grep -Ev '^[[:space:]]*(#|$)|^[A-Za-z_][A-Za-z0-9_]*=' "${path}" || true)"

    local line_count
    line_count="$(grep -c . <<<"${operational_lines}" || true)"
    [[ "${line_count}" -eq 3 ]] \
        || fail "expected exactly three operational cron lines in ${path}, found ${line_count}"

    local line
    while IFS= read -r line; do
        [[ -n "${line}" ]] || continue

        [[ "${line}" == *'--target staging-main'* ]] \
            || fail "cron line does not use --target staging-main: ${line}"

        [[ "${line}" != *'--environment'* ]] \
            || fail "cron line still references --environment: ${line}"
    done <<<"${operational_lines}"

    grep -Fq '30 2 * * * root /home/www/rateguru/bin/backup-cycle --target staging-main >> /var/log/rateguru/staging-backup-cycle.log 2>&1' "${path}" \
        || fail "nightly backup-cycle cron line changed schedule or log path: ${path}"
    grep -Fq '10 4 * * 0 root /home/www/rateguru/bin/restore-test --target staging-main >> /var/log/rateguru/staging-local-restore-test.log 2>&1' "${path}" \
        || fail "weekly local restore-test cron line changed schedule or log path: ${path}"
    grep -Fq '40 4 * * 0 root /home/www/rateguru/bin/offsite-restore-test --target staging-main >> /var/log/rateguru/staging-offsite-restore-test.log 2>&1' "${path}" \
        || fail "weekly offsite restore-test cron line changed schedule or log path: ${path}"
}

run_source_validation() {
    validate_source_files
    validate_source_executable_modes
    validate_source_syntax
    validate_source_shellcheck
    validate_target_support
    validate_source_registry
    validate_sudoers_syntax "${SRC_SUDOERS}"
    validate_sudoers_content "${SRC_SUDOERS}"
    validate_cron_format "${SRC_CRON}"
    check_required_tools

    verify_wrapper_static_contract "${SRC_WRAPPER_DEPLOY}" "/home/www/rateguru/bin/deploy" "source rateguru-deploy"
    verify_wrapper_static_contract "${SRC_WRAPPER_ROLLBACK}" "/home/www/rateguru/bin/rollback" "source rateguru-rollback"
    verify_wrapper_static_contract "${SRC_WRAPPER_CLEANUP}" "/home/www/rateguru/bin/cleanup" "source rateguru-cleanup"
    verify_wrapper_static_contract "${SRC_WRAPPER_RESTORE}" "/home/www/rateguru/bin/restore-target" "source rateguru-restore"
    log "source wrappers reference generic installed operation paths, never mention --environment, and contain no executable eval/bash -c"

    # Shared by --check, --apply's own preflight, and --verify (this
    # function's only three callers) — runs last, after every other
    # repository-only check has already passed, and always before a staging
    # directory, backup directory, or destination file is ever touched.
    validate_installed_operations_bundle
}

# --- Safe wrapper probes (never a real deploy/rollback/cleanup) -------------
#
# Always points the probed wrapper at this repository's own committed
# common/registry — never at whatever may or may not already be installed at
# /home/www/rateguru — so these probes are self-contained and never depend on
# install-target-operations having run first. -u SUDO_USER strips any
# SUDO_USER this installer's own process inherited (e.g. from `sudo
# infrastructure/scripts/install-target-perimeter --apply` itself) before the
# probe runs, so the wrapper's own caller-identity check always sees a direct
# root invocation — exactly the "genuinely safe, never a real mutating call"
# probe mode the wrapper's own --help intentionally bypasses (see
# infrastructure/config/wrappers/rateguru-deploy).
wrapper_probe_env() {
    env \
        -u SUDO_USER \
        RATEGURU_ALLOW_TEST_OVERRIDES=true \
        RATEGURU_COMMON_FILE="${SRC_COMMON}" \
        RATEGURU_DEPLOYMENT_CONF_FILE="${SRC_DEPLOYMENT_CONF}" \
        RATEGURU_TARGET_REGISTRY_FILE="${SRC_REGISTRY}" \
        RATEGURU_TARGETS_CLI="${SRC_TARGETS}" \
        "$@"
}

verify_wrapper_help() {
    local wrapper_path="$1" label="$2"
    wrapper_probe_env bash "${wrapper_path}" --help >/dev/null \
        || fail "${label} --help failed"
    log "${label} --help: OK"
}

# A deliberately safe probe: no --help (which would bypass the lifecycle
# check entirely — see the wrapper's own parse_wrapper_args), and no
# operation-specific arguments at all. Proves the wrapper's own ordering is
# root authorization -> caller authorization -> lifecycle=planned rejection
# -> underlying operation never reached.
# Trailing arguments exist for rateguru-restore alone: unlike the other three
# wrappers, its parser is a closed whitelist that requires a mode before it will
# accept anything, so `--target tits-guru` on its own would be rejected by
# argument parsing rather than by the lifecycle check this probe is about. The
# mode passed is always the READ-ONLY --inspect, with a syntactically valid but
# entirely fictional operation ID: the point is that require_active_target
# refuses tits-guru before restore-target is ever reached, so the operation is
# never looked for and nothing is read, written or restored.
verify_wrapper_planned_target_rejected() {
    local wrapper_path="$1" label="$2"
    shift 2
    local output
    if output="$(wrapper_probe_env bash "${wrapper_path}" --target tits-guru "$@" 2>&1)"; then
        fail "${label} --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${output}" \
        || fail "${label} --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${output}"
    log "${label} --target tits-guru: correctly rejected (lifecycle=planned)"
}

# --- Transactional install/rollback core -------------------------------
#
# Parameterized on source/destination/owner/group/mode, exactly mirroring
# infrastructure/scripts/install-target-operations's own extractable core —
# see tests/Feature/Architecture/InstallTargetPerimeterTest.php.

# --- installer core (begin) ---

BACKUP_DIR=""
ROLLBACK_RESTORE=()
ROLLBACK_REMOVE=()

files_differ() {
    local src="$1" dst="$2"
    [[ -f "${dst}" ]] || return 0
    ! cmp -s "${src}" "${dst}"
}

record_target() {
    local dst="$1"
    if [[ -e "${dst}" || -L "${dst}" ]]; then
        local backup_path="${BACKUP_DIR}${dst}"
        install -d -m 0700 "$(dirname "${backup_path}")"
        cp -a "${dst}" "${backup_path}"
        ROLLBACK_RESTORE+=("${dst}")
    else
        ROLLBACK_REMOVE+=("${dst}")
    fi
}

reject_unsafe_existing_destination() {
    local dst="$1"

    if [[ -L "${dst}" ]]; then
        fail "refusing to install over an existing symlink: ${dst}"
    fi

    if [[ -e "${dst}" ]] && [[ ! -f "${dst}" ]]; then
        fail "refusing to install over an existing non-regular-file destination: ${dst}"
    fi
}

install_regular_file_transactional() {
    local src="$1" dst="$2" owner="$3" group="$4" mode="$5"

    reject_unsafe_existing_destination "${dst}"
    record_target "${dst}"

    local tmp
    tmp="$(mktemp "${dst}.XXXXXX")"

    if ! install -o "${owner}" -g "${group}" -m "${mode}" "${src}" "${tmp}"; then
        rm -f "${tmp}"
        fail "failed to stage ${dst} for install (writing the temporary file failed)"
    fi

    if ! mv -f "${tmp}" "${dst}"; then
        rm -f "${tmp}"
        fail "failed to rename the staged file into place: ${dst}"
    fi
}

verify_installed_regular_file() {
    local dst="$1" owner_id="$2" group_id="$3" mode="$4" src="$5"

    [[ -e "${dst}" ]] || fail "expected installed file is missing: ${dst}"
    [[ ! -L "${dst}" ]] || fail "installed file must not be a symlink: ${dst}"
    [[ -f "${dst}" ]] || fail "installed file must be a regular file: ${dst}"

    local actual_owner
    actual_owner="$(stat -c '%u:%g' "${dst}")"
    [[ "${actual_owner}" == "${owner_id}:${group_id}" ]] \
        || fail "installed file has wrong ownership: ${dst} is ${actual_owner}, expected ${owner_id}:${group_id}"

    local actual_mode
    actual_mode="$(stat -c '%a' "${dst}")"
    (( 8#${actual_mode} == 8#${mode} )) \
        || fail "installed file has wrong mode: ${dst} is ${actual_mode}, expected ${mode}"

    if (( (8#${actual_mode} & 8#022) != 0 )); then
        fail "installed file must not be group- or other-writable: ${dst} (mode ${actual_mode})"
    fi

    cmp -s "${src}" "${dst}" \
        || fail "installed file content differs from its committed source: ${dst}"
}

rollback_installed_files() {
    local status=0 dst backup_path

    for dst in "${ROLLBACK_REMOVE[@]:-}"; do
        [[ -n "${dst}" ]] || continue
        rm -f "${dst}" || { log "ERROR: could not remove ${dst} during rollback"; status=1; }
    done

    for dst in "${ROLLBACK_RESTORE[@]:-}"; do
        [[ -n "${dst}" ]] || continue
        backup_path="${BACKUP_DIR}${dst}"
        if [[ -e "${backup_path}" || -L "${backup_path}" ]]; then
            rm -f "${dst}"
            cp -a "${backup_path}" "${dst}" \
                || { log "ERROR: could not restore ${dst} from ${backup_path}"; status=1; }
        else
            log "ERROR: no backup found for ${dst}; it was left as installed"
            status=1
        fi
    done

    return "${status}"
}

# --- installer core (end) ---

# --- Legacy wrapper removal (transactional; reuses the installer core above)
#
# A legacy wrapper path must be either absent, a symlink (rm -f unlinks it
# regardless of what it points to), or a regular file — never a directory or
# other special type. `rm -f` without `-r` cannot remove a directory, and
# fails silently enough (unguarded, but inside remove_legacy_wrappers rather
# than a tested context) that a later rollback would then try to cp -a its
# backed-up copy *into* the still-existing directory rather than replacing
# it, succeeding at a nested, non-transactional "restore" instead of failing
# closed. Rejecting the unsafe type up front, before it is ever backed up or
# touched, keeps this the same fail-closed contract
# reject_unsafe_existing_destination already gives the install side.
reject_unsafe_legacy_wrapper_path() {
    local path="$1"

    if [[ -e "${path}" ]] && [[ ! -f "${path}" ]] && [[ ! -L "${path}" ]]; then
        fail "refusing to remove a legacy wrapper path that is not a regular file or symlink: ${path}"
    fi
}

# Backs up (via record_target — the identical helper every install_regular_
# file_transactional call above already uses) and removes each of the six
# legacy wrapper paths that currently exists. A path already absent before
# this run is recorded into ROLLBACK_REMOVE by record_target; on a rollback,
# rollback_installed_files runs a harmless `rm -f` against it — a legacy
# wrapper that was never there stays absent after a rollback, exactly as the
# file header promises.
remove_legacy_wrappers() {
    local name path
    for name in "${LEGACY_WRAPPER_NAMES[@]}"; do
        path="$(legacy_wrapper_path "${name}")"
        reject_unsafe_legacy_wrapper_path "${path}"
        record_target "${path}"

        if [[ -e "${path}" || -L "${path}" ]]; then
            rm -f "${path}"
            log "removed legacy wrapper: ${path}"
        fi
    done
}

# --- Runtime verification helpers (extractable) -----------------------------

# --- runtime verification (begin) ---

validate_destination_directory() {
    local dir="$1"

    [[ -e "${dir}" ]] || fail "destination directory is missing: ${dir} (this installer never creates it)"
    [[ ! -L "${dir}" ]] || fail "destination directory must not be a symlink: ${dir}"
    [[ -d "${dir}" ]] || fail "destination path must be a directory: ${dir}"

    local owner
    owner="$(stat -c '%u:%g' "${dir}")"
    [[ "${owner}" == "${INSTALL_OWNER_ID}:${INSTALL_GROUP_ID}" ]] \
        || fail "destination directory must be owned by ${INSTALL_OWNER}:${INSTALL_GROUP}, is ${owner}: ${dir}"

    local mode
    mode="$(stat -c '%a' "${dir}")"
    if (( (8#${mode} & 8#022) != 0 )); then
        fail "destination directory must not be group- or other-writable (mode ${mode}): ${dir}"
    fi

    [[ -w "${dir}" ]] || fail "destination directory is not writable, cannot install into it: ${dir}"
    [[ -x "${dir}" ]] || fail "destination directory is not searchable (missing execute bit): ${dir}"
}

validate_destination_directories() {
    validate_destination_directory "${DST_SBIN_DIR}"
    validate_destination_directory "${DST_SUDOERS_DIR}"
    validate_destination_directory "${DST_CRON_DIR}"
    log "destination directories exist, are ${INSTALL_OWNER}:${INSTALL_GROUP}-owned, non-writable-by-others directories (unchanged by this installer)"
}

verify_installed_files() {
    log "verifying installed files"

    verify_installed_regular_file "${DST_WRAPPER_DEPLOY}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${WRAPPER_MODE}" "${SRC_WRAPPER_DEPLOY}"
    verify_installed_regular_file "${DST_WRAPPER_ROLLBACK}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${WRAPPER_MODE}" "${SRC_WRAPPER_ROLLBACK}"
    verify_installed_regular_file "${DST_WRAPPER_CLEANUP}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${WRAPPER_MODE}" "${SRC_WRAPPER_CLEANUP}"
    verify_installed_regular_file "${DST_WRAPPER_RESTORE}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${WRAPPER_MODE}" "${SRC_WRAPPER_RESTORE}"
    verify_installed_regular_file "${DST_SUDOERS}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${SUDOERS_MODE}" "${SRC_SUDOERS}"
    verify_installed_regular_file "${DST_CRON}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CRON_MODE}" "${SRC_CRON}"
    log "  ownership, mode and content: OK for all six files"

    local path
    for path in "${DST_WRAPPER_DEPLOY}" "${DST_WRAPPER_ROLLBACK}" "${DST_WRAPPER_CLEANUP}" "${DST_WRAPPER_RESTORE}"; do
        bash -n "${path}" || fail "bash -n failed for installed file: ${path}"
    done
    log "  bash -n: OK for all four installed wrappers"

    verify_wrapper_static_contract "${DST_WRAPPER_DEPLOY}" "/home/www/rateguru/bin/deploy" "installed rateguru-deploy"
    verify_wrapper_static_contract "${DST_WRAPPER_ROLLBACK}" "/home/www/rateguru/bin/rollback" "installed rateguru-rollback"
    verify_wrapper_static_contract "${DST_WRAPPER_CLEANUP}" "/home/www/rateguru/bin/cleanup" "installed rateguru-cleanup"
    verify_wrapper_static_contract "${DST_WRAPPER_RESTORE}" "/home/www/rateguru/bin/restore-target" "installed rateguru-restore"
    log "  installed wrappers reference generic installed operation paths, never mention --environment, and contain no executable eval/bash -c"

    "${VISUDO_BIN}" -cf "${DST_SUDOERS}" >/dev/null \
        || fail "installed sudoers file failed visudo -cf: ${DST_SUDOERS}"
    validate_sudoers_content "${DST_SUDOERS}"
    log "  installed sudoers: visudo -cf OK, content OK"

    validate_cron_format "${DST_CRON}"
    log "  installed cron: format OK (three target-aware lines, schedule and log paths unchanged)"

    verify_legacy_wrappers_absent

    log "installed-file verification passed"
}

verify_runtime_parity() {
    log "verifying runtime parity (safe probes only — never a real deploy/rollback/cleanup/restore)"

    verify_wrapper_help "${DST_WRAPPER_DEPLOY}" "rateguru-deploy"
    verify_wrapper_planned_target_rejected "${DST_WRAPPER_DEPLOY}" "rateguru-deploy"
    verify_wrapper_help "${DST_WRAPPER_ROLLBACK}" "rateguru-rollback"
    verify_wrapper_planned_target_rejected "${DST_WRAPPER_ROLLBACK}" "rateguru-rollback"
    verify_wrapper_help "${DST_WRAPPER_CLEANUP}" "rateguru-cleanup"
    verify_wrapper_planned_target_rejected "${DST_WRAPPER_CLEANUP}" "rateguru-cleanup"
    verify_wrapper_help "${DST_WRAPPER_RESTORE}" "rateguru-restore"
    verify_wrapper_planned_target_rejected "${DST_WRAPPER_RESTORE}" "rateguru-restore" \
        --inspect --operation "${WRAPPER_PROBE_OPERATION_ID}"

    log "runtime parity verification passed"
}

# Fails closed if any of the six legacy per-environment wrapper paths still
# exist on the host — used by --verify (which only ever runs after --apply
# is expected to have already removed them) and by --apply's own post-removal
# check, before APPLY_COMMITTED is ever set.
verify_legacy_wrappers_absent() {
    local name path
    for name in "${LEGACY_WRAPPER_NAMES[@]}"; do
        path="$(legacy_wrapper_path "${name}")"
        if [[ -e "${path}" || -L "${path}" ]]; then
            fail "legacy wrapper still present: ${path}"
        fi
    done
    log "all six legacy wrapper paths are absent"
}

# --- runtime verification (end) ---

# --- Staged pre-install verification (apply mode only) ----------------------

verify_staged_candidates() {
    local stage_dir="$1"
    local staged_deploy="${stage_dir}/rateguru-deploy"
    local staged_rollback="${stage_dir}/rateguru-rollback"
    local staged_cleanup="${stage_dir}/rateguru-cleanup"
    local staged_restore="${stage_dir}/rateguru-restore"
    local staged_sudoers="${stage_dir}/rateguru-deploy.sudoers"
    local staged_cron="${stage_dir}/rateguru-backups.cron"

    log "verifying staged candidates before installation"

    bash -n "${staged_deploy}" || fail "bash -n failed for staged rateguru-deploy"
    bash -n "${staged_rollback}" || fail "bash -n failed for staged rateguru-rollback"
    bash -n "${staged_cleanup}" || fail "bash -n failed for staged rateguru-cleanup"
    bash -n "${staged_restore}" || fail "bash -n failed for staged rateguru-restore"
    log "  staged wrappers: bash -n OK"

    verify_wrapper_static_contract "${staged_deploy}" "/home/www/rateguru/bin/deploy" "staged rateguru-deploy"
    verify_wrapper_static_contract "${staged_rollback}" "/home/www/rateguru/bin/rollback" "staged rateguru-rollback"
    verify_wrapper_static_contract "${staged_cleanup}" "/home/www/rateguru/bin/cleanup" "staged rateguru-cleanup"
    verify_wrapper_static_contract "${staged_restore}" "/home/www/rateguru/bin/restore-target" "staged rateguru-restore"
    log "  staged wrappers reference generic installed operation paths, never mention --environment, and contain no executable eval/bash -c"

    verify_wrapper_help "${staged_deploy}" "staged rateguru-deploy"
    verify_wrapper_planned_target_rejected "${staged_deploy}" "staged rateguru-deploy"
    verify_wrapper_help "${staged_rollback}" "staged rateguru-rollback"
    verify_wrapper_planned_target_rejected "${staged_rollback}" "staged rateguru-rollback"
    verify_wrapper_help "${staged_cleanup}" "staged rateguru-cleanup"
    verify_wrapper_planned_target_rejected "${staged_cleanup}" "staged rateguru-cleanup"
    verify_wrapper_help "${staged_restore}" "staged rateguru-restore"
    verify_wrapper_planned_target_rejected "${staged_restore}" "staged rateguru-restore" \
        --inspect --operation "${WRAPPER_PROBE_OPERATION_ID}"

    "${VISUDO_BIN}" -cf "${staged_sudoers}" >/dev/null \
        || fail "staged sudoers file failed visudo -cf"
    validate_sudoers_content "${staged_sudoers}"
    log "  staged sudoers: visudo -cf OK, content OK"

    validate_cron_format "${staged_cron}"
    log "  staged cron: format OK"

    log "staged candidates verified"
}

# --- Modes ----------------------------------------------------------------

run_check() {
    log "mode: check (read-only)"

    run_source_validation

    log "destinations are fixed constants:"
    log "  ${DST_WRAPPER_DEPLOY}"
    log "  ${DST_WRAPPER_ROLLBACK}"
    log "  ${DST_WRAPPER_CLEANUP}"
    log "  ${DST_WRAPPER_RESTORE}"
    log "  ${DST_SUDOERS}"
    log "  ${DST_CRON}"

    # Read-only report of which legacy wrappers --apply would remove. Neither
    # a present nor an absent legacy wrapper is a --check failure — the
    # filesystem is never touched in this mode. A present path that is not a
    # regular file or symlink is different: --apply's own
    # reject_unsafe_legacy_wrapper_path would refuse to remove it, so
    # reporting it as an ordinary "would be removed" candidate would be
    # actively misleading — flag it as a blocker instead, and fail the
    # check, so this surfaces before a real --apply run hits it.
    local name path unsafe_legacy_wrapper_found=false
    for name in "${LEGACY_WRAPPER_NAMES[@]}"; do
        path="$(legacy_wrapper_path "${name}")"
        if [[ -e "${path}" ]] && [[ ! -f "${path}" ]] && [[ ! -L "${path}" ]]; then
            log "  legacy wrapper BLOCKS --apply, not a regular file or symlink: ${path}"
            unsafe_legacy_wrapper_found=true
        elif [[ -e "${path}" || -L "${path}" ]]; then
            log "  legacy wrapper present, would be removed by --apply: ${path}"
        else
            log "  legacy wrapper already absent: ${path}"
        fi
    done

    if [[ "${unsafe_legacy_wrapper_found}" == true ]]; then
        fail "one or more legacy wrapper paths are not a regular file or symlink; --apply would refuse to remove them — see the BLOCKS lines above"
    fi

    log "check passed: source files, host tooling, target registry, sudoers candidate, cron format, and the installed operations bundle are all valid"
}

APPLY_COMMITTED=false
STAGE_DIR=""
MAIN_BASHPID=""

# set -E means every ERR/EXIT trap armed below is inherited by every $(...)
# command substitution's subshell for as long as it stays armed — see the
# identical MAIN_BASHPID guard in install-target-operations for the full
# rationale (a deliberately-failing probe inside a command substitution must
# never re-trigger this handler a second time from inside that subshell).
on_apply_error() {
    local code=$?
    trap - ERR EXIT

    if [[ "${BASHPID}" != "${MAIN_BASHPID}" ]]; then
        exit "${code}"
    fi

    log "apply failed (exit ${code})"

    if [[ "${APPLY_COMMITTED}" == false ]] && [[ -n "${BACKUP_DIR}" ]]; then
        if rollback_installed_files; then
            log "rollback complete: previous files restored"
        else
            log "ERROR: rollback INCOMPLETE — some files may not have been restored"
            log "backups remain in ${BACKUP_DIR} for manual recovery"
        fi
    fi

    [[ -z "${STAGE_DIR}" ]] || rm -rf "${STAGE_DIR}"

    exit "${code}"
}

run_apply() {
    require_root
    perform_apply
}

perform_apply() {
    BACKUP_DIR=""
    ROLLBACK_RESTORE=()
    ROLLBACK_REMOVE=()
    APPLY_COMMITTED=false

    log "mode: apply"

    run_source_validation
    validate_destination_directories

    MAIN_BASHPID="${BASHPID}"
    trap on_apply_error ERR EXIT

    STAGE_DIR="$(mktemp -d)"
    install -m 0700 "${SRC_WRAPPER_DEPLOY}" "${STAGE_DIR}/rateguru-deploy"
    install -m 0700 "${SRC_WRAPPER_ROLLBACK}" "${STAGE_DIR}/rateguru-rollback"
    install -m 0700 "${SRC_WRAPPER_CLEANUP}" "${STAGE_DIR}/rateguru-cleanup"
    install -m 0700 "${SRC_WRAPPER_RESTORE}" "${STAGE_DIR}/rateguru-restore"
    install -m 0600 "${SRC_SUDOERS}" "${STAGE_DIR}/rateguru-deploy.sudoers"
    install -m 0600 "${SRC_CRON}" "${STAGE_DIR}/rateguru-backups.cron"

    verify_staged_candidates "${STAGE_DIR}"

    BACKUP_DIR="${BACKUP_ROOT}/$(date -u '+%Y%m%dT%H%M%SZ')"
    install -d -m 0700 "${BACKUP_ROOT}"
    install -d -m 0700 "${BACKUP_DIR}"
    log "backups for this run: ${BACKUP_DIR}"

    # Wrappers first, sudoers only after its own visudo pass on the staged
    # copy (already proven above by verify_staged_candidates, re-proven here
    # against the exact bytes about to be installed), cron last.
    install_regular_file_transactional "${STAGE_DIR}/rateguru-deploy" "${DST_WRAPPER_DEPLOY}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${WRAPPER_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/rateguru-rollback" "${DST_WRAPPER_ROLLBACK}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${WRAPPER_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/rateguru-cleanup" "${DST_WRAPPER_CLEANUP}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${WRAPPER_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/rateguru-restore" "${DST_WRAPPER_RESTORE}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${WRAPPER_MODE}"

    "${VISUDO_BIN}" -cf "${STAGE_DIR}/rateguru-deploy.sudoers" >/dev/null \
        || fail "staged sudoers failed visudo -cf immediately before install"
    install_regular_file_transactional "${STAGE_DIR}/rateguru-deploy.sudoers" "${DST_SUDOERS}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${SUDOERS_MODE}"

    install_regular_file_transactional "${STAGE_DIR}/rateguru-backups.cron" "${DST_CRON}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CRON_MODE}"

    remove_legacy_wrappers

    log "files installed; verifying before committing"

    verify_installed_files
    verify_runtime_parity

    APPLY_COMMITTED=true
    trap - ERR EXIT
    rm -rf "${STAGE_DIR}"

    log "apply complete"
    log "  wrappers : ${DST_WRAPPER_DEPLOY}, ${DST_WRAPPER_ROLLBACK}, ${DST_WRAPPER_CLEANUP}, ${DST_WRAPPER_RESTORE}"
    log "  sudoers  : ${DST_SUDOERS}"
    log "  cron     : ${DST_CRON}"
    log "  legacy wrappers removed: ${LEGACY_WRAPPER_NAMES[*]}"
    log "  backups  : ${BACKUP_DIR}"
    log "Run 'install-target-perimeter --verify' at any time to re-check the installed result."
}

on_verify_error() {
    local code=$?
    trap - ERR EXIT

    if [[ "${BASHPID}" != "${MAIN_BASHPID}" ]]; then
        exit "${code}"
    fi

    log "--- final result ---"
    log "FAIL: verification did not pass (see the error above)"
    exit "${code}"
}

run_verify() {
    require_root
    perform_verify
}

perform_verify() {
    log "mode: verify (no changes, no backup)"

    MAIN_BASHPID="${BASHPID}"
    trap on_verify_error ERR EXIT

    log "--- source validation ---"
    run_source_validation

    log "--- installed-file validation ---"
    verify_installed_files

    log "--- runtime parity ---"
    verify_runtime_parity

    trap - ERR EXIT
    log "--- final result ---"
    log "PASS: target-aware perimeter installed and verified"
}

# --- dispatch -----------------------------------------------------------
#
# Everything above this point is constants and function definitions only —
# nothing runs until main is called. Tests source this whole file
# (BASH_SOURCE[0] != $0 in that case, so main never auto-runs), reassign
# PERIMETER_ROOT/INSTALL_OWNER*/INSTALL_GROUP* to scratch-safe values, and
# call run_check/perform_apply/perform_verify directly — bypassing
# require_root, the same technique infrastructure/scripts/deploy and
# infrastructure/scripts/backup-cycle already establish for themselves.
main() {
    parse_mode_args "$@"

    case "${MODE}" in
        check)
            run_check
            ;;
        apply)
            run_apply
            ;;
        verify)
            run_verify
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
