#!/usr/bin/env bash
#
# install-target-operations — install/verify the target-only operational
# tooling.
#
# Modes:
#   --check   Validate the committed source files and host tooling only.
#             Read-only: makes NO changes to the system, requires no root.
#   --apply   Install the target registry, the twenty operational scripts
#             (targets, common, restore-common, health-check, status,
#             cleanup, deploy, rollback, backup, restore-test,
#             offsite-backup, offsite-retention, offsite-restore-test,
#             backup-cycle, fetch-backup, verify-backup, restore-database,
#             restore-storage, restore-target, verify-required-clis) and the
#             host-global deployment.conf, verify a staged copy before
#             touching anything, install transactionally, then verify the
#             installed result against the real host before committing.
#   --verify  Re-run the installed-file and runtime-parity checks against
#             whatever is currently installed. Makes NO changes, creates NO
#             backup.
#
# What this installs — and does not:
#   * Twenty-two files: the registry, the twenty scripts — targets, common
#     and restore-common (sourced libraries), health-check and status
#     (read-only), cleanup, deploy, rollback, backup, restore-test,
#     offsite-backup, offsite-retention, offsite-restore-test, backup-cycle,
#     The Restore Target Data restore primitives (fetch-backup, verify-backup,
#     restore-database, restore-storage, restore-target) and
#     verify-required-clis — and deployment.conf, the host-global
#     (non-target-specific) configuration those scripts source.
#     Every perimeter file (cron, systemd timers, GitHub Actions workflows,
#     sudoers, server wrappers) stays untouched by this installer.
#   * verify-required-clis is a hard part of the bundle, not an optional
#     helper: deploy invokes /home/www/rateguru/bin/verify-required-clis by
#     absolute path on every deployment, before current is ever switched. A
#     clean host that installed only the rest of the bundle cannot perform
#     Its first deploy at all — the clean-VPS acceptance proved
#     exactly that. Unlike the other scripts it never sources common and is
#     not target-aware: it is a generic release-tree check taking
#     --release-root, so it carries no ordering dependency here.
#   * restore-common is the second sourced library in the bundle, alongside
#     Common: the five Restore Target Data restore primitives share backup-path,
#     workspace, archive-safety, restore-state and database-name validation,
#     and five copies of each in five privileged scripts is how a restore
#     ends up trusting a path in one place that another place rejects. Like
#     common it is installed 0644 and must never be executable.
#   * tits-guru is not provisioned by this or any other script: it has
#     lifecycle=planned in the registry, and every target-aware command
#     rejects it before touching the network or the filesystem. Installing
#     this tooling does not make tits-guru deployable.
#
# Destinations are fixed, hardcoded constants — see "Locations" below. They
# are not configurable by environment variable or CLI argument, on purpose:
# this installer's whole job is to put these twenty-two files in these
# twenty-two places with these exact permissions, nothing else.
#
# --apply additionally takes the EXISTING per-namespace restore lock for every
# active target before it touches anything, so the bundle can never be
# replaced underneath a running `restore-target` operation. It is the only
# lock this installer takes, and it takes no others.
#
# This script never sources infrastructure/scripts/common. It installs
# deployment.conf as plain file content and never reads or parses it as
# shell.

set -Eeuo pipefail
umask 022

# --- Locations (fixed; not overridable) -------------------------------------

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd -P)"

SRC_SELF="${SCRIPT_DIR}/install-target-operations"
SRC_REGISTRY="${REPO_ROOT}/infrastructure/config/deployment-targets.json"
SRC_TARGETS="${REPO_ROOT}/infrastructure/scripts/targets"
SRC_COMMON="${REPO_ROOT}/infrastructure/scripts/common"
SRC_HEALTH_CHECK="${REPO_ROOT}/infrastructure/scripts/health-check"
SRC_STATUS="${REPO_ROOT}/infrastructure/scripts/status"
SRC_CLEANUP="${REPO_ROOT}/infrastructure/scripts/cleanup"
SRC_DEPLOY="${REPO_ROOT}/infrastructure/scripts/deploy"
SRC_ROLLBACK="${REPO_ROOT}/infrastructure/scripts/rollback"
SRC_BACKUP="${REPO_ROOT}/infrastructure/scripts/backup"
SRC_RESTORE_TEST="${REPO_ROOT}/infrastructure/scripts/restore-test"
SRC_OFFSITE_BACKUP="${REPO_ROOT}/infrastructure/scripts/offsite-backup"
SRC_OFFSITE_RETENTION="${REPO_ROOT}/infrastructure/scripts/offsite-retention"
SRC_OFFSITE_RESTORE_TEST="${REPO_ROOT}/infrastructure/scripts/offsite-restore-test"
SRC_BACKUP_CYCLE="${REPO_ROOT}/infrastructure/scripts/backup-cycle"
SRC_RESTORE_COMMON="${REPO_ROOT}/infrastructure/scripts/restore-common"
SRC_FETCH_BACKUP="${REPO_ROOT}/infrastructure/scripts/fetch-backup"
SRC_VERIFY_BACKUP="${REPO_ROOT}/infrastructure/scripts/verify-backup"
SRC_RESTORE_DATABASE="${REPO_ROOT}/infrastructure/scripts/restore-database"
SRC_RESTORE_STORAGE="${REPO_ROOT}/infrastructure/scripts/restore-storage"
SRC_RESTORE_TARGET="${REPO_ROOT}/infrastructure/scripts/restore-target"
SRC_VERIFY_REQUIRED_CLIS="${REPO_ROOT}/infrastructure/scripts/verify-required-clis"
SRC_DEPLOYMENT_CONF="${REPO_ROOT}/infrastructure/templates/deployment.conf.example"

DST_CONFIG_ROOT="/home/www/rateguru/config"
DST_BIN_ROOT="/home/www/rateguru/bin"

DST_REGISTRY="${DST_CONFIG_ROOT}/deployment-targets.json"
DST_TARGETS="${DST_BIN_ROOT}/targets"
DST_COMMON="${DST_BIN_ROOT}/common"
DST_HEALTH_CHECK="${DST_BIN_ROOT}/health-check"
DST_STATUS="${DST_BIN_ROOT}/status"
DST_CLEANUP="${DST_BIN_ROOT}/cleanup"
DST_DEPLOY="${DST_BIN_ROOT}/deploy"
DST_ROLLBACK="${DST_BIN_ROOT}/rollback"
DST_BACKUP="${DST_BIN_ROOT}/backup"
DST_RESTORE_TEST="${DST_BIN_ROOT}/restore-test"
DST_OFFSITE_BACKUP="${DST_BIN_ROOT}/offsite-backup"
DST_OFFSITE_RETENTION="${DST_BIN_ROOT}/offsite-retention"
DST_OFFSITE_RESTORE_TEST="${DST_BIN_ROOT}/offsite-restore-test"
DST_BACKUP_CYCLE="${DST_BIN_ROOT}/backup-cycle"
DST_RESTORE_COMMON="${DST_BIN_ROOT}/restore-common"
DST_FETCH_BACKUP="${DST_BIN_ROOT}/fetch-backup"
DST_VERIFY_BACKUP="${DST_BIN_ROOT}/verify-backup"
DST_RESTORE_DATABASE="${DST_BIN_ROOT}/restore-database"
DST_RESTORE_STORAGE="${DST_BIN_ROOT}/restore-storage"
DST_RESTORE_TARGET="${DST_BIN_ROOT}/restore-target"
DST_VERIFY_REQUIRED_CLIS="${DST_BIN_ROOT}/verify-required-clis"
DST_DEPLOYMENT_CONF="${DST_CONFIG_ROOT}/deployment.conf"

BACKUP_ROOT="/var/backups/rateguru-target-operations"

# Where the operational scripts keep their lock files. This installer never
# creates it and owns nothing inside it — it only takes the EXISTING restore
# lock across an --apply, so replacing the bundle cannot swap a restore's
# scripts out from under it mid-operation. See acquire_restore_locks below.
OPERATIONAL_RUN_ROOT="/home/www/rateguru/run"

REGISTRY_MODE="0640"
# common and restore-common are sourced libraries, never CLIs — neither may
# ever be executable. Every other installed script (targets, health-check,
# status, cleanup, ...) is invoked directly and needs the exec bit. Two
# distinct named constants, rather than one SCRIPT_MODE reused everywhere, is
# what makes that distinction impossible to blur at a single call site by
# accident.
COMMON_MODE="0644"
CLI_MODE="0755"
# Matches REGISTRY_MODE numerically (both root:root, non-group/other-writable
# non-secret configuration), kept as its own named constant since the two
# describe unrelated files that happen to share a mode today.
DEPLOYMENT_CONF_MODE="0640"

# The ownership this installer enforces on every privileged file it cares
# about: the twenty-two files it installs. A named constant (not a literal
# "root"/0 at each call site) so the whole apply/verify flow can be
# exercised against non-root scratch paths in tests, by reassigning these
# alongside DST_*/SRC_*/BACKUP_ROOT — production always runs with the values
# below.
INSTALL_OWNER="root"
INSTALL_GROUP="root"
INSTALL_OWNER_ID=0
INSTALL_GROUP_ID=0

REQUIRED_TOOLS=(bash jq curl install stat cmp diff awk mv cp mktemp readlink tail env find sort cut sed rm flock)

# --- Deployment-state classification -----------------------------------------
#
# A genuinely clean pre-deploy host legitimately has no `current` symlink for
# the staging target: infrastructure bootstrap readiness and application
# runtime readiness are distinct states, and this installer must be able to
# install the operational bundle before the first application deployment
# without inventing a fake release to satisfy runtime probes.
#
#   PRE_DEPLOY  `current` is truly absent. The bundle installs and every
#               static/config check still runs (source validation, installed
#               parity, syntax, lifecycle rejection, cleanup --dry-run), but
#               application-health probes that require current/public
#               (health-check, the status healthy assertion) are DEFERRED —
#               logged explicitly, never reported as PASS.
#   DEPLOYED    `current` resolves to a valid immutable release directly
#               under releases/ — the full existing runtime verification is
#               preserved unchanged.
#   BROKEN      a present-but-broken current (dangling, outside releases/,
#               not a symlink, resolving to a non-directory) is a hard
#               failure in every mode — never silently treated as
#               PRE_DEPLOY, never repaired here.
#
# STAGING_TARGET_ROOT is reassignable by tests exactly like the SRC_/DST_
# constants above; empty means "derive application_root from SRC_REGISTRY at
# classification time" (production).
STAGING_TARGET_ID="staging-main"
STAGING_TARGET_ROOT=""
TARGET_DEPLOYMENT_STATE=""

classify_staging_deployment_state() {
    local root="${STAGING_TARGET_ROOT}"

    if [[ -z "${root}" ]]; then
        root="$(jq -r --arg id "${STAGING_TARGET_ID}" '.targets[$id].application_root' "${SRC_REGISTRY}")"
    fi

    [[ -n "${root}" ]] && [[ "${root}" != null ]] \
        || fail "cannot derive the ${STAGING_TARGET_ID} application root from ${SRC_REGISTRY}"

    local current="${root}/current"
    local releases="${root}/releases"

    if [[ ! -e "${current}" ]] && [[ ! -L "${current}" ]]; then
        TARGET_DEPLOYMENT_STATE=PRE_DEPLOY
        log "target state: PRE_DEPLOY — ${current} is absent (no application release deployed yet); application-health probes are deferred, never faked"
        return 0
    fi

    [[ -L "${current}" ]] \
        || fail "target state: ${current} exists but is not a symlink — broken deployment-owned state is never treated as PRE_DEPLOY; resolve it manually"

    local resolved resolved_releases
    resolved="$(readlink -f "${current}" 2>/dev/null || true)"
    [[ -n "${resolved}" ]] && [[ -e "${resolved}" ]] \
        || fail "target state: ${current} is a dangling symlink — broken deployment-owned state is never treated as PRE_DEPLOY; resolve it manually"

    resolved_releases="$(readlink -f "${releases}" 2>/dev/null || true)"
    [[ -n "${resolved_releases}" ]] \
        || fail "target state: ${releases} is missing while ${current} exists — resolve the broken release state manually"

    [[ "$(dirname "${resolved}")" == "${resolved_releases}" ]] \
        || fail "target state: ${current} resolves outside the releases directory (${resolved}) — resolve the broken release state manually"

    [[ -d "${resolved}" ]] \
        || fail "target state: ${current} resolves to a non-directory release (${resolved}) — resolve the broken release state manually"

    TARGET_DEPLOYMENT_STATE=DEPLOYED
    log "target state: DEPLOYED — ${current} resolves to a valid immutable release; full runtime verification applies"
}

# --- Logging ------------------------------------------------------------

log() {
    printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"
}

fail() {
    printf '[%s] ERROR: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >&2
    exit 1
}

# --- Argument parsing ---------------------------------------------------

MODE=""
MODE_SEEN=false

usage() {
    cat <<'USAGE'
Usage:
  install-target-operations --check
  install-target-operations --apply
  install-target-operations --verify
  install-target-operations --help

  --check   Validate committed source files and host tooling. Read-only,
            no root required.
  --apply   Install the registry and the target-aware scripts, including
            cleanup (requires root). Transactional: verifies a staged copy
            first, then the installed result, before committing.
  --verify  Verify the currently installed files and runtime behaviour
            (requires root). Makes no changes.
USAGE
}

# Sets MODE/MODE_SEEN directly in the caller's scope (this runs in the
# caller's own shell, never a subshell — same convention as common's
# parse_selector_args). Kept as a function, called explicitly at the bottom of
# this file, rather than top-level loose statements: everything from here to
# the dispatch at the end of the file is then function/constant definitions
# only, inert until called — which is what lets the whole file be sourced
# safely for testing (see the extraction tests).
parse_mode_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check|--apply|--verify)
                if [[ "${MODE_SEEN}" == true ]]; then
                    usage >&2
                    fail "only one mode may be given (already have --${MODE})"
                fi
                MODE="${1#--}"
                MODE_SEEN=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                usage >&2
                fail "unknown argument: $1"
                ;;
        esac
    done

    [[ "${MODE_SEEN}" == true ]] || { usage >&2; fail "exactly one of --check, --apply or --verify is required"; }
}

# --- Shared helpers -------------------------------------------------------

require_root() {
    [[ "${EUID}" -eq 0 ]] || fail "this command must be executed as root"
}

check_required_tools() {
    local tool
    for tool in "${REQUIRED_TOOLS[@]}"; do
        command -v "${tool}" >/dev/null 2>&1 || fail "required tool not found: ${tool}"
    done
    log "required host tools present: ${REQUIRED_TOOLS[*]}"
}

# --- Source validation (side-effect free; used by --check and apply preflight)

validate_source_files() {
    local path
    for path in "${SRC_REGISTRY}" "${SRC_TARGETS}" "${SRC_COMMON}" "${SRC_RESTORE_COMMON}" "${SRC_HEALTH_CHECK}" "${SRC_STATUS}" "${SRC_CLEANUP}" "${SRC_DEPLOY}" "${SRC_ROLLBACK}" "${SRC_BACKUP}" "${SRC_RESTORE_TEST}" "${SRC_OFFSITE_BACKUP}" "${SRC_OFFSITE_RETENTION}" "${SRC_OFFSITE_RESTORE_TEST}" "${SRC_BACKUP_CYCLE}" "${SRC_FETCH_BACKUP}" "${SRC_VERIFY_BACKUP}" "${SRC_RESTORE_DATABASE}" "${SRC_RESTORE_STORAGE}" "${SRC_RESTORE_TARGET}" "${SRC_VERIFY_REQUIRED_CLIS}" "${SRC_DEPLOYMENT_CONF}"; do
        [[ -e "${path}" ]] || fail "missing required source file: ${path}"
        [[ ! -L "${path}" ]] || fail "source file must not be a symlink: ${path}"
        [[ -f "${path}" ]] || fail "source file must be a regular file: ${path}"
        [[ -r "${path}" ]] || fail "source file is not readable: ${path}"
    done
    log "all twenty-two source files are present regular files"
}

# Catches the exact regression that made this installer unusable after a bad
# artifact build: every file under infrastructure/scripts arriving at mode
# 0640. validate_source_registry below invokes the targets CLI *directly*
# (deliberately never wrapped in `bash ...` — see the comment there), so a
# missing executable bit on it, or on this installer's other CLI dependencies,
# must fail here, by name, before that happens — the alternative is a bare
# "Permission denied" with no indication of which file or why. common is a
# sourced library, never executed directly, so it is exempt here;
# validate_source_files already requires them to be readable regular files.
validate_source_executable_modes() {
    local path
    for path in "${SRC_SELF}" "${SRC_TARGETS}" "${SRC_HEALTH_CHECK}" "${SRC_STATUS}" "${SRC_CLEANUP}" "${SRC_DEPLOY}" "${SRC_ROLLBACK}" "${SRC_BACKUP}" "${SRC_RESTORE_TEST}" "${SRC_OFFSITE_BACKUP}" "${SRC_OFFSITE_RETENTION}" "${SRC_OFFSITE_RESTORE_TEST}" "${SRC_BACKUP_CYCLE}" "${SRC_FETCH_BACKUP}" "${SRC_VERIFY_BACKUP}" "${SRC_RESTORE_DATABASE}" "${SRC_RESTORE_STORAGE}" "${SRC_RESTORE_TARGET}" "${SRC_VERIFY_REQUIRED_CLIS}"; do
        [[ -x "${path}" ]] || fail "required source CLI is not executable: ${path}"
    done

    # The two sourced libraries are the mirror image: never invoked directly,
    # so an executable bit on either is a defect in its own right, caught
    # here rather than only at installed-file verification.
    for path in "${SRC_COMMON}" "${SRC_RESTORE_COMMON}"; do
        [[ ! -x "${path}" ]] || fail "sourced library must not be executable: ${path}"
    done

    log "install-target-operations, targets, health-check, status, cleanup, deploy, rollback, backup, restore-test, offsite-backup, offsite-retention, offsite-restore-test, backup-cycle, fetch-backup, verify-backup, restore-database, restore-storage, restore-target and verify-required-clis are all executable; common and restore-common are not"
}

validate_source_syntax() {
    local path
    for path in "${SRC_TARGETS}" "${SRC_COMMON}" "${SRC_RESTORE_COMMON}" "${SRC_HEALTH_CHECK}" "${SRC_STATUS}" "${SRC_CLEANUP}" "${SRC_DEPLOY}" "${SRC_ROLLBACK}" "${SRC_BACKUP}" "${SRC_RESTORE_TEST}" "${SRC_OFFSITE_BACKUP}" "${SRC_OFFSITE_RETENTION}" "${SRC_OFFSITE_RESTORE_TEST}" "${SRC_BACKUP_CYCLE}" "${SRC_FETCH_BACKUP}" "${SRC_VERIFY_BACKUP}" "${SRC_RESTORE_DATABASE}" "${SRC_RESTORE_STORAGE}" "${SRC_RESTORE_TARGET}" "${SRC_VERIFY_REQUIRED_CLIS}"; do
        bash -n "${path}" || fail "bash -n failed for source file: ${path}"
    done
    log "bash -n passed for all twenty source shell scripts"

    # deployment.conf is never executed directly — common sources it — but it
    # is still bash-syntax content (KEY=value assignments), and bash -n
    # parses that exactly as well as a script, catching a syntax error before
    # this installer ever stages or installs it.
    bash -n "${SRC_DEPLOYMENT_CONF}" || fail "bash -n failed for source file: ${SRC_DEPLOYMENT_CONF}"
    log "bash -n passed for source deployment.conf"
}

validate_source_registry() {
    jq empty "${SRC_REGISTRY}" 2>/dev/null || fail "source registry is not valid JSON: ${SRC_REGISTRY}"

    "${SRC_TARGETS}" validate --file "${SRC_REGISTRY}" >/dev/null \
        || fail "source targets CLI could not validate the committed registry"

    local listing
    listing="$("${SRC_TARGETS}" list --file "${SRC_REGISTRY}")" \
        || fail "source targets CLI could not list the committed registry"

    grep -Fxq "$(printf 'staging-main\tactive\tstaging')" <<<"${listing}" \
        || fail "source registry does not list staging-main as active/staging"
    grep -Fxq "$(printf 'tits-guru\tplanned\tproduction')" <<<"${listing}" \
        || fail "source registry does not list tits-guru as planned/production"

    log "source registry is valid JSON, passes its own validator, and lists the expected targets"
}

run_source_validation() {
    validate_source_files
    validate_source_executable_modes
    validate_source_syntax
    validate_source_registry
    check_required_tools
}

# --- Staged pre-install verification (apply mode only) ----------------------
#
# Runs the CANDIDATE files together, before anything is installed, using the
# gated RATEGURU_* test/tooling overrides slice 2 already established. This is
# the one place in this installer's own execution where those overrides are
# used deliberately and explicitly — never again after this point, and never
# for the final runtime-parity verification below, which explicitly unsets
# every one of them.

# Static, read-only proof over a captured --help output: shows --target,
# never shows --environment. Checked against every staged script before any
# of them is invoked for real, so a regression that resurrects the legacy
# selector is caught at the earliest possible point.
assert_usage_target_only() {
    local help_output="$1" label="$2"

    grep -Fq -- '--target' <<<"${help_output}" \
        || fail "${label} --help does not mention --target: ${help_output}"

    if grep -Fq -- '--environment' <<<"${help_output}"; then
        fail "${label} --help still mentions --environment: ${help_output}"
    fi
}

verify_staged_candidates() {
    local stage_dir="$1"
    local staged_registry="${stage_dir}/deployment-targets.json"
    local staged_targets="${stage_dir}/targets"
    local staged_common="${stage_dir}/common"
    local staged_health_check="${stage_dir}/health-check"
    local staged_status="${stage_dir}/status"
    local staged_cleanup="${stage_dir}/cleanup"
    local staged_deploy="${stage_dir}/deploy"
    local staged_rollback="${stage_dir}/rollback"
    local staged_backup="${stage_dir}/backup"
    local staged_restore_test="${stage_dir}/restore-test"
    local staged_offsite_backup="${stage_dir}/offsite-backup"
    local staged_offsite_retention="${stage_dir}/offsite-retention"
    local staged_offsite_restore_test="${stage_dir}/offsite-restore-test"
    local staged_backup_cycle="${stage_dir}/backup-cycle"
    local staged_restore_common="${stage_dir}/restore-common"
    local staged_fetch_backup="${stage_dir}/fetch-backup"
    local staged_verify_backup="${stage_dir}/verify-backup"
    local staged_restore_database="${stage_dir}/restore-database"
    local staged_restore_storage="${stage_dir}/restore-storage"
    local staged_restore_target="${stage_dir}/restore-target"
    local staged_verify_required_clis="${stage_dir}/verify-required-clis"
    local staged_deployment_conf="${stage_dir}/deployment.conf"

    log "verifying staged candidates before installation"

    local -a override_env=(
        env
        RATEGURU_ALLOW_TEST_OVERRIDES=true
        "RATEGURU_COMMON_FILE=${staged_common}"
        "RATEGURU_RESTORE_COMMON_FILE=${staged_restore_common}"
        "RATEGURU_DEPLOYMENT_CONF_FILE=${staged_deployment_conf}"
        "RATEGURU_TARGET_REGISTRY_FILE=${staged_registry}"
        "RATEGURU_TARGETS_CLI=${staged_targets}"
        "RATEGURU_HEALTH_CHECK_CLI=${staged_health_check}"
    )

    "${staged_targets}" validate --file "${staged_registry}" >/dev/null \
        || fail "staged targets CLI did not validate the staged registry"
    log "  staged targets validate: OK"

    local script entry help_output
    for entry in \
        "${staged_health_check}:health-check" \
        "${staged_status}:status" \
        "${staged_cleanup}:cleanup" \
        "${staged_deploy}:deploy" \
        "${staged_rollback}:rollback" \
        "${staged_backup}:backup" \
        "${staged_restore_test}:restore-test" \
        "${staged_offsite_backup}:offsite-backup" \
        "${staged_offsite_retention}:offsite-retention" \
        "${staged_offsite_restore_test}:offsite-restore-test" \
        "${staged_backup_cycle}:backup-cycle" \
        "${staged_fetch_backup}:fetch-backup" \
        "${staged_verify_backup}:verify-backup" \
        "${staged_restore_database}:restore-database" \
        "${staged_restore_storage}:restore-storage" \
        "${staged_restore_target}:restore-target"
    do
        script="${entry%%:*}"
        help_output="$("${override_env[@]}" bash "${script}" --help 2>&1)" \
            || fail "staged ${entry#*:} --help failed"
        assert_usage_target_only "${help_output}" "staged ${entry#*:}"
    done
    log "  staged usage: every script shows --target only, none mention --environment"

    # verify-required-clis is deliberately outside the loop above: it is the
    # one bundle script that is not target-aware. It never sources common and
    # takes --release-root instead of --target, so asserting "--target only"
    # against it would be asserting the wrong contract. Its own usage is
    # checked for the flag it actually has.
    local staged_verify_clis_usage
    staged_verify_clis_usage="$("${override_env[@]}" bash "${staged_verify_required_clis}" --help 2>&1)" \
        || fail "staged verify-required-clis --help failed"
    grep -q -- '--release-root' <<<"${staged_verify_clis_usage}" \
        || fail "staged verify-required-clis usage does not document --release-root: ${staged_verify_clis_usage}"
    if grep -q -- '--environment' <<<"${staged_verify_clis_usage}"; then
        fail "staged verify-required-clis usage mentions the removed --environment selector"
    fi
    log "  staged verify-required-clis --help: OK (--release-root, no --environment)"

    # Application-health probes require a deployed release behind
    # current/public: on a PRE_DEPLOY host they are deferred — logged, never
    # reported as OK — instead of failing against an application that does
    # not exist yet. Every static/lifecycle check below still runs.
    if [[ "${TARGET_DEPLOYMENT_STATE:-}" == PRE_DEPLOY ]]; then
        log "  staged health-check --target staging-main: DEFERRED (pre-deploy: no current release exists yet)"
        log "  staged status --target staging-main: DEFERRED (pre-deploy: status asserts application health, which requires a deployed release)"
    else
        "${override_env[@]}" bash "${staged_health_check}" --target staging-main >/dev/null 2>&1 \
            || fail "staged health-check --target staging-main failed"
        log "  staged health-check --target staging-main: OK"

        "${override_env[@]}" bash "${staged_status}" --target staging-main >/dev/null 2>&1 \
            || fail "staged status --target staging-main failed"
        log "  staged status --target staging-main: OK"
    fi

    # cleanup is exercised in --dry-run only here — dry-run is genuinely
    # side-effect free (no lock, no write, no delete; see cleanup's own
    # source), which is exactly what makes it safe to run against the real
    # staging-main target root before anything else in this apply run is
    # touched.
    local staged_cleanup_target_output
    staged_cleanup_target_output="$("${override_env[@]}" bash "${staged_cleanup}" --target staging-main --dry-run 2>&1)" \
        || fail "staged cleanup --target staging-main --dry-run failed:"$'\n'"${staged_cleanup_target_output}"
    log "  staged cleanup --target staging-main --dry-run: OK"

    # deploy is never run for real here — no artifact exists to deploy, and
    # doing so would mutate the real staging target during what must stay a
    # read-only preflight. --help was already proven above (no root-gated
    # mutation reachable); only the tits-guru lifecycle rejection (fails
    # before any filesystem access) remains to prove against the staged
    # candidate. This whole apply run already runs as root (perform_apply is
    # only reached via run_apply, which requires root), so staged_deploy's
    # own require_root passes here exactly as it would in production.

    # This command is *expected* to fail. The trap armed by perform_apply is
    # still inherited into this subshell (see the MAIN_BASHPID comment on
    # on_apply_error), but that handler now recognizes it isn't running in
    # the main process and exits quietly without side effects, so this
    # expected failure is captured exactly like any other.
    local planned_output
    if planned_output="$("${override_env[@]}" bash "${staged_health_check}" --target tits-guru 2>&1)"; then
        fail "staged health-check --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${planned_output}" \
        || fail "staged health-check --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${planned_output}"
    log "  staged health-check --target tits-guru: correctly rejected (lifecycle=planned)"

    local staged_cleanup_planned_output
    if staged_cleanup_planned_output="$("${override_env[@]}" bash "${staged_cleanup}" --target tits-guru --dry-run 2>&1)"; then
        fail "staged cleanup --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${staged_cleanup_planned_output}" \
        || fail "staged cleanup --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${staged_cleanup_planned_output}"
    log "  staged cleanup --target tits-guru: correctly rejected (lifecycle=planned)"

    # A deliberately unusable artifact path: proves rejection happens at the
    # lifecycle gate, never reaching (and never failing on) artifact
    # validation — root authorization -> lifecycle=planned rejection -> no
    # filesystem validation, the same ordering DeployTest.php proves in
    # depth.
    local staged_deploy_planned_output
    if staged_deploy_planned_output="$("${override_env[@]}" bash "${staged_deploy}" --target tits-guru --release v0.0.0-20260101-000000-abc0000 --artifact /definitely/missing.tar.gz 2>&1)"; then
        fail "staged deploy --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${staged_deploy_planned_output}" \
        || fail "staged deploy --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${staged_deploy_planned_output}"
    log "  staged deploy --target tits-guru: correctly rejected (lifecycle=planned)"

    # rollback is never run for real here either — no releases exist to roll
    # back to, and doing so would mutate the real staging target during what
    # must stay a read-only preflight. --help was already proven above; only
    # the tits-guru lifecycle rejection remains, mirroring deploy's own
    # staged checks above exactly. This apply run already runs as root, so
    # staged_rollback's own require_root passes here exactly as it would in
    # production.
    local staged_rollback_planned_output
    if staged_rollback_planned_output="$("${override_env[@]}" bash "${staged_rollback}" --target tits-guru --release v0.0.0-20260101-000000-abc0000 2>&1)"; then
        fail "staged rollback --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${staged_rollback_planned_output}" \
        || fail "staged rollback --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${staged_rollback_planned_output}"
    log "  staged rollback --target tits-guru: correctly rejected (lifecycle=planned)"

    # backup and restore-test are never run for real here either — no local
    # backup exists yet, and doing so would mutate the real staging target's
    # database dump/storage archive/backup namespace during what must stay a
    # read-only preflight. --help was already proven above; only the
    # tits-guru lifecycle rejection remains, mirroring deploy/rollback's own
    # staged checks above exactly. This apply run already runs as root, so
    # both staged scripts' own require_root passes here exactly as it would
    # in production.
    local staged_backup_planned_output
    if staged_backup_planned_output="$("${override_env[@]}" bash "${staged_backup}" --target tits-guru 2>&1)"; then
        fail "staged backup --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${staged_backup_planned_output}" \
        || fail "staged backup --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${staged_backup_planned_output}"
    log "  staged backup --target tits-guru: correctly rejected (lifecycle=planned)"

    local staged_restore_test_planned_output
    if staged_restore_test_planned_output="$("${override_env[@]}" bash "${staged_restore_test}" --target tits-guru 2>&1)"; then
        fail "staged restore-test --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${staged_restore_test_planned_output}" \
        || fail "staged restore-test --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${staged_restore_test_planned_output}"
    log "  staged restore-test --target tits-guru: correctly rejected (lifecycle=planned)"

    # offsite-backup, offsite-retention and offsite-restore-test are never run
    # for real here either — no B2 access, no remote listing, no local backup
    # mutation, no database work. --help was already proven above; only the
    # tits-guru lifecycle rejection remains, mirroring backup/restore-test's
    # own staged checks above exactly.
    local staged_offsite_backup_planned_output
    if staged_offsite_backup_planned_output="$("${override_env[@]}" bash "${staged_offsite_backup}" --target tits-guru 2>&1)"; then
        fail "staged offsite-backup --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${staged_offsite_backup_planned_output}" \
        || fail "staged offsite-backup --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${staged_offsite_backup_planned_output}"
    log "  staged offsite-backup --target tits-guru: correctly rejected (lifecycle=planned)"

    local staged_offsite_retention_planned_output
    if staged_offsite_retention_planned_output="$("${override_env[@]}" bash "${staged_offsite_retention}" --target tits-guru 2>&1)"; then
        fail "staged offsite-retention --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${staged_offsite_retention_planned_output}" \
        || fail "staged offsite-retention --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${staged_offsite_retention_planned_output}"
    log "  staged offsite-retention --target tits-guru: correctly rejected (lifecycle=planned)"

    local staged_offsite_restore_test_planned_output
    if staged_offsite_restore_test_planned_output="$("${override_env[@]}" bash "${staged_offsite_restore_test}" --target tits-guru 2>&1)"; then
        fail "staged offsite-restore-test --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${staged_offsite_restore_test_planned_output}" \
        || fail "staged offsite-restore-test --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${staged_offsite_restore_test_planned_output}"
    log "  staged offsite-restore-test --target tits-guru: correctly rejected (lifecycle=planned)"

    # backup-cycle is never run for real here either — a real cycle would
    # create a local backup, run a restore test, upload offsite and apply
    # real retention against the real staging-main target, which must stay
    # untouched by what is meant to be a read-only preflight. --help was
    # already proven above; only the tits-guru lifecycle rejection remains,
    # mirroring every other mutating operational script's own staged checks
    # above exactly.
    local staged_backup_cycle_planned_output
    if staged_backup_cycle_planned_output="$("${override_env[@]}" bash "${staged_backup_cycle}" --target tits-guru 2>&1)"; then
        fail "staged backup-cycle --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${staged_backup_cycle_planned_output}" \
        || fail "staged backup-cycle --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${staged_backup_cycle_planned_output}"
    log "  staged backup-cycle --target tits-guru: correctly rejected (lifecycle=planned)"

    # The five restore primitives are never run for real here
    # either — a real restore would download a backup, create a temporary
    # database, quiesce the target and swap its live data, none of which
    # belongs in a read-only preflight. --help was already proven above; only
    # the tits-guru lifecycle rejection remains. Each is invoked with
    # otherwise-complete, deliberately unusable arguments, so a rejection can
    # only come from the lifecycle gate — never from a missing flag, a bad
    # backup ID, or a workspace that does not exist.
    local staged_entry staged_planned_output
    for staged_entry in \
        "${staged_fetch_backup}|fetch-backup|--source|local|--backup|20260101-000000" \
        "${staged_verify_backup}|verify-backup|--operation|20260101-000000-abcdef" \
        "${staged_restore_database}|restore-database|--operation|20260101-000000-abcdef|--stage" \
        "${staged_restore_storage}|restore-storage|--operation|20260101-000000-abcdef|--stage" \
        "${staged_restore_target}|restore-target|--apply|--source|local|--backup|20260101-000000"
    do
        local -a staged_fields=()
        IFS='|' read -r -a staged_fields <<<"${staged_entry}"

        local staged_script="${staged_fields[0]}"
        local staged_label="${staged_fields[1]}"
        local -a staged_extra_args=("${staged_fields[@]:2}")

        if staged_planned_output="$(
            "${override_env[@]}" bash "${staged_script}" \
                --target tits-guru "${staged_extra_args[@]}" 2>&1
        )"; then
            fail "staged ${staged_label} --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
        fi

        grep -q 'lifecycle=planned' <<<"${staged_planned_output}" \
            || fail "staged ${staged_label} --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${staged_planned_output}"

        log "  staged ${staged_label} --target tits-guru: correctly rejected (lifecycle=planned)"
    done

    log "staged candidates verified"
}

# --- Transactional install/rollback core -------------------------------
#
# Parameterized on source/destination/owner/group/mode rather than the fixed
# DST_* constants above, so this block can be extracted and exercised
# directly against scratch paths — see
# tests/Feature/Architecture/InstallTargetOperationsTest.php. run_apply below
# is what actually calls these with the real, hardcoded production
# destinations; nothing here decides where those destinations are.

# --- installer core (begin) ---

BACKUP_DIR=""
ROLLBACK_RESTORE=()   # destinations that existed before and were backed up
ROLLBACK_REMOVE=()    # destinations that did not exist before install

files_differ() {
    # files_differ <src> <dst> -> true (0) if dst missing or content differs
    local src="$1" dst="$2"
    [[ -f "${dst}" ]] || return 0
    ! cmp -s "${src}" "${dst}"
}

record_target() {
    # record_target <dst>: snapshot for rollback before it is touched at all.
    local dst="$1"
    if [[ -e "${dst}" || -L "${dst}" ]]; then
        local backup_path="${BACKUP_DIR}${dst}"
        install -d -m 0700 "$(dirname "${backup_path}")"
        cp -a "${dst}" "${backup_path}"
        ROLLBACK_RESTORE+=("${dst}")
    else
        ROLLBACK_REMOVE+=("${dst}")
    fi
}

reject_unsafe_existing_destination() {
    # reject_unsafe_existing_destination <dst>
    #
    # Whatever is already at <dst> must be either absent (first-ever install)
    # or a plain regular file — this installer's own previous copy, or
    # whatever legacy file preceded it. A symlink, directory, FIFO, socket or
    # device is refused outright rather than followed, entered or replaced.
    # Runs before record_target, so a rejected destination is never backed up
    # and never touched.
    local dst="$1"

    if [[ -L "${dst}" ]]; then
        fail "refusing to install over an existing symlink: ${dst}"
    fi

    if [[ -e "${dst}" ]] && [[ ! -f "${dst}" ]]; then
        fail "refusing to install over an existing non-regular-file destination: ${dst}"
    fi
}

install_regular_file_transactional() {
    # install_regular_file_transactional <src> <dst> <owner> <group> <mode>
    #
    # Stages into a same-directory, mktemp-created temp file (so the final
    # rename is on the same filesystem, hence atomic, and the temp name is
    # never predictable), sets final ownership/mode on the staged file, then
    # renames it into place — the destination is never observable in a
    # partially-written state. The temp file is removed if either staging
    # step fails, never left behind for a human to clean up.
    local src="$1" dst="$2" owner="$3" group="$4" mode="$5"

    reject_unsafe_existing_destination "${dst}"
    record_target "${dst}"

    local tmp
    tmp="$(mktemp "${dst}.XXXXXX")"

    if ! install -o "${owner}" -g "${group}" -m "${mode}" "${src}" "${tmp}"; then
        rm -f "${tmp}"
        fail "failed to stage ${dst} for install (writing the temporary file failed)"
    fi

    if ! mv -f "${tmp}" "${dst}"; then
        rm -f "${tmp}"
        fail "failed to rename the staged file into place: ${dst}"
    fi
}

verify_installed_regular_file() {
    # verify_installed_regular_file <dst> <owner-id> <group-id> <mode> <src>
    local dst="$1" owner_id="$2" group_id="$3" mode="$4" src="$5"

    [[ -e "${dst}" ]] || fail "expected installed file is missing: ${dst}"
    [[ ! -L "${dst}" ]] || fail "installed file must not be a symlink: ${dst}"
    [[ -f "${dst}" ]] || fail "installed file must be a regular file: ${dst}"

    local actual_owner
    actual_owner="$(stat -c '%u:%g' "${dst}")"
    [[ "${actual_owner}" == "${owner_id}:${group_id}" ]] \
        || fail "installed file has wrong ownership: ${dst} is ${actual_owner}, expected ${owner_id}:${group_id}"

    # Compared numerically, not as strings: `stat -c '%a'` never prints a
    # leading zero (e.g. "640"), while the expected mode is conventionally
    # written with one ("0640") — both are the same octal value.
    local actual_mode
    actual_mode="$(stat -c '%a' "${dst}")"
    (( 8#${actual_mode} == 8#${mode} )) \
        || fail "installed file has wrong mode: ${dst} is ${actual_mode}, expected ${mode}"

    if (( (8#${actual_mode} & 8#022) != 0 )); then
        fail "installed file must not be group- or other-writable: ${dst} (mode ${actual_mode})"
    fi

    cmp -s "${src}" "${dst}" \
        || fail "installed file content differs from its committed source: ${dst}"
}

rollback_installed_files() {
    # Restores every recorded destination from its backup, or removes it if it
    # did not exist before this run. Returns non-zero — never masks the
    # original failure by exiting — if any single restoration fails, so the
    # caller can report an incomplete rollback rather than claim success.
    local status=0 dst backup_path

    for dst in "${ROLLBACK_REMOVE[@]:-}"; do
        [[ -n "${dst}" ]] || continue
        rm -f "${dst}" || { log "ERROR: could not remove ${dst} during rollback"; status=1; }
    done

    for dst in "${ROLLBACK_RESTORE[@]:-}"; do
        [[ -n "${dst}" ]] || continue
        backup_path="${BACKUP_DIR}${dst}"
        if [[ -e "${backup_path}" || -L "${backup_path}" ]]; then
            rm -f "${dst}"
            cp -a "${backup_path}" "${dst}" \
                || { log "ERROR: could not restore ${dst} from ${backup_path}"; status=1; }
        else
            log "ERROR: no backup found for ${dst}; it was left as installed"
            status=1
        fi
    done

    return "${status}"
}

# --- installer core (end) ---

# --- Runtime verification helpers (extractable) -----------------------------
#
# Used by both apply's post-install check and --verify. Every invocation here
# explicitly unsets the full RATEGURU_* override set, so this genuinely proves
# what the real host would do — no test seam is active.

# --- runtime verification (begin) ---

RATEGURU_OVERRIDE_VARS=(
    RATEGURU_ALLOW_TEST_OVERRIDES
    RATEGURU_COMMON_FILE
    RATEGURU_DEPLOYMENT_CONF_FILE
    RATEGURU_TARGET_REGISTRY_FILE
    RATEGURU_TARGETS_CLI
    RATEGURU_HEALTH_CHECK_CLI
    RATEGURU_HEALTH_CHECK_BIN
    RATEGURU_VERIFY_REQUIRED_CLIS_BIN
    RATEGURU_BACKUP_BASE
    RATEGURU_RUN_ROOT
    RATEGURU_SYSTEM_ROOT
    RATEGURU_PG_DUMP_BIN
    RATEGURU_PHP_BIN
    RATEGURU_CREATEDB_BIN
    RATEGURU_DROPDB_BIN
    RATEGURU_PG_RESTORE_BIN
    RATEGURU_PSQL_BIN
    RATEGURU_RCLONE_CONFIG
    RATEGURU_RCLONE_REMOTE
    RATEGURU_RCLONE_BUCKET
    RATEGURU_RCLONE_BIN
    RATEGURU_BACKUP_BIN
    RATEGURU_RESTORE_TEST_BIN
    RATEGURU_OFFSITE_BACKUP_BIN
    RATEGURU_OFFSITE_RETENTION_BIN
    RATEGURU_OFFSITE_RESTORE_TEST_BIN
    RATEGURU_RESTORE_COMMON_FILE
    RATEGURU_RESTORE_RUNUSER_BIN
    RATEGURU_RESTORE_SUPERUSER
    RATEGURU_RESTORE_HISTORY_ROOT
    RATEGURU_RESTORE_CRON_D_ROOT
    RATEGURU_RESTORE_SUPERVISORCTL_BIN
    RATEGURU_RESTORE_HEALTH_CHECK_BIN
    RATEGURU_RESTORE_BACKUP_BIN
    RATEGURU_RESTORE_RESTORE_TEST_BIN
    RATEGURU_RESTORE_FETCH_BACKUP_BIN
    RATEGURU_RESTORE_VERIFY_BACKUP_BIN
    RATEGURU_RESTORE_DATABASE_BIN
    RATEGURU_RESTORE_STORAGE_BIN
    RATEGURU_RESTORE_WEB_GROUP
    RATEGURU_RESTORE_QUEUE_WAIT_ATTEMPTS
    RATEGURU_RESTORE_QUEUE_RETRY_DELAY
    RATEGURU_RESTORE_SCHEDULER_WAIT_ATTEMPTS
    RATEGURU_RESTORE_SCHEDULER_RETRY_DELAY
)

no_overrides_env() {
    # Printed as an array via a nameref-free helper: callers do
    #   "$(no_overrides_env_args)" — instead this just execs env -u... "$@" so
    # every call site is guaranteed to unset the same fixed list.
    local -a unset_args=()
    local var
    for var in "${RATEGURU_OVERRIDE_VARS[@]}"; do
        unset_args+=(-u "${var}")
    done
    env "${unset_args[@]}" "$@"
}

# Validates that exactly one of each expected section marker is present in a
# raw status output, before anything is extracted from it. A status output
# that is missing a whole section (a real regression, e.g. a crashed status
# script) must never be allowed to silently compare as "identical" to another
# equally-broken output just because both extracted bodies happen to be empty.
assert_status_sections_present() {
    local output="$1" label="$2"
    local marker count
    for marker in 'Releases' 'Current release metadata' 'Health' 'Recent deployment history'; do
        count="$(grep -Fxc "${marker}" <<<"${output}" || true)"
        [[ "${count}" -eq 1 ]] \
            || fail "${label} status output has ${count} occurrence(s) of the '${marker}' section (expected exactly 1) — malformed or missing section"
    done
}

verify_installed_files() {
    log "verifying installed files"

    verify_installed_regular_file "${DST_REGISTRY}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${REGISTRY_MODE}" "${SRC_REGISTRY}"
    verify_installed_regular_file "${DST_TARGETS}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_TARGETS}"
    verify_installed_regular_file "${DST_COMMON}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${COMMON_MODE}" "${SRC_COMMON}"
    verify_installed_regular_file "${DST_HEALTH_CHECK}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_HEALTH_CHECK}"
    verify_installed_regular_file "${DST_STATUS}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_STATUS}"
    verify_installed_regular_file "${DST_CLEANUP}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_CLEANUP}"
    verify_installed_regular_file "${DST_DEPLOY}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_DEPLOY}"
    verify_installed_regular_file "${DST_ROLLBACK}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_ROLLBACK}"
    verify_installed_regular_file "${DST_BACKUP}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_BACKUP}"
    verify_installed_regular_file "${DST_RESTORE_TEST}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_RESTORE_TEST}"
    verify_installed_regular_file "${DST_OFFSITE_BACKUP}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_OFFSITE_BACKUP}"
    verify_installed_regular_file "${DST_OFFSITE_RETENTION}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_OFFSITE_RETENTION}"
    verify_installed_regular_file "${DST_OFFSITE_RESTORE_TEST}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_OFFSITE_RESTORE_TEST}"
    verify_installed_regular_file "${DST_BACKUP_CYCLE}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_BACKUP_CYCLE}"
    verify_installed_regular_file "${DST_RESTORE_COMMON}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${COMMON_MODE}" "${SRC_RESTORE_COMMON}"
    verify_installed_regular_file "${DST_FETCH_BACKUP}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_FETCH_BACKUP}"
    verify_installed_regular_file "${DST_VERIFY_BACKUP}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_VERIFY_BACKUP}"
    verify_installed_regular_file "${DST_RESTORE_DATABASE}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_RESTORE_DATABASE}"
    verify_installed_regular_file "${DST_RESTORE_STORAGE}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_RESTORE_STORAGE}"
    verify_installed_regular_file "${DST_RESTORE_TARGET}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_RESTORE_TARGET}"
    verify_installed_regular_file "${DST_VERIFY_REQUIRED_CLIS}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${CLI_MODE}" "${SRC_VERIFY_REQUIRED_CLIS}"
    verify_installed_regular_file "${DST_DEPLOYMENT_CONF}" "${INSTALL_OWNER_ID}" "${INSTALL_GROUP_ID}" "${DEPLOYMENT_CONF_MODE}" "${SRC_DEPLOYMENT_CONF}"
    log "  ownership, mode and content: OK for all twenty-two files"

    # common and restore-common are sourced libraries, never CLIs —
    # verify_installed_regular_file already proved their mode is exactly
    # COMMON_MODE (0644), which has no execute bits at all, but this asserts
    # the specific property the spec calls out by name rather than leaving it
    # as an implication of the mode check above.
    local library
    for library in "${DST_COMMON}" "${DST_RESTORE_COMMON}"; do
        [[ ! -x "${library}" ]] \
            || fail "installed sourced library must not be executable: ${library}"
    done
    log "  common and restore-common are not executable: OK"

    local path
    for path in "${DST_TARGETS}" "${DST_COMMON}" "${DST_RESTORE_COMMON}" "${DST_HEALTH_CHECK}" "${DST_STATUS}" "${DST_CLEANUP}" "${DST_DEPLOY}" "${DST_ROLLBACK}" "${DST_BACKUP}" "${DST_RESTORE_TEST}" "${DST_OFFSITE_BACKUP}" "${DST_OFFSITE_RETENTION}" "${DST_OFFSITE_RESTORE_TEST}" "${DST_BACKUP_CYCLE}" "${DST_FETCH_BACKUP}" "${DST_VERIFY_BACKUP}" "${DST_RESTORE_DATABASE}" "${DST_RESTORE_STORAGE}" "${DST_RESTORE_TARGET}" "${DST_VERIFY_REQUIRED_CLIS}"; do
        bash -n "${path}" || fail "bash -n failed for installed file: ${path}"
    done
    log "  bash -n: OK for all twenty installed scripts"

    # deployment.conf is never executed directly — common sources it — but it
    # is still bash-syntax content (KEY=value assignments), and bash -n
    # parses that exactly as well as a script, catching a syntax error (an
    # unescaped quote, for example) before it is ever actually sourced.
    bash -n "${DST_DEPLOYMENT_CONF}" || fail "bash -n failed for installed file: ${DST_DEPLOYMENT_CONF}"
    log "  bash -n: OK for installed deployment.conf"

    "${DST_TARGETS}" validate --file "${DST_REGISTRY}" >/dev/null \
        || fail "installed targets CLI could not validate the installed registry"
    log "  installed targets validate: OK"

    local listing
    listing="$("${DST_TARGETS}" list --file "${DST_REGISTRY}")" \
        || fail "installed targets CLI could not list the installed registry"
    grep -Fxq "$(printf 'staging-main\tactive\tstaging')" <<<"${listing}" \
        || fail "installed registry does not list staging-main as active/staging"
    grep -Fxq "$(printf 'tits-guru\tplanned\tproduction')" <<<"${listing}" \
        || fail "installed registry does not list tits-guru as planned/production"
    log "  installed targets list: OK (staging-main active/staging, tits-guru planned/production)"

    log "installed-file verification passed"
}

verify_target_health() {
    # PRE_DEPLOY (see classify_staging_deployment_state): the application
    # health probe requires a deployed release behind current/public —
    # deferred with an explicit log line, never reported as OK, never
    # satisfied by fabricating a release. The default when the variable is
    # unset (extracted-block harnesses) is the strict DEPLOYED behaviour.
    if [[ "${TARGET_DEPLOYMENT_STATE:-}" == PRE_DEPLOY ]]; then
        log "health-check --target staging-main: DEFERRED (pre-deploy: no current release exists yet)"
        return 0
    fi

    no_overrides_env "${DST_HEALTH_CHECK}" --target staging-main >/dev/null \
        || fail "installed health-check --target staging-main failed"
    log "health-check --target staging-main: OK"
}

verify_status() {
    # status itself works without a deployed release (absent current prints
    # "not configured" and the embedded health probe reports unhealthy
    # without failing the script), so the invocation, the header checks and
    # the section-shape validation always run in both states — only the
    # final 'Status: healthy' assertion requires a deployed application and
    # is deferred on a PRE_DEPLOY host (see verify_target_health).
    local status_output
    status_output="$(no_overrides_env "${DST_STATUS}" --target staging-main)" \
        || fail "installed status --target staging-main failed"
    log "status --target staging-main: OK"

    grep -Fq 'Target:      staging-main' <<<"${status_output}" \
        || fail "status output is missing 'Target: staging-main'"
    grep -Fq 'Lifecycle:   active' <<<"${status_output}" \
        || fail "status output is missing 'Lifecycle: active'"
    grep -Fq 'Environment class: staging' <<<"${status_output}" \
        || fail "status output is missing 'Environment class: staging'"
    log "status header: OK"

    # A status output missing a whole section is a malformed/broken output in
    # its own right, and deserves its own specific diagnostic naming the
    # missing section — not a downstream symptom like a missing
    # Status: healthy line.
    assert_status_sections_present "${status_output}" "status"

    if [[ "${TARGET_DEPLOYMENT_STATE:-}" == PRE_DEPLOY ]]; then
        log "status healthy assertion: DEFERRED (pre-deploy: 'Status: healthy' requires a deployed release; the no-release 'Status: unhealthy' output is the expected shape)"
        return 0
    fi

    grep -Fxq 'Status: healthy' <<<"${status_output}" \
        || fail "status output does not report 'Status: healthy'"
    log "status reports Status: healthy"
}

verify_planned_target_rejected() {
    # See the matching comment in verify_staged_candidates and on_apply_error:
    # this expected failure is safe to run inside a plain command
    # substitution — the main-process-only guard on the active trap handler
    # (on_apply_error during apply, on_verify_error during --verify) means it
    # can never be mistaken for a fatal one from inside the subshell.
    local planned_output
    if planned_output="$(no_overrides_env "${DST_HEALTH_CHECK}" --target tits-guru 2>&1)"; then
        fail "installed health-check --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
    grep -q 'lifecycle=planned' <<<"${planned_output}" \
        || fail "installed health-check --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${planned_output}"
    log "health-check --target tits-guru: correctly rejected (lifecycle=planned)"
}

# cleanup --dry-run only, exactly like verify_staged_candidates above —
# dry-run makes no changes to the real target, so this genuinely proves the
# installed cleanup runs cleanly against the real host without risking it.
verify_cleanup_dry_run() {
    local output
    output="$(no_overrides_env "${DST_CLEANUP}" --target staging-main --dry-run 2>&1)" \
        || fail "installed cleanup --target staging-main --dry-run failed:"$'\n'"${output}"
    log "cleanup --target staging-main --dry-run: OK"
}

verify_cleanup_planned_target_rejected() {
    local planned_output
    if planned_output="$(no_overrides_env "${DST_CLEANUP}" --target tits-guru --dry-run 2>&1)"; then
        fail "installed cleanup --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
    fi
