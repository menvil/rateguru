# The five restore primitives, --help and the tits-guru lifecycle
# rejection only — never a real fetch, verification, stage, activation or
# restore. A real invocation would download a backup, create a temporary
# database, quiesce the target and swap its live data; none of that belongs
# in an installer's verification pass. This installer's own --apply/--verify
# always run as root already, so each script's own require_root passes here
# exactly as it would in production.
#
# Driven from one table rather than ten near-identical function pairs: these
# five share a single contract (root -> lifecycle rejection -> no workspace,
# no download, no database), and ten copies of the same six lines is exactly
# the duplication this bundle keeps eliminating elsewhere.
RESTORE_PRIMITIVE_CHECKS=(
    "fetch-backup|--source|local|--backup|20260101-000000"
    "verify-backup|--operation|20260101-000000-abcdef"
    "restore-database|--operation|20260101-000000-abcdef|--stage"
    "restore-storage|--operation|20260101-000000-abcdef|--stage"
    "restore-target|--apply|--source|local|--backup|20260101-000000"
)

restore_primitive_path() {
    case "$1" in
        fetch-backup)     printf '%s\n' "${DST_FETCH_BACKUP}" ;;
        verify-backup)    printf '%s\n' "${DST_VERIFY_BACKUP}" ;;
        restore-database) printf '%s\n' "${DST_RESTORE_DATABASE}" ;;
        restore-storage)  printf '%s\n' "${DST_RESTORE_STORAGE}" ;;
        restore-target)   printf '%s\n' "${DST_RESTORE_TARGET}" ;;
        *) fail "unknown restore primitive: $1" ;;
    esac
}

verify_restore_primitive_help() {
    local entry label path usage_output

    for entry in "${RESTORE_PRIMITIVE_CHECKS[@]}"; do
        label="${entry%%|*}"
        path="$(restore_primitive_path "${label}")"

        usage_output="$(no_overrides_env "${path}" --help 2>&1)" \
            || fail "installed ${label} --help failed"

        grep -Fq -- '--target' <<<"${usage_output}" \
            || fail "installed ${label} usage does not document --target: ${usage_output}"

        if grep -Fq -- '--environment' <<<"${usage_output}"; then
            fail "installed ${label} usage mentions the removed --environment selector"
        fi

        log "${label} --help: OK"
    done
}

# Deliberately unusable-but-complete arguments: a rejection can then only come
# from the lifecycle gate, never from a missing flag, a malformed backup ID or
# a workspace that does not exist — the same ordering proof
# verify_deploy_planned_target_rejected makes for deploy.
verify_restore_primitive_planned_target_rejected() {
    local entry label path planned_output
    local -a fields=() extra_args=()

    for entry in "${RESTORE_PRIMITIVE_CHECKS[@]}"; do
        IFS='|' read -r -a fields <<<"${entry}"
        label="${fields[0]}"
        extra_args=("${fields[@]:1}")
        path="$(restore_primitive_path "${label}")"

        if planned_output="$(no_overrides_env "${path}" --target tits-guru "${extra_args[@]}" 2>&1)"; then
            fail "installed ${label} --target tits-guru unexpectedly succeeded — tits-guru must stay rejected"
        fi

        grep -q 'lifecycle=planned' <<<"${planned_output}" \
            || fail "installed ${label} --target tits-guru failed for the wrong reason (expected lifecycle=planned): ${planned_output}"

        log "${label} --target tits-guru: correctly rejected (lifecycle=planned)"
    done
}

# deploy invokes the installed verify-required-clis by absolute path on every
# deployment, before current is ever switched, so "it is installed and it
# runs" is a deployment prerequisite rather than a nicety. There is no
# planned-target counterpart: this script is not target-aware.
verify_required_clis_help() {
    local usage_output
    usage_output="$(no_overrides_env "${DST_VERIFY_REQUIRED_CLIS}" --help 2>&1)" \
        || fail "installed verify-required-clis --help failed"
    grep -q -- '--release-root' <<<"${usage_output}" \
        || fail "installed verify-required-clis usage does not document --release-root: ${usage_output}"
    log "verify-required-clis --help: OK"
}

# Thin wrapper used by apply's post-install check, which wants one pass/fail
# outcome rather than the phase-by-phase banners --verify prints — see
# run_verify below, which calls the same functions individually.
verify_runtime_parity() {
    log "verifying runtime behaviour against the real host (no test overrides)"
    verify_target_health
    verify_status
    verify_planned_target_rejected
    verify_cleanup_dry_run
    verify_cleanup_planned_target_rejected
    verify_deploy_help
    verify_deploy_planned_target_rejected
    verify_rollback_help
    verify_rollback_planned_target_rejected
    verify_backup_help
    verify_backup_planned_target_rejected
    verify_restore_test_help
    verify_restore_test_planned_target_rejected
    verify_offsite_backup_help
    verify_offsite_backup_planned_target_rejected
    verify_offsite_retention_help
    verify_offsite_retention_planned_target_rejected
    verify_offsite_restore_test_help
    verify_offsite_restore_test_planned_target_rejected
    verify_backup_cycle_help
    verify_backup_cycle_planned_target_rejected
    verify_restore_primitive_help
    verify_restore_primitive_planned_target_rejected
    verify_required_clis_help
    log "runtime parity verification passed"
}

# --- runtime verification (end) ---

# --- Modes ----------------------------------------------------------------

run_check() {
    log "mode: check (read-only, no root required)"

    run_source_validation

    log "destinations are fixed constants:"
    log "  ${DST_REGISTRY}"
    log "  ${DST_TARGETS}"
    log "  ${DST_COMMON}"
    log "  ${DST_HEALTH_CHECK}"
    log "  ${DST_STATUS}"
    log "  ${DST_CLEANUP}"
    log "  ${DST_DEPLOY}"
    log "  ${DST_ROLLBACK}"
    log "  ${DST_BACKUP}"
    log "  ${DST_RESTORE_TEST}"
    log "  ${DST_OFFSITE_BACKUP}"
    log "  ${DST_OFFSITE_RETENTION}"
    log "  ${DST_OFFSITE_RESTORE_TEST}"
    log "  ${DST_BACKUP_CYCLE}"
    log "  ${DST_RESTORE_COMMON}"
    log "  ${DST_FETCH_BACKUP}"
    log "  ${DST_VERIFY_BACKUP}"
    log "  ${DST_RESTORE_DATABASE}"
    log "  ${DST_RESTORE_STORAGE}"
    log "  ${DST_RESTORE_TARGET}"
    log "  ${DST_VERIFY_REQUIRED_CLIS}"
    log "  ${DST_DEPLOYMENT_CONF}"

    log "check passed: source files, host tooling and registry are valid"
}

# The two directories every one of the twenty-two destinations lives under.
# This installer owns exactly twenty-two *files* — it never creates, chowns or chmods
# either directory. Both must already exist, safely, before --apply is
# allowed to do anything else; a missing or unsafe directory aborts here,
# before the backup directory is created or any destination is touched.
validate_destination_directory() {
    local dir="$1"

    [[ -e "${dir}" ]] || fail "destination directory is missing: ${dir} (this installer never creates it)"
    [[ ! -L "${dir}" ]] || fail "destination directory must not be a symlink: ${dir}"
    [[ -d "${dir}" ]] || fail "destination path must be a directory: ${dir}"

    local owner
    owner="$(stat -c '%u:%g' "${dir}")"
    [[ "${owner}" == "${INSTALL_OWNER_ID}:${INSTALL_GROUP_ID}" ]] \
        || fail "destination directory must be owned by root:root, is ${owner}: ${dir}"

    local mode
    mode="$(stat -c '%a' "${dir}")"
    if (( (8#${mode} & 8#022) != 0 )); then
        fail "destination directory must not be group- or other-writable (mode ${mode}): ${dir}"
    fi

    [[ -w "${dir}" ]] || fail "destination directory is not writable, cannot install into it: ${dir}"
    [[ -x "${dir}" ]] || fail "destination directory is not searchable (missing execute bit): ${dir}"
}

validate_destination_directories() {
    validate_destination_directory "${DST_CONFIG_ROOT}"
    validate_destination_directory "${DST_BIN_ROOT}"
    log "destination directories exist, are root-owned, non-writable-by-others directories (unchanged by this installer)"
}

# --- Restore serialization (apply mode only) --------------------------------
#
# `restore-target` holds `<run root>/restore-target-<namespace>.lock` for the
# whole of a live data restore. This installer replaces the bundle file by
# file, so an --apply that overlapped a running restore could hand that
# Restore a mismatched pair of Restore Target Data scripts halfway through — a
# restore-target from one revision driving a restore-database from another.
#
# So --apply takes the SAME lock, for every active target's backup namespace,
# before it validates destinations or touches anything, and holds it for the
# rest of the run (the file descriptors stay open until this process exits).
# It is never a new, incompatible lock: two targets sharing a backup namespace
# resolve to the identical file, exactly as every backup-path script already
# does.
#
# Deliberately non-blocking and fail-closed. A restore is a long, destructive
# operation an operator is watching; queueing an installer behind it silently
# would be worse than telling them to wait.
#
# Lock ordering: restore-target takes this lock first, then the target
# deployment lock, then the backup lock. This installer takes only this one,
# so no cycle is possible.
RESTORE_LOCK_FDS=()

active_backup_namespaces() {
    jq -r '
        .targets
        | to_entries
        | map(select(.value.lifecycle == "active") | .value.backup.namespace)
        | unique
        | .[]
    ' "${SRC_REGISTRY}"
}

acquire_restore_locks() {
    # A run root that does not exist is a host on which no operational script
    # has ever run, so no restore can be in flight. This installer creates no
    # directories — that is the bootstrap layout installer's job — so it does
    # not conjure one here just to lock inside it.
    if [[ ! -d "${OPERATIONAL_RUN_ROOT}" ]]; then
        log "no operational run root at ${OPERATIONAL_RUN_ROOT} — no restore can be in flight"

        return 0
    fi

    local namespace lock_file lock_fd

    while IFS= read -r namespace; do
        [[ -n "${namespace}" ]] || continue

        lock_file="${OPERATIONAL_RUN_ROOT}/restore-target-${namespace}.lock"

        exec {lock_fd}>"${lock_file}" \
            || fail "could not open the restore lock for backup namespace ${namespace}: ${lock_file}"

        if ! flock -n "${lock_fd}"; then
            fail "a restore is running for backup namespace ${namespace} — refusing to replace the operational bundle underneath it (${lock_file})"
        fi

        RESTORE_LOCK_FDS+=("${lock_fd}")
        log "  restore lock held for backup namespace ${namespace}"
    done < <(active_backup_namespaces)

    log "no restore is in flight for any active target's backup namespace"
}

verify_preflight_target_health() {
    # PRE_DEPLOY: there is no installed application to be healthy yet — the
    # preflight health gate is deferred (logged, never faked). A BROKEN
    # current already failed classify_staging_deployment_state before this
    # runs, so this deferral can never mask a broken deployment.
    if [[ "${TARGET_DEPLOYMENT_STATE:-}" == PRE_DEPLOY ]]; then
        log "currently installed staging-main health check: DEFERRED (pre-deploy: no current release exists yet)"
        return 0
    fi

    no_overrides_env "${DST_HEALTH_CHECK}" --target staging-main >/dev/null \
        || fail "currently installed staging-main health check failed — refusing to install anything (${DST_HEALTH_CHECK} --target staging-main)"
    log "currently installed staging-main health check: OK"
}

APPLY_COMMITTED=false
STAGE_DIR=""

# set -E means every ERR/EXIT trap armed below is inherited by every $(...)
# command substitution's subshell for as long as it stays armed — including
# ones whose command can genuinely, unexpectedly fail (not just the
# deliberately-failing tits-guru checks). Without this guard, an ordinary
# failure inside any command substitution after files are installed would
# run rollback twice: once prematurely inside that subshell, and once more
# when the real failure reaches this same trap in the main process. Recording
# the main process's BASHPID before arming the trap, and comparing against it
# here, makes every invocation of this handler outside the main process a
# silent, side-effect-free `exit` — the main process's own copy of this trap
# still fires for the real failure and does the actual work exactly once.
# This is deliberately generic: no individual command substitution needs its
# own `trap - ERR EXIT`.
MAIN_BASHPID=""

on_apply_error() {
    local code=$?
    trap - ERR EXIT

    if [[ "${BASHPID}" != "${MAIN_BASHPID}" ]]; then
        exit "${code}"
    fi

    log "apply failed (exit ${code})"

    if [[ "${APPLY_COMMITTED}" == false ]] && [[ -n "${BACKUP_DIR}" ]]; then
        if rollback_installed_files; then
            log "rollback complete: previous files restored"
            if [[ "${TARGET_DEPLOYMENT_STATE:-}" == PRE_DEPLOY ]]; then
                log "post-rollback staging-main health check: DEFERRED (pre-deploy: no current release exists yet)"
            elif no_overrides_env "${DST_HEALTH_CHECK}" --target staging-main >/dev/null 2>&1; then
                log "confirmed: staging-main health check still succeeds after rollback"
            else
                log "ERROR: staging-main health check FAILED even after rollback — manual intervention required"
            fi
        else
            log "ERROR: rollback INCOMPLETE — some files may not have been restored"
            log "backups remain in ${BACKUP_DIR} for manual recovery"
        fi
    fi

    [[ -z "${STAGE_DIR}" ]] || rm -rf "${STAGE_DIR}"

    exit "${code}"
}

run_apply() {
    require_root
    perform_apply
}

# Split from run_apply() solely so tests can exercise the transactional
# install/rollback logic directly, against reassigned DST_*/SRC_*/BACKUP_ROOT
# scratch paths, without needing to run as root. Production always reaches
# this through run_apply, so require_root is still enforced on every real
# invocation.
perform_apply() {
    # Reset every piece of per-run transactional state up front. In
    # production this function only ever runs once per process, but it must
    # not depend on that: a second direct call in the same shell (as tests
    # do) would otherwise inherit BACKUP_DIR, ROLLBACK_RESTORE/REMOVE and
    # APPLY_COMMITTED left over from a prior run — at best stale, at worst
    # causing a later failure to "roll back" files a previous, already-
    # committed run legitimately installed.
    BACKUP_DIR=""
    ROLLBACK_RESTORE=()
    ROLLBACK_REMOVE=()
    APPLY_COMMITTED=false

    log "mode: apply"

    RESTORE_LOCK_FDS=()

    run_source_validation
    classify_staging_deployment_state
    acquire_restore_locks
    validate_destination_directories
    verify_preflight_target_health

    # The ERR/EXIT trap is armed from here on, so stage_dir is cleaned up (and,
    # once BACKUP_DIR exists below, any already-touched destination is rolled
    # back) on every exit path from this point forward — success or failure.
    MAIN_BASHPID="${BASHPID}"
    trap on_apply_error ERR EXIT

    STAGE_DIR="$(mktemp -d)"
    install -m 0700 "${SRC_REGISTRY}" "${STAGE_DIR}/deployment-targets.json"
    install -m 0700 "${SRC_TARGETS}" "${STAGE_DIR}/targets"
    install -m 0700 "${SRC_COMMON}" "${STAGE_DIR}/common"
    install -m 0700 "${SRC_HEALTH_CHECK}" "${STAGE_DIR}/health-check"
    install -m 0700 "${SRC_STATUS}" "${STAGE_DIR}/status"
    install -m 0700 "${SRC_CLEANUP}" "${STAGE_DIR}/cleanup"
    install -m 0700 "${SRC_DEPLOY}" "${STAGE_DIR}/deploy"
    install -m 0700 "${SRC_ROLLBACK}" "${STAGE_DIR}/rollback"
    install -m 0700 "${SRC_BACKUP}" "${STAGE_DIR}/backup"
    install -m 0700 "${SRC_RESTORE_TEST}" "${STAGE_DIR}/restore-test"
    install -m 0700 "${SRC_OFFSITE_BACKUP}" "${STAGE_DIR}/offsite-backup"
    install -m 0700 "${SRC_OFFSITE_RETENTION}" "${STAGE_DIR}/offsite-retention"
    install -m 0700 "${SRC_OFFSITE_RESTORE_TEST}" "${STAGE_DIR}/offsite-restore-test"
    install -m 0700 "${SRC_BACKUP_CYCLE}" "${STAGE_DIR}/backup-cycle"
    install -m 0700 "${SRC_RESTORE_COMMON}" "${STAGE_DIR}/restore-common"
    install -m 0700 "${SRC_FETCH_BACKUP}" "${STAGE_DIR}/fetch-backup"
    install -m 0700 "${SRC_VERIFY_BACKUP}" "${STAGE_DIR}/verify-backup"
    install -m 0700 "${SRC_RESTORE_DATABASE}" "${STAGE_DIR}/restore-database"
    install -m 0700 "${SRC_RESTORE_STORAGE}" "${STAGE_DIR}/restore-storage"
    install -m 0700 "${SRC_RESTORE_TARGET}" "${STAGE_DIR}/restore-target"
    install -m 0700 "${SRC_VERIFY_REQUIRED_CLIS}" "${STAGE_DIR}/verify-required-clis"
    install -m 0700 "${SRC_DEPLOYMENT_CONF}" "${STAGE_DIR}/deployment.conf"

    verify_staged_candidates "${STAGE_DIR}"

    BACKUP_DIR="${BACKUP_ROOT}/$(date -u '+%Y%m%dT%H%M%SZ')"
    install -d -m 0700 "${BACKUP_ROOT}"
    install -d -m 0700 "${BACKUP_DIR}"
    log "backups for this run: ${BACKUP_DIR}"

    # Dependency-safe order: the registry before anything that reads it, the
    # targets validator before common (which invokes it), common before the
    # sixteen scripts that source it (health-check, status, cleanup, deploy,
    # rollback, backup, restore-test, offsite-backup, offsite-retention,
    # offsite-restore-test, backup-cycle, fetch-backup, verify-backup,
    # restore-database, restore-storage, restore-target), restore-common
    # before the five restore primitives that source it in turn, and the
    # host-global deployment.conf last — every script sourcing it either
    # atomically sees the old config or the new one, never a half-installed
    # bundle in between.
    install_regular_file_transactional "${STAGE_DIR}/deployment-targets.json" "${DST_REGISTRY}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${REGISTRY_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/targets" "${DST_TARGETS}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/common" "${DST_COMMON}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${COMMON_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/health-check" "${DST_HEALTH_CHECK}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/status" "${DST_STATUS}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/cleanup" "${DST_CLEANUP}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/deploy" "${DST_DEPLOY}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/rollback" "${DST_ROLLBACK}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/backup" "${DST_BACKUP}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/restore-test" "${DST_RESTORE_TEST}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/offsite-backup" "${DST_OFFSITE_BACKUP}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/offsite-retention" "${DST_OFFSITE_RETENTION}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/offsite-restore-test" "${DST_OFFSITE_RESTORE_TEST}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/backup-cycle" "${DST_BACKUP_CYCLE}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/restore-common" "${DST_RESTORE_COMMON}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${COMMON_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/fetch-backup" "${DST_FETCH_BACKUP}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/verify-backup" "${DST_VERIFY_BACKUP}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/restore-database" "${DST_RESTORE_DATABASE}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/restore-storage" "${DST_RESTORE_STORAGE}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/restore-target" "${DST_RESTORE_TARGET}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/verify-required-clis" "${DST_VERIFY_REQUIRED_CLIS}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${CLI_MODE}"
    install_regular_file_transactional "${STAGE_DIR}/deployment.conf" "${DST_DEPLOYMENT_CONF}" "${INSTALL_OWNER}" "${INSTALL_GROUP}" "${DEPLOYMENT_CONF_MODE}"

    log "files installed; verifying before committing"

    verify_installed_files
    verify_runtime_parity

    APPLY_COMMITTED=true
    trap - ERR EXIT
    rm -rf "${STAGE_DIR}"

    log "apply complete"
    log "  registry     : ${DST_REGISTRY}"
    log "  scripts      : ${DST_TARGETS}, ${DST_COMMON}, ${DST_RESTORE_COMMON}, ${DST_HEALTH_CHECK}, ${DST_STATUS}, ${DST_CLEANUP}, ${DST_DEPLOY}, ${DST_ROLLBACK}, ${DST_BACKUP}, ${DST_RESTORE_TEST}, ${DST_OFFSITE_BACKUP}, ${DST_OFFSITE_RETENTION}, ${DST_OFFSITE_RESTORE_TEST}, ${DST_BACKUP_CYCLE}, ${DST_FETCH_BACKUP}, ${DST_VERIFY_BACKUP}, ${DST_RESTORE_DATABASE}, ${DST_RESTORE_STORAGE}, ${DST_RESTORE_TARGET}, ${DST_VERIFY_REQUIRED_CLIS}"
    log "  deployment.conf: ${DST_DEPLOYMENT_CONF}"
    log "  backups      : ${BACKUP_DIR}"
    log "Run 'install-target-operations --verify' at any time to re-check the installed result."
}

on_verify_error() {
    local code=$?
    trap - ERR EXIT

    # See the comment above on_apply_error: the same subshell-inheritance
    # hazard applies here, so the same main-process-only guard applies too —
    # otherwise a genuine failure could print the final FAIL banner once from
    # a subshell and once more from the main process.
    if [[ "${BASHPID}" != "${MAIN_BASHPID}" ]]; then
        exit "${code}"
    fi

    log "--- final result ---"
    log "FAIL: verification did not pass (see the error above)"
    exit "${code}"
}

run_verify() {
    require_root
    perform_verify
}

# Split from run_verify() for the same reason as perform_apply() above.
perform_verify() {
    log "mode: verify (no changes, no backup)"

    MAIN_BASHPID="${BASHPID}"
    trap on_verify_error ERR EXIT

    log "--- source validation ---"
    run_source_validation

    log "--- target deployment state ---"
    classify_staging_deployment_state

    log "--- installed-file validation ---"
    verify_installed_files

    log "--- staging-main health ---"
    verify_target_health

    log "--- status ---"
    verify_status

    log "--- planned-target rejection ---"
    verify_planned_target_rejected

    log "--- cleanup dry-run ---"
    verify_cleanup_dry_run

    log "--- cleanup planned-target rejection ---"
    verify_cleanup_planned_target_rejected

    log "--- deploy help ---"
    verify_deploy_help

    log "--- deploy planned-target rejection ---"
    verify_deploy_planned_target_rejected

    log "--- rollback help ---"
    verify_rollback_help

    log "--- rollback planned-target rejection ---"
    verify_rollback_planned_target_rejected

    log "--- backup help ---"
    verify_backup_help

    log "--- backup planned-target rejection ---"
    verify_backup_planned_target_rejected

    log "--- restore-test help ---"
    verify_restore_test_help

    log "--- restore-test planned-target rejection ---"
    verify_restore_test_planned_target_rejected

    log "--- offsite-backup help ---"
    verify_offsite_backup_help

    log "--- offsite-backup planned-target rejection ---"
    verify_offsite_backup_planned_target_rejected

    log "--- offsite-retention help ---"
    verify_offsite_retention_help

    log "--- offsite-retention planned-target rejection ---"
    verify_offsite_retention_planned_target_rejected

    log "--- offsite-restore-test help ---"
    verify_offsite_restore_test_help

    log "--- offsite-restore-test planned-target rejection ---"
    verify_offsite_restore_test_planned_target_rejected

    log "--- backup-cycle help ---"
    verify_backup_cycle_help

    log "--- backup-cycle planned-target rejection ---"
    verify_backup_cycle_planned_target_rejected

    log "--- restore primitive help ---"
    verify_restore_primitive_help

    log "--- restore primitive planned-target rejection ---"
    verify_restore_primitive_planned_target_rejected

    log "--- verify-required-clis help ---"
    verify_required_clis_help

    trap - ERR EXIT
    log "--- final result ---"
    log "PASS: installed files and runtime behaviour verified"
}

parse_mode_args "$@"

case "${MODE}" in
    check)
        run_check
        ;;
    apply)
        run_apply
        ;;
    verify)
        run_verify
        ;;
esac
