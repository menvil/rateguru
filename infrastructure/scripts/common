#!/usr/bin/env bash

set -Eeuo pipefail

# RATEGURU_DEPLOYMENT_CONF_FILE is only honored alongside
# RATEGURU_ALLOW_TEST_OVERRIDES=true — a stray environment variable surviving
# in a real root shell (a leftover export, a shared profile) can never
# silently redirect this privileged `source` at an attacker- or
# operator-controlled file. This is a plain inline condition rather than a
# call to a shared function: no function this file defines exists yet at this
# point in its own execution (function definitions run in order, same as
# anything else in a sourced file), so there is nothing to call. The identical
# check is reused, as an actual function, further down for
# RATEGURU_TARGET_REGISTRY_FILE and RATEGURU_TARGETS_CLI, where that ordering
# problem does not apply.
CONFIG_FILE_DEFAULT="/home/www/rateguru/config/deployment.conf"

if [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]] \
    && [[ -n "${RATEGURU_DEPLOYMENT_CONF_FILE:-}" ]]
then
    CONFIG_FILE="${RATEGURU_DEPLOYMENT_CONF_FILE}"
else
    CONFIG_FILE="${CONFIG_FILE_DEFAULT}"
fi

if [[ ! -r "${CONFIG_FILE}" ]]; then
    echo "ERROR: deployment configuration is unavailable: ${CONFIG_FILE}" >&2
    exit 1
fi

if [[ ! -f "${CONFIG_FILE}" ]] || [[ -L "${CONFIG_FILE}" ]]; then
    echo "ERROR: deployment configuration must be a regular file: ${CONFIG_FILE}" >&2
    exit 1
fi

# Ownership and mode are only demanded of the installed default, exactly like
# the target registry's own usability check — an explicit test fixture works
# without root.
if [[ "${CONFIG_FILE}" == "${CONFIG_FILE_DEFAULT}" ]]; then
    if [[ "$(stat -c '%u:%g' "${CONFIG_FILE}")" != "0:0" ]]; then
        echo "ERROR: deployment configuration must be owned by root:root: ${CONFIG_FILE}" >&2
        exit 1
    fi

    CONFIG_MODE="$(stat -c '%a' "${CONFIG_FILE}")"

    if (( (8#${CONFIG_MODE} & 8#022) != 0 )); then
        echo "ERROR: deployment configuration must not be group- or other-writable: ${CONFIG_FILE}" >&2
        exit 1
    fi
fi

# shellcheck disable=SC1090
source "${CONFIG_FILE}"

log() {
    printf '[%s] %s\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        "$*"
}

fail() {
    log "ERROR: $*" >&2
    exit 1
}

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        fail "this command must be executed as root"
    fi
}

validate_release_id() {
    local release_id="$1"

    if [[ ! "${release_id}" =~ ${RELEASE_ID_REGEX} ]]; then
        fail "invalid release ID: ${release_id}"
    fi
}

acquire_deployment_lock() {
    local application_root="$1"

    exec 200>"${application_root}/locks/deployment.lock"

    if ! flock -n 200; then
        fail "another deployment operation is already running"
    fi
}

append_history() {
    local application_root="$1"
    local event="$2"
    local release_id="${3:-null}"
    local status="${4:-unknown}"

    printf \
        '{"timestamp":"%s","event":"%s","release":"%s","status":"%s","user":"%s"}\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        "${event}" \
        "${release_id}" \
        "${status}" \
        "${SUDO_USER:-$(id -un)}" \
        >> "${application_root}/deployments/history.jsonl"
}

# Shared, strict backup-manifest schema classifier for offsite-backup and
# offsite-restore-test. infrastructure/scripts/restore-test (local
# restore-test) established this exact contract inline, independently, and
# does not call this function — but the contract must stay identical, so it
# is extracted here rather than re-derived with different semantics per
# caller.
#
# Never classify by `jq -r '.manifest_schema_version // empty'` alone: raw
# output loses JSON type, so a schema_version of 3, 0, the JSON *string* "2"
# (not a number), "garbage", an array, an object or a boolean would all
# compare unequal to the literal string "2" and silently pass as legacy
# schema 1 (fail-open). `type` disambiguates first.
#
# Prints exactly one of:
#   schema1        - the field is absent or JSON null
#   schema2        - the field is a JSON number equal to 2
#   invalid:<value> - anything else, with the offending value's own JSON
#                     representation appended (quoted for a string, compact
#                     for an array/object) — callers turn this into their own
#                     `fail "unsupported backup manifest schema_version: ..."`
#
# Never calls fail itself, and has no dependency on any target-resolved
# variable (ENVIRONMENT_CLASS, BACKUP_NAMESPACE, TARGET_ID, ...) — safe to
# call before those exist.
manifest_schema_classify() {
    local manifest_path="$1"
    local manifest_schema_type
    manifest_schema_type="$(jq -r '.manifest_schema_version | type' "${manifest_path}")"

    case "${manifest_schema_type}" in
        null)
            printf 'schema1\n'
            ;;
        number)
            local manifest_schema_version
            manifest_schema_version="$(jq -r '.manifest_schema_version' "${manifest_path}")"

            if [[ "${manifest_schema_version}" == "2" ]]; then
                printf 'schema2\n'
            else
                printf 'invalid:%s\n' "${manifest_schema_version}"
            fi
            ;;
        *)
            local manifest_schema_value
            manifest_schema_value="$(jq -c '.manifest_schema_version' "${manifest_path}")"
            printf 'invalid:%s\n' "${manifest_schema_value}"
            ;;
    esac
}

# Shared manifest validator for offsite-backup and offsite-restore-test —
# both scripts had this exact, byte-identical implementation; extracted here
# to remove the duplication. infrastructure/scripts/restore-test (local
# restore-test) has a materially different contract (it also checks
# `database` against its own independently resolved database name) and
# stays untouched — this function is never called by it.
#
# Runs before any rclone command — checksum validation only proves the
# selected backup's own files are internally consistent; this proves the
# backup actually belongs to the resolved target. Operates on
# ENVIRONMENT_CLASS, BACKUP_NAMESPACE and TARGET_ID, set by the caller's own
# resolve_* step before this runs — same convention as require_active_target
# and parse_target_args below.
#
# A schema 2 manifest whose own target field is absent or JSON null (every
# manifest produced before this cutover, when the operational selector was
# not yet target-only) is accepted without a target comparison — historical
# manifest content is immutable and stays restorable. An explicit empty
# string is not treated the same as absent: it is rejected outright, the
# same way an unexpected type is, since a real manifest this script writes
# itself never produces one.
validate_backup_manifest() {
    local manifest_path="$1"

    [[ -f "${manifest_path}" ]] || fail "backup manifest is missing: ${manifest_path}"

    local manifest_project manifest_environment manifest_database

    manifest_project="$(jq -r '.project // empty' "${manifest_path}")"
    manifest_environment="$(jq -r '.environment // empty' "${manifest_path}")"
    manifest_database="$(jq -r '.database // empty' "${manifest_path}")"

    [[ "${manifest_project}" == "rateguru" ]] \
        || fail "backup manifest project mismatch: expected rateguru, got '${manifest_project}'"

    [[ "${manifest_environment}" == "${ENVIRONMENT_CLASS}" ]] \
        || fail "backup manifest environment mismatch: expected ${ENVIRONMENT_CLASS}, got '${manifest_environment}'"

    [[ -n "${manifest_database}" ]] \
        || fail "backup manifest database is missing or empty"

    local manifest_schema_status
    manifest_schema_status="$(manifest_schema_classify "${manifest_path}")"

    case "${manifest_schema_status}" in
        schema1)
            ;;
        schema2)
            local manifest_backup_namespace
            manifest_backup_namespace="$(jq -r '.backup_namespace // empty' "${manifest_path}")"

            [[ "${manifest_backup_namespace}" == "${BACKUP_NAMESPACE}" ]] \
                || fail "backup manifest backup_namespace mismatch: expected ${BACKUP_NAMESPACE}, got '${manifest_backup_namespace}'"

            local manifest_target_type
            manifest_target_type="$(jq -r '.target | type' "${manifest_path}")"

            case "${manifest_target_type}" in
                null)
                    # Absent or explicit JSON null — a schema 2 manifest
                    # predating the target-only cutover; no target to compare.
                    ;;
                string)
                    local manifest_target
                    manifest_target="$(jq -r '.target' "${manifest_path}")"

                    [[ -n "${manifest_target}" ]] \
                        || fail "backup manifest target is an empty string"

                    [[ "${manifest_target}" == "${TARGET_ID}" ]] \
                        || fail "backup manifest target mismatch: expected ${TARGET_ID}, got '${manifest_target}'"
                    ;;
                *)
                    local manifest_target_value
                    manifest_target_value="$(jq -c '.target' "${manifest_path}")"
                    fail "backup manifest target has unexpected type: ${manifest_target_value}"
                    ;;
            esac
            ;;
        invalid:*)
            fail "unsupported backup manifest schema_version: ${manifest_schema_status#invalid:}"
            ;;
    esac
}

# --- deployment target registry (begin) ---
#
# Read-only accessors over the non-secret target registry.
#
# Nothing below runs at source time. The registry is read only when a target_*
# helper is actually called, so scripts installed before the registry exists —
# every operational script today — keep working untouched. Sourcing common must
# never fail merely because the registry is absent.
#
# The registry is data, never code: it is parsed with jq and never sourced,
# eval'd or substituted into a shell command. Target IDs reach jq through --arg
# only, never by string concatenation into a jq program.

TARGET_REGISTRY_DEFAULT_FILE="/home/www/rateguru/config/deployment-targets.json"
TARGET_REGISTRY_SCHEMA_VERSION=1

# Gates every RATEGURU_*_FILE / RATEGURU_*_CLI override below that could
# redirect a privileged script at an attacker- or operator-controlled file —
# the identical plain condition guards RATEGURU_DEPLOYMENT_CONF_FILE near the
# top of this file, before this block starts. Defined as a real function here
# (rather than inlined, as that one is) because it is called from multiple
# places below, and — unlike the top-of-file check — it has somewhere earlier
# in this same execution to have already been defined.
#
# This function lives inside the extractable block (between the begin/end
# markers) rather than at the top of the file, because tests exercise this
# block in isolation by extracting exactly the text between those markers —
# see tests/Feature/Architecture/DeploymentTargetRegistryTest.php's
# targetHelperHarness(). A definition outside the markers would not be part of
# what gets extracted, and target_registry_file()/target_registry_validator()
# below would fail to find it when tested that way.
rateguru_test_overrides_allowed() {
    [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]]
}

# One resolution contract, identical to scripts/targets (which layers --file on
# top as the most specific source):
#   1. RATEGURU_TARGET_REGISTRY_FILE — tests and controlled tooling, and only
#      when RATEGURU_ALLOW_TEST_OVERRIDES=true
#   2. TARGET_REGISTRY_FILE — set by the deployment.conf sourced above; no test
#      flag required, since honoring it requires deployment.conf to already
#      have loaded (from its own root-owned installed path, or from a fixture
#      that already required the same flag to be read at all)
#   3. TARGET_REGISTRY_DEFAULT_FILE
#
# `common` already sourced deployment.conf, so step 2 is a plain variable here.
# The CLI reaches the same value by parsing that file, because deployment.conf
# assigns without `export` and the value would not survive into a child process.
target_registry_file() {
    if rateguru_test_overrides_allowed && [[ -n "${RATEGURU_TARGET_REGISTRY_FILE:-}" ]]; then
        printf '%s\n' "${RATEGURU_TARGET_REGISTRY_FILE}"

        return 0
    fi

    if [[ -n "${TARGET_REGISTRY_FILE:-}" ]]; then
        printf '%s\n' "${TARGET_REGISTRY_FILE}"

        return 0
    fi

    printf '%s\n' "${TARGET_REGISTRY_DEFAULT_FILE}"
}

validate_target_id() {
    local target_id="${1-}"

    if [[ ! "${target_id}" =~ ^[a-z0-9][a-z0-9-]{1,31}$ ]]; then
        fail "invalid target ID: ${target_id}"
    fi
}

# Readable regular file, real JSON, schema we understand. When the registry is
# the installed runtime default we additionally demand root ownership and no
# group/other write, matching how deployment.conf is already protected. An
# explicitly pointed-at file (tests, repository checks) skips the ownership
# demand but is still never allowed to be a symlink.
target_registry_assert_usable() {
    local registry_file
    registry_file="$(target_registry_file)"

    if [[ -L "${registry_file}" ]]; then
        fail "target registry must not be a symlink: ${registry_file}"
    fi

    if [[ ! -e "${registry_file}" ]]; then
        fail "target registry is unavailable: ${registry_file}"
    fi

    if [[ ! -f "${registry_file}" ]]; then
        fail "target registry must be a regular file: ${registry_file}"
    fi

    if [[ ! -r "${registry_file}" ]]; then
        fail "target registry is not readable: ${registry_file}"
    fi

    if [[ "${registry_file}" == "${TARGET_REGISTRY_DEFAULT_FILE}" ]]; then
        if [[ "$(stat -c '%u:%g' "${registry_file}")" != "0:0" ]]; then
            fail "target registry must be owned by root:root: ${registry_file}"
        fi

        local registry_mode
        registry_mode="$(stat -c '%a' "${registry_file}")"

        if (( (8#${registry_mode} & 8#022) != 0 )); then
            fail "target registry must not be group- or other-writable: ${registry_file}"
        fi
    fi

    if ! jq -e 'type == "object"' "${registry_file}" >/dev/null 2>&1; then
        fail "target registry is not valid JSON: ${registry_file}"
    fi

    if ! jq -e --argjson expected "${TARGET_REGISTRY_SCHEMA_VERSION}" \
        '.schema_version == $expected' "${registry_file}" >/dev/null 2>&1
    then
        local found
        found="$(jq -r '.schema_version // "missing"' "${registry_file}" 2>/dev/null || printf 'unreadable')"

        fail "unsupported target registry schema_version: ${found} (expected ${TARGET_REGISTRY_SCHEMA_VERSION})"
    fi
}

# Locate the registry validator. It ships beside this file, so an installed
# common at /home/www/rateguru/bin/common finds /home/www/rateguru/bin/targets.
target_registry_validator() {
    if rateguru_test_overrides_allowed && [[ -n "${RATEGURU_TARGETS_CLI:-}" ]]; then
        printf '%s\n' "${RATEGURU_TARGETS_CLI}"

        return 0
    fi

    # BASH_SOURCE is unset when this block is evaluated outside a sourced file
    # (bash -c, tests), and `set -u` would abort on a bare reference.
    local own_source="${BASH_SOURCE[0]:-}"

    if [[ -n "${own_source}" ]]; then
        local own_dir
        own_dir="$(cd -- "$(dirname -- "${own_source}")" 2>/dev/null && pwd)" || own_dir=""

        if [[ -n "${own_dir}" ]] && [[ -x "${own_dir}/targets" ]]; then
            printf '%s\n' "${own_dir}/targets"

            return 0
        fi
    fi

    printf '%s\n' "/home/www/rateguru/bin/targets"
}

# Full registry validation — schema, required properties, semantics and
# cross-target collisions — run at most once per shell process.
#
# Without this, a helper would happily return one property while the rest of the
# same target was missing or malformed. Reading application_root must not
# succeed on a target whose database name or socket is invalid, because the
# caller will use both.
#
# The result is cached against the resolved path, so a script reading a dozen
# properties pays for validation once rather than a dozen times.
_TARGET_REGISTRY_VALIDATED_FILE=""

target_registry_assert_valid() {
    local registry_file
    registry_file="$(target_registry_file)"

    if [[ "${_TARGET_REGISTRY_VALIDATED_FILE}" == "${registry_file}" ]]; then
        return 0
    fi

    local validator
    validator="$(target_registry_validator)"

    if [[ ! -x "${validator}" ]]; then
        fail "target registry validator is unavailable: ${validator}"
    fi

    local output
    if ! output="$("${validator}" validate --file "${registry_file}" 2>&1)"; then
        fail "target registry failed validation: ${registry_file}"$'\n'"${output}"
    fi

    _TARGET_REGISTRY_VALIDATED_FILE="${registry_file}"
}

# Internal: presence lookup that assumes validate_target_id and
# target_registry_assert_usable have already run. Callers that have done both
# use this instead of target_exists, so the registry is not re-stat'ed and its
# schema not re-checked once per property access.
_target_present() {
    local target_id="$1"
    local registry_file="$2"

    jq -e --arg id "${target_id}" \
        '(.targets | type == "object") and (.targets | has($id))' \
        "${registry_file}" >/dev/null 2>&1
}

target_exists() {
    local target_id="${1-}"

    validate_target_id "${target_id}"
    target_registry_assert_usable
    target_registry_assert_valid

    _target_present "${target_id}" "$(target_registry_file)"
}

# Whole normalized target object, key-sorted so output is deterministic.
target_get() {
    local target_id="${1-}"

    validate_target_id "${target_id}"
    target_registry_assert_usable
    target_registry_assert_valid

    local registry_file
    registry_file="$(target_registry_file)"

    if ! _target_present "${target_id}" "${registry_file}"; then
        fail "unknown target: ${target_id}"
    fi

    jq -S -e --arg id "${target_id}" '.targets[$id]' "${registry_file}" \
        || fail "unable to read target: ${target_id}"
}

# Internal: fetch one property by jq path, refusing null/empty results so a
# missing or mistyped field is an error rather than a silent empty string.
_target_property() {
    local target_id="$1"
    local jq_path="$2"
    local expected_type="$3"

    validate_target_id "${target_id}"
    target_registry_assert_usable
    target_registry_assert_valid

    local registry_file
    registry_file="$(target_registry_file)"

    if ! _target_present "${target_id}" "${registry_file}"; then
        fail "unknown target: ${target_id}"
    fi

    local value
    if ! value="$(jq -e -r --arg id "${target_id}" \
        "(.targets[\$id] | ${jq_path}) as \$v
         | if (\$v | type) != \"${expected_type}\" then error(\"type\") else \$v end" \
        "${registry_file}" 2>/dev/null)"
    then
        fail "target ${target_id} is missing a valid ${jq_path} (expected ${expected_type})"
    fi

    if [[ "${expected_type}" == "string" ]] && [[ -z "${value}" ]]; then
        fail "target ${target_id} has an empty ${jq_path}"
    fi

    printf '%s\n' "${value}"
}

target_lifecycle()                { _target_property "${1-}" '.lifecycle' string; }
target_environment_class()        { _target_property "${1-}" '.environment_class' string; }
target_root()                     { _target_property "${1-}" '.application_root' string; }
target_runtime_user()             { _target_property "${1-}" '.runtime_user' string; }
target_runtime_group()            { _target_property "${1-}" '.runtime_group' string; }
target_deploy_user()              { _target_property "${1-}" '.deploy_user' string; }
target_code_group()               { _target_property "${1-}" '.code_group' string; }
target_incoming_artifacts()       { _target_property "${1-}" '.incoming_artifacts' string; }
target_release_retention()        { _target_property "${1-}" '.release_retention' number; }
target_database_name()            { _target_property "${1-}" '.database.name' string; }
target_database_role()            { _target_property "${1-}" '.database.application_role' string; }
target_health_url()               { _target_property "${1-}" '.health.url' string; }
target_health_host_header()       { _target_property "${1-}" '.health.host_header' string; }
target_backup_namespace()         { _target_property "${1-}" '.backup.namespace' string; }
target_local_backup_retention()   { _target_property "${1-}" '.backup.local_retention_days' number; }
target_offsite_backup_retention() { _target_property "${1-}" '.backup.offsite_retention_days' number; }
target_minimum_retained_backups() { _target_property "${1-}" '.backup.minimum_retained_backups' number; }
target_php_fpm_pool()             { _target_property "${1-}" '.php_fpm.pool' string; }
target_php_fpm_socket()           { _target_property "${1-}" '.php_fpm.socket' string; }
target_supervisor_program()       { _target_property "${1-}" '.supervisor.program' string; }
target_queue_name()               { _target_property "${1-}" '.supervisor.queue' string; }
target_scheduler_name()           { _target_property "${1-}" '.scheduler.name' string; }
target_nginx_site_name()          { _target_property "${1-}" '.nginx.site_name' string; }
# The first public_hostnames entry is the target's canonical
# public hostname, used by deploy for `artisan rateguru:sharing:verify
# --expected-host`. No new registry field: _target_property's existing
# generic contract already fails closed here for free — `.public_hostnames[0]`
# on an empty array, or on a first element that isn't a string, both yield a
# value whose jq type isn't "string", which _target_property already turns
# into "target X is missing a valid .public_hostnames[0] (expected string)".
target_primary_public_hostname()  { _target_property "${1-}" '.public_hostnames[0]' string; }

# The Supervisor program running this target's Laravel Nightwatch
# agent, or a non-zero return when the target does not run one.
#
# Deliberately a closed allowlist here rather than a registry field. Nightwatch
# Is a time-boxed evaluation that the Nightwatch decision may reject outright, and a required
# registry field would make every target — including the planned production
# ones — carry a key for a product that may not survive, ripple through
# targets' REQUIRED_STRINGS and every registry fixture the test suite embeds,
# and have to be unwound again. An allowlist keeps the whole decision in one
# case statement: staging-main runs an agent, nothing else can, and deleting
# the entry disables the integration everywhere at once.
#
# It is also the mechanism that makes "staging only" structural rather than
# procedural: no production target can be activated by editing a .env or a
# registry file, because no production target has a program to activate.
#
# Callers must treat a non-zero return as "no agent for this target" and carry
# on — never as an error. Used by deploy (agent transition after the current
# switch) and by install-nightwatch-agent (which target may be installed).
target_nightwatch_program() {
    case "${1-}" in
        staging-main) printf 'rateguru-staging-nightwatch\n' ;;
        *) return 1 ;;
    esac
}

# The single gate operational commands use before acting on a
# target. target_lifecycle already validates the target ID, validates the
# whole registry, and confirms the target exists (failing "unknown target: …"
# otherwise) — so this only adds the final check: the target must be
# lifecycle=active. A planned or disabled target must never be read further,
# so this must run before any URL is built, curl is called, or an application
# path is touched.
#
# validate_target_id / target_registry_assert_usable / target_registry_assert_valid
# are called directly here — not through target_lifecycle's own $(...) command
# substitution below — because a command substitution forks a subshell, and
# target_registry_assert_valid's cache (_TARGET_REGISTRY_VALIDATED_FILE) is a
# plain shell variable: setting it inside a subshell has no effect once that
# subshell exits. Running the three checks directly, in this function's own
# (the caller's) shell, means the cache is actually set here — in the process
# health-check or status is running as — so target_lifecycle two lines down,
# and every target_* call the caller makes afterward, inherit an
# already-matching cache and skip re-running the external validator. Without
# this, every target_* accessor call would re-invoke the validator from
# scratch, once each, silently defeating the "once per process" design.
require_active_target() {
    local target_id="${1-}"

    validate_target_id "${target_id}"
    target_registry_assert_usable
    target_registry_assert_valid

    local lifecycle
    lifecycle="$(target_lifecycle "${target_id}")"

    if [[ "${lifecycle}" != "active" ]]; then
        fail "target ${target_id} has lifecycle=${lifecycle}, not active"
    fi
}

# Shared flag-value validator, used by every operational script's own
# argument loop (including parse_target_args below) — offsite-backup,
# offsite-retention and offsite-restore-test originally had this exact,
# byte-identical implementation inline; extracted here to remove the
# duplication. deploy/rollback/restore-test keep their own separate copies,
# since bash's normal function-shadowing means a script defining its own
# require_flag_value after sourcing this file is unaffected either way.
#
# require_flag_value <flag-name> <remaining-arg-count> <next-token>
require_flag_value() {
    local flag="$1" remaining="$2" value="${3-}"

    [[ "${remaining}" -ge 2 ]] || fail "${flag} requires a value"
    [[ -n "${value}" ]] || fail "${flag} requires a non-empty value"

    case "${value}" in
        -*) fail "${flag} requires a value, not another option: ${value}" ;;
    esac
}

# Shared --target parsing for target-only operational commands with no
# operation-specific flags of their own (health-check, status). Runs in the
# caller's own shell — never a subshell — so it sets TARGET_ID and
# TARGET_SEEN directly in the caller's scope rather than returning them.
#
# Call as: parse_target_args "$0" "$@"  (or an explicit program name in
# place of "$0", since callers invoke this via `bash script`, not `./script`).
#
# Enforces: exactly one --target; duplicate --target fails; a --target given
# with no value, an explicitly empty value, or a flag-shaped value all fail;
# an unrecognized argument fails; --help prints usage and exits 0. It does
# not perform lifecycle validation (require_active_target) — that stays with
# the caller, since what happens with a resolved target differs per command.
#
# Scripts with their own operation-specific flags (deploy, rollback, cleanup,
# backup, restore-test, offsite-backup, offsite-retention,
# offsite-restore-test, backup-cycle) run their own argument loop instead —
# this function only fits a script whose sole flag is --target.
parse_target_args() {
    local program_name="$1"
    shift

    TARGET_ID=""
    TARGET_SEEN=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                if [[ "${TARGET_SEEN}" == true ]]; then
                    fail "--target given more than once"
                fi

                require_flag_value "--target" "$#" "${2-}"

                TARGET_ID="$2"
                TARGET_SEEN=true
                shift 2
                ;;
            --help|-h)
                cat <<USAGE
Usage:
  ${program_name} --target TARGET_ID
USAGE
                exit 0
                ;;
            *)
                fail "unknown argument: $1"
                ;;
        esac
    done

    [[ "${TARGET_SEEN}" == true ]] || fail "--target is required"
}
# --- restore guard -----------------------------------------------------------
#
# A restore that lands data from backup A onto a target whose `current` still
# serves code B finishes in a deliberate HELD state: the data is restored, but
# nothing may run against it until the matching code is deployed. The hold
# itself is runtime state — maintenance on, queue stopped, cron entry moved
# aside — and it dies with the process that created it.
#
# This marker is the part that has to outlive it, because the hold is not only
# about traffic. While a target is held, its live data belongs to a DIFFERENT
# commit than the one `current/release.json` names, and an ordinary backup
# copies the data from disk while taking its release identity from
# `current/release.json`. Taken in that window it would produce a backup
# asserting that data from A belongs to commit B — quietly corrupting the one
# invariant the whole disaster-recovery model rests on:
#
#   backup release.json.source_sha -> the code the restored data belongs to
#
# So the marker is a root-only file that says "this target's data may not match
# its code", and `backup` refuses to snapshot while it exists.
#
# It is written BEFORE the first live mutation, not after a restore ends. The
# window that needs covering is the one a failure handler cannot see: a SIGKILL
# or OOM kill between activation and completion runs no trap, releases flock to
# the kernel, and leaves the host's own backup cron free to snapshot restored
# data under the old commit. A marker written only on completion is absent in
# exactly that case.
#
# It is removed only by an outcome that proves the data matches the code again:
# an aligned restore that passed its health check, a successful `--resume`, or a
# compensation that put the live data back.
#
# It lives under the restore run root rather than the target's own locks/
# directory, which is deploy_user:code_group 2750 — a safety marker must not
# sit somewhere the deployment credential can unlink it. Everything under the
# run root is root:root 0700.

# restore_guard_file TARGET_ID RUN_ROOT
restore_guard_file() {
    local target_id="${1-}" run_root="${2-}"

    [[ -n "${target_id}" ]] || fail "restore_guard_file: target ID is required"
    [[ -n "${run_root}" ]] || fail "restore_guard_file: run root is required"

    printf '%s/restores/%s/restore-guard\n' "${run_root%/}" "${target_id}"
}

# assert_no_restore_hold TARGET_ID RUN_ROOT OPERATION_DESCRIPTION — fail closed
# while the target is held awaiting code alignment.
#
# Deliberately reads the marker rather than trusting its mere presence to be
# self-explanatory: an operator who hits this needs the operation ID and the
# source SHA the target is waiting for, and both are in the file.
assert_no_restore_hold() {
    local target_id="${1-}" run_root="${2-}" operation="${3-an operation}"
    local marker held_operation held_sha held_status

    marker="$(restore_guard_file "${target_id}" "${run_root}")"

    [[ -e "${marker}" ]] || return 0

    held_operation="$(jq -r '.operation // "unknown"' "${marker}" 2>/dev/null || printf 'unknown')"
    held_sha="$(jq -r '.required_source_sha // "unknown"' "${marker}" 2>/dev/null || printf 'unknown')"
    held_status="$(jq -r '.status // "unknown"' "${marker}" 2>/dev/null || printf 'unknown')"

    # Deliberately does NOT tell the operator to deploy the SHA. restore-target
    # itself is explicit that the normal deployment path must not be used to
    # resolve a hold — a normal deploy health-checks the target and transitions
    # the queue, both of which fight the hold — and two places giving different
    # advice about the same state is how someone ends up running the wrong one.
    fail "${target_id} is held after restore operation ${held_operation} (status ${held_status}): its live data may be from a backup taken under ${held_sha}, which is not what current serves, so ${operation} is refused — a backup would record the wrong source_sha for this data, and a deployment, rollback or cleanup would move the code further away from it or delete the release it needs. Controlled code alignment is required, and it is the ONLY thing that may end this hold. Do NOT use the normal deployment path: run the Restore workflow for this target with mode=continue-held and operation=${held_operation}, or, by hand, deploy the required source SHA with 'deploy --target ${target_id} --restore-operation ${held_operation}' and finish with 'restore-target --resume'. The guard is ${marker}"
}

# --- restore alignment authorization -----------------------------------------
#
# The hold above has exactly one legitimate ending: a controlled deployment of
# the exact commit the restored data belongs to, followed by
# `restore-target --resume`. That deployment is the ordinary `deploy`, run with
# --restore-operation — there is no second deployment implementation — and
# everything below is what it must prove before it is allowed to behave
# differently from a normal deploy.
#
# The rule the whole design rests on is that the CALLER never says which commit
# is required. GitHub hands the server an operation ID and nothing else; the
# commit comes out of the server's own persisted restore state, and this is
# where it is read. A caller naming an operation that is not held, belongs to
# another target, or whose guard and state disagree gets a refusal, never a
# deployment.
#
# Two independent documents have to agree before a single byte moves:
#
#   the guard   ${RUN_ROOT}/restores/<target>/restore-guard
#               root-only, written before the first live mutation, carries the
#               operation, the target, the required commit and the hold status
#   the state   ${RUN_ROOT}/restores/<target>/<operation>/state.json
#               the operation's own record: same target, status held, phase
#               committed, code_alignment required, and the backup identity
#
# Reading both and requiring them to name the same commit is what makes a
# tampered or half-written guard insufficient on its own.

# An operation ID is generated by the restore tooling, never by an operator's
# filesystem: UTC timestamp plus six hex characters of entropy. No slash, no
# whitespace, no shell metacharacter, no dot — so it can never climb out of the
# workspace root it is concatenated onto.
#
# Defined here rather than in restore-common because it is no longer a
# restore-only format: `deploy` validates the same identifier, and deploy does
# not (and must not) source the restore library. restore-common sources this
# file, so the restore primitives keep using the identical implementation.
RESTORE_OPERATION_ID_REGEX='^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$'

# A backup ID is exactly the timestamped directory name `backup` itself
# creates. No path, no separator and no relative component survives it. Here
# for the same reason as the operation ID: the restore sudo wrapper validates
# it at the perimeter and does not source the restore library. The deeper check
# — that the name is a real UTC calendar timestamp, not merely timestamp-shaped
# — stays in restore-common's validate_backup_id, which remains authoritative.
RESTORE_BACKUP_ID_REGEX='^[0-9]{8}-[0-9]{6}$'

# The commit a controlled alignment installs. Deliberately stricter than
# restore-common's RESTORE_SOURCE_SHA_REGEX (7-40 hex, which exists to read
# historical release.json files): an alignment resolves an exact commit to
# check out and build, and an abbreviated SHA is not one. A backup carrying a
# short source_sha is still restorable — it simply cannot be aligned
# automatically, and says so instead of guessing.
RESTORE_ALIGNMENT_SOURCE_SHA_REGEX='^[0-9a-f]{40}$'

validate_operation_id() {
    local operation_id="${1-}"

    [[ "${operation_id}" =~ ${RESTORE_OPERATION_ID_REGEX} ]] \
        || fail "invalid restore operation ID: ${operation_id}"
}

# restore_operation_state_file TARGET_ID RUN_ROOT OPERATION_ID — the same path
# restore-common's workspace helpers compose, expressed once more here for the
# two callers that must read it without sourcing the restore library. Both
# components are validated first, so no operator-supplied string ever reaches
# the path.
restore_operation_state_file() {
    local target_id="${1-}" run_root="${2-}" operation_id="${3-}"

    [[ -n "${run_root}" ]] || fail "restore_operation_state_file: run root is required"

    validate_target_id "${target_id}"
    validate_operation_id "${operation_id}"

    printf '%s/restores/%s/%s/state.json\n' "${run_root%/}" "${target_id}" "${operation_id}"
}

# Set by assert_restore_alignment_operation, and only ever from the server's
# own persisted state — never from an argument.
RESTORE_ALIGNMENT_REQUIRED_SHA=""
RESTORE_ALIGNMENT_BACKUP=""

# restore_alignment_read_json FILE FILTER — read ONE field out of a document
# that has already been proven readable.
#
# Deliberately not a guarded read, and the guarding is not missing: every
# caller below establishes that the document exists, is a regular file, is not
# a symlink and parses as a JSON object BEFORE its first call here. By the time
# this runs, the only thing that can be absent is a FIELD.
#
# An absent field yields the empty string, and that is safe because nothing acts
# on the value: every single read below is either compared against a required
# target, operation, status or commit, or required to be non-empty. Empty fails
# both, so the refusal comes from that check — with the field's own diagnostic —
# rather than from here. Widening this into a second layer of file checks would
# duplicate the caller's and give two places to keep in agreement.
#
# That invariant is load-bearing: a field read here and then neither compared
# nor required would silently accept an empty value. Keep every new read paired
# with a check, or do not add the read.
restore_alignment_read_json() {
    local path="$1" filter="$2"

    jq -r "${filter} // empty" "${path}" 2>/dev/null || printf ''
}

assert_restore_alignment_operation() {
    local target_id="${1-}" run_root="${2-}" operation_id="${3-}"

    RESTORE_ALIGNMENT_REQUIRED_SHA=""
    RESTORE_ALIGNMENT_BACKUP=""

    [[ -n "${run_root}" ]] || fail "assert_restore_alignment_operation: run root is required"

    validate_target_id "${target_id}"
    validate_operation_id "${operation_id}"

    local marker
    marker="$(restore_guard_file "${target_id}" "${run_root}")"

    # 1. There is a hold at all. A controlled alignment deploy is meaningless
    #    without one: nothing is holding the target, so nothing needs the
    #    special runtime policy, and a normal deployment is the right tool.
    [[ -e "${marker}" ]] \
        || fail "${target_id} is not held: no restore guard at ${marker}. --restore-operation is only for finishing a restore that is waiting for its code; an ordinary deployment needs no restore operation"

    # 2. It is a real, regular file this credential could not have swapped for
    #    a symlink pointing at something more convenient.
    [[ ! -L "${marker}" ]] \
        || fail "the restore guard ${marker} is a symlink — refusing to authorize a controlled alignment against it"
    [[ -f "${marker}" ]] \
        || fail "the restore guard ${marker} is not a regular file — refusing to authorize a controlled alignment against it"

    # Ownership and mode are demanded of the INSTALLED run root only, exactly
    # the way this file already treats deployment.conf and the target registry:
    # a scratch fixture is a legitimate non-root caller, the production path
    # never is.
    if [[ "${run_root%/}" == "/home/www/rateguru/run" ]]; then
        [[ "$(stat -c '%u' "${marker}")" == "0" ]] \
            || fail "the restore guard ${marker} is not owned by root — refusing to authorize a controlled alignment against it"

        local marker_mode
        marker_mode="$(stat -c '%a' "${marker}")"

        (( (8#${marker_mode} & 8#077) == 0 )) \
            || fail "the restore guard ${marker} is readable or writable beyond root — refusing to authorize a controlled alignment against it"
    fi

    jq -e 'type == "object"' "${marker}" >/dev/null 2>&1 \
        || fail "the restore guard ${marker} is not a JSON object — refusing to authorize a controlled alignment against it"

    local guard_target guard_operation guard_status guard_sha
    guard_target="$(restore_alignment_read_json "${marker}" '.target')"
    guard_operation="$(restore_alignment_read_json "${marker}" '.operation')"
    guard_status="$(restore_alignment_read_json "${marker}" '.status')"
    guard_sha="$(restore_alignment_read_json "${marker}" '.required_source_sha')"

    # 3-4. The hold is this target's, and it is the operation the caller named.
    [[ "${guard_target}" == "${target_id}" ]] \
        || fail "the restore guard at ${marker} belongs to target ${guard_target:-<unset>}, not ${target_id}"

    [[ "${guard_operation}" == "${operation_id}" ]] \
        || fail "${target_id} is held by restore operation ${guard_operation:-<unset>}, not ${operation_id} — a controlled alignment may only serve the operation that is actually holding the target"

    # 5. Only `held` is a code-alignment hold. `in-progress` means a restore is
    #    still running or died mid-flight, and `failed-held` means a restore
    #    failed with live data that may have been replaced: neither is finished
    #    by deploying a commit, and both need the repair path instead.
    [[ "${guard_status}" == "held" ]] \
        || fail "restore operation ${operation_id} has hold status '${guard_status:-<unset>}', not 'held' — only a completed data restore awaiting its code may be aligned; an in-progress or failed-held operation needs manual recovery, never a deployment"

    [[ "${guard_sha}" =~ ${RESTORE_ALIGNMENT_SOURCE_SHA_REGEX} ]] \
        || fail "the restore guard at ${marker} carries no full 40-character commit (${guard_sha:-<unset>}) — a controlled alignment installs an exact commit and will not guess one"

    # 6-7. The operation's own record, read from the workspace the restore
    #      created. A guard without one is not a state a deployment may act on.
    local state_file
    state_file="$(restore_operation_state_file "${target_id}" "${run_root}" "${operation_id}")"

    [[ ! -L "${state_file}" ]] \
        || fail "restore operation state ${state_file} is a symlink — refusing to authorize a controlled alignment against it"
    [[ -f "${state_file}" ]] \
        || fail "restore operation ${operation_id} has no state file at ${state_file} — refusing to authorize a controlled alignment without the operation's own record"

    jq -e 'type == "object"' "${state_file}" >/dev/null 2>&1 \
        || fail "restore operation state ${state_file} is not a JSON object — refusing to authorize a controlled alignment against it"

    local state_target state_status state_phase state_alignment state_sha state_backup
    state_target="$(restore_alignment_read_json "${state_file}" '.target')"
    state_status="$(restore_alignment_read_json "${state_file}" '.status')"
    state_phase="$(restore_alignment_read_json "${state_file}" '.phase')"
    state_alignment="$(restore_alignment_read_json "${state_file}" '.code_alignment')"
    state_sha="$(restore_alignment_read_json "${state_file}" '.backup_source_sha')"
    state_backup="$(restore_alignment_read_json "${state_file}" '.backup')"

    [[ "${state_target}" == "${target_id}" ]] \
        || fail "restore operation ${operation_id} belongs to target ${state_target:-<unset>}, not ${target_id}"

    # 8-9. The data restore completed and committed, and it is waiting for code
    #      — not running, not failed, not already aligned.
    [[ "${state_status}" == "held" ]] \
        || fail "restore operation ${operation_id} has status '${state_status:-<unset>}' — a controlled alignment only applies to an operation whose data restore completed and whose runtime is held for code alignment"

    [[ "${state_phase}" == "committed" ]] \
        || fail "restore operation ${operation_id} is in phase '${state_phase:-<unset>}', expected committed"

    [[ "${state_alignment}" == "required" ]] \
        || fail "restore operation ${operation_id} records code_alignment '${state_alignment:-<unset>}', not 'required' — there is no code to align"

    # 10-11. The two documents name the same commit, and it is an exact one.
    [[ "${state_sha}" =~ ${RESTORE_ALIGNMENT_SOURCE_SHA_REGEX} ]] \
        || fail "restore operation ${operation_id} records no full 40-character backup source_sha (${state_sha:-<unset>}) — a controlled alignment installs an exact commit and will not guess one"

    [[ "${state_sha}" == "${guard_sha}" ]] \
        || fail "restore operation ${operation_id} records backup source ${state_sha}, but its guard requires ${guard_sha} — refusing to align a target whose own restore documents disagree"

    [[ -n "${state_backup}" ]] \
        || fail "restore operation ${operation_id} records no backup identity — refusing to align a target whose restore cannot name the backup it applied"

    RESTORE_ALIGNMENT_REQUIRED_SHA="${guard_sha}"
    RESTORE_ALIGNMENT_BACKUP="${state_backup}"

    log "restore operation ${operation_id} authorizes a controlled alignment of ${target_id} to ${RESTORE_ALIGNMENT_REQUIRED_SHA} (backup ${RESTORE_ALIGNMENT_BACKUP})"
}

# --- deployment target registry (end) ---
